/*
PROCEDURE_Template_v1.0.sql - Plantilla base de Stored Procedure

Version history:
11.03.2026 v1.0 Creacion de plantilla base

Usage:
CALL Procedure_Template('Month=2026-03,Debug=No');
*/

SET NAMES 'utf8mb4';

-- -----------------------------------------------------
DROP PROCEDURE IF EXISTS Procedure_Template;
-- -----------------------------------------------------

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Procedure_Template`(
    IN p_InputCommLine VARCHAR(500)
)
COMMENT 'Plantilla base para SP en MySQL 8.0.37'
SQL SECURITY DEFINER
ProcedureBody: BEGIN
    DECLARE v_Version       VARCHAR(30);
    DECLARE v_CurrentDay    DATE;
    DECLARE v_Debug         VARCHAR(20);
    DECLARE v_Month         CHAR(7);
    DECLARE v_e             INT;
    DECLARE v_c             INT;
    DECLARE v_k             VARCHAR(80);
    DECLARE v_v             VARCHAR(250);
    DECLARE v_Step          VARCHAR(64);

    -- --------------------------------------------------------------------------------------------
    -- Defaults
    SET v_Version    = 'v1.0 11.03.2026';
    SET v_CurrentDay = CURDATE();
    SET v_Debug      = 'NO';
    SET v_Month      = LEFT(v_CurrentDay, 7);
    SET v_Step       = 'INIT';

    -- Normalizacion de entrada Key=Value,Key=Value
    SET p_InputCommLine = IFNULL(p_InputCommLine, '');
    SET p_InputCommLine = CONCAT(p_InputCommLine, ',');
    SET p_InputCommLine = REPLACE(p_InputCommLine, '"', '');

    -- Parseo de parametros
    WHILE p_InputCommLine > ' ' DO
        SET v_e = LOCATE(',', p_InputCommLine);
        IF v_e = 0 THEN
            LEAVE;
        END IF;

        SET v_c = LOCATE('=', p_InputCommLine);
        IF v_c > 0 AND v_c < v_e THEN
            SET v_k = UPPER(TRIM(SUBSTRING(p_InputCommLine, 1, v_c - 1)));
            SET v_v = UPPER(TRIM(SUBSTRING(p_InputCommLine, v_c + 1, v_e - v_c - 1)));

            IF v_k = 'DEBUG' THEN
                SET v_Debug = v_v;
            ELSEIF v_k = 'MONTH' THEN
                SET v_Month = LEFT(v_v, 7);
            END IF;
        END IF;

        SET p_InputCommLine = SUBSTRING(p_InputCommLine, v_e + 1);
    END WHILE;

    -- Validaciones base
    IF v_Month IS NULL OR CHAR_LENGTH(v_Month) <> 7 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Parametro Month invalido. Formato esperado: YYYY-MM';
    END IF;

    -- Ejemplo de estructura de manejo de errores/transaccion para SP de escritura
    -- DECLARE EXIT HANDLER FOR SQLEXCEPTION
    -- BEGIN
    --     ROLLBACK;
    --     SIGNAL SQLSTATE '45000'
    --         SET MESSAGE_TEXT = CONCAT('Error en paso: ', v_Step);
    -- END;
    -- START TRANSACTION;
    -- SET v_Step = 'WRITE_BLOCK';
    -- COMMIT;

    -- Salida de control
    IF v_Debug IN ('YES', 'YE', 'Y') THEN
        SELECT
            v_Version    AS version,
            v_CurrentDay AS current_day,
            v_Month      AS month_param,
            v_Debug      AS debug;
    END IF;

    -- Query principal de ejemplo
    SELECT
        v_Version AS ProcedureVersion,
        v_Month   AS MonthValue,
        'OK'      AS Status;

END $$
DELIMITER ;
