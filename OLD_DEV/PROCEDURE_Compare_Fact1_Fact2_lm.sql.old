/* PROCEDURE_Compare_Fact1_Fact2_lm.sql
   01.09.2022 V1 Compara last month Fact2 con Fact1. Devuelve diferencias
   Parametros (none)
   
*/
-- DROP PROCEDURE IF EXISTS CompareFact1Fact2_lm;
DROP PROCEDURE IF EXISTS Compare_Fact1_Fact2_lm;
DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE Compare_Fact1_Fact2_lm()
   COMMENT 'FACT2 - COMPARA LastMonth contra FACT1. Devuelve diferencias'
   LANGUAGE SQL
    
BEGIN

SELECT
	 IF(SUM(CPA_AF)>SUM(CPA_GE),'Quitar CPAs al Afiliado','Dar CPAs al Afiliado') AS Result
	,`Owner`,left(DATE,7) AS Month,Brand,Affiliate
	,Tracker_Name,Tracker_ID,MS_id
	,SUM(CPA_AF) AS CPA_AFF,SUM(CPA_GE) AS CPA_Ges
	,SUM(CPA_AF)-SUM(CPA_GE) AS `CPA_DIFF`
	,round(SUM(Net_Rev_AF),2) AS Net_Rev_AF,round(SUM(Net_Rev_GE),2) AS Net_Rev_Ges
	,CONCAT("CALL Sync_MS_Fact1_Fact2_lm(",MS_id,");") as 'CALL TO SYNC this MS'
FROM (
SELECT
	 `Owner`
	,`Date`
	,`Brand`
	,`Username`
	,`Username_id`
	,`Affiliate`
	,`Affiliate_id`
	,SUM(`Qualified_Players`)  AS 'CPA_AF'
	,SUM(`Net_Revenue`)        AS 'Net_Rev_AF'
	,0 AS 'CPA_GE'
	,0 AS 'Net_Rev_GE'
	,`Tracker_Name`,`Tracker_ID`,ifnull(MS_id,0) AS MS_id
FROM
	`Snapshot_day_by_day_fact2`
WHERE `Qualified_Players`<>0 AND LEFT(DATE,7)=LEFT(DATE_SUB(curdate(), INTERVAL 1 MONTH),7) -- and Tracker_Name = 'a47mou'
GROUP BY left(DATE,7),Username_id,ifnull(MS_id,0),Tracker_Name,Tracker_ID,Affiliate_id
UNION ALL -- -----------------------------------------------------------------
SELECT
	 `Owner`
	,`Date`
	,`Brand`
	,`Username`
	,`Username_id`
	,`Affiliate`
	,`Affiliate_id`
	, 0 AS 'CPA_AF'
	, 0 AS 'Net_Rev_AF'
	,SUM(`Qualified_Players`)  AS 'CPA_GE'
	,SUM(`Net_Revenue`)        AS 'Net_Rev_GE'
	,`Tracker_Name`,`Tracker_ID`,ifnull(MS_id,0) AS MS_id
FROM
	`Snapshot_day_by_day_fact1`
WHERE `Qualified_Players`<>0 AND LEFT(DATE,7)=LEFT(DATE_SUB(curdate(), INTERVAL 1 MONTH),7) -- and Tracker_Name = 'a47mou'
GROUP BY left(DATE,7),Username_id,ifnull(MS_id,0),Tracker_Name,Tracker_ID,Affiliate_id
) AS XX
GROUP BY left(DATE,7),Username_id,MS_id,Tracker_Name,Tracker_ID HAVING `CPA_DIFF`<>0 -- WITH ROLLUP 
UNION ALL SELECT '{End report}', '','΋','', '','','', '','','' ,'','','', '' FROM dual 
ORDER BY Month,Owner,`Brand`,Affiliate
;
END$$
DELIMITER ;

-- TEST --------------
