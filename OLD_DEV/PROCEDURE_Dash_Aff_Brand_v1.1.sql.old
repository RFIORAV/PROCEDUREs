/* 
PROCEDURE_Dash_Aff_Brand.sql() - CPA/Signup/FTD/Click - Dash affiliate Brand 
  
Keys:

Affiliate_id    =[ALL | id del Affiliate_id]. 
Month           =[AAAA-MM | CM | LM ]. OPCIONAL. Default=Current Month
Brand           =[Brand | ALL ]. Nombre de la Brand/advertiser. OPCIONAL. Default=ALL
Meta            =[No | Yes]. Default [Yes] OPCIONAL. Columna 1 como METADATO: total/data/setting
Debug           =[No | Yes | KeyValues]. [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query. OPCIONAL. Default=No

Parámetros ('[Key=Value[,...]'])

Ejemplos:

call Dash_Aff_Brand(' ');                                   -- ERROR Sin Affiliate_id
call Dash_Aff_Brand('Affiliate_id=ALL,Month=LM');           -- ERROR Affiliate_id=ALL
call Dash_Aff_Brand('Affiliate_id=39,Brand=ALL,Month=LM');  -- OK
call Dash_Aff_Brand('Brand=ALL,Month=LM');                  -- ERROR Affiliate_id=""

call Dash_Aff_Brand('Affiliate_id=39,Brand=betclic,Month=LM,debug=no');

06.06.2023 V1     Primera version
12.06.2023 V1.1   Karen. Filtro por Brand

*/

DROP PROCEDURE IF EXISTS Dash_Aff_Brand;

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Dash_Aff_Brand`(IN
   InputCommLine    VARCHAR(250)
   )
    COMMENT 'CPA/Reg/FTD/Global/NR - Dash_aff_Brand'
    
proc_label:BEGIN
-- --------------------------------------------------------------------------------------------
-- Defaults
SET @Version      ='v1.1 06.06.2023';
SET @Month        =LEFT(CURDATE(),7);
SET @Affiliate_id ='';
SET @Brand        ='';

SET @Meta         ='YES';
SET @Debug        ='NO';
SET @Filters       ='NO'; -- K 06/2023                                   

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
-- SET @InputCommLine=replace(@InputCommLine,' ','');  -- Elimina espacios
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

-- IF @Debug="YES" THEN SELECT @Owner,@Month,@Currency,@Advertiser_id,@ByAccount,@Debug,@Total,@TotLine,@OrderBy,@Order,@InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit
-- @InputCommLine: ----5----0----5----0----5----0----5----0--
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);   

   IF lower(@k)='month'         THEN SET @Month        =UPPER(@v); END IF;
   IF lower(@k)='Brand'         THEN SET @Brand        =UPPER(@v); END IF;
   IF lower(@k)='Affiliate_id'  THEN SET @Affiliate_id =UPPER(@v); END IF;
   IF lower(@k)='debug'         THEN SET @Debug        =UPPER(@v); END IF;
   IF lower(@k)='mode'          THEN SET @Mode         =UPPER(@v); END IF;
   IF lower(@k)='meta'          THEN SET @Meta         =UPPER(@v); END IF;
   IF lower(@k)='filters'       THEN SET @Filters      =UPPER(@v); END IF;

END WHILE;

/************ VALIDACION PARAMETROS ************************************************/

IF @Month='CM' THEN SET @Month=LEFT(DATE_SUB(CURDATE(), INTERVAL 0 MONTH),7); END IF;
IF @Month='LM' THEN SET @Month=LEFT(DATE_SUB(CURDATE(), INTERVAL 1 MONTH),7); END IF;

SET @Month_Report=@Month;
SET @WhereBrand=concat(' and F.Brand="',@Brand,'" ');

IF @Brand IN ("","ALL") THEN SET @WhereBrand=''; END IF; 
   
-- En views de Afiliado impide pedir @Affiliate_id="ALL"  
IF   @Affiliate_id IN ("","ALL")
THEN
    Select 'data' as Meta,'Affiliate_id mandatory' as '' from dual;
    LEAVE proc_label;
END IF; 

/* **************************************************/

SET SESSION group_concat_max_len = 200000;


SET @CTE=CONCAT('              
WITH BaseData as (
   SELECT F.date,F.Affiliate_id,F.Brand
      ,SUM(F.Signups)              as `Signups`
      ,SUM(F.First_Time_Deposit)   as `First_Time_Deposit`
      ,SUM(F.Qualified_Players)    as `Qualified_Players`
      ,SUM(F.CPA_Value_Affiliate)  as `CPA_Value_Affiliate`
   FROM Snapshot_day_by_day_fact2 F
   WHERE LEFT(F.DATE,7)="',@Month_Report,'" 
   AND F.Affiliate_id ="',@Affiliate_id ,'" 
   ',@WhereBrand,' 
   GROUP BY Affiliate_id,DATE
   ORDER BY Affiliate_id,DATE
)
, TotalRow as (
   SELECT " --Total--",F.Affiliate_id,F.Brand
      ,SUM(F.Signups)              as `Signups`
      ,SUM(F.First_Time_Deposit)   as `FTD`
      ,SUM(F.Qualified_Players)    as `CPA`
      ,SUM(F.CPA_Value_Affiliate)  as `CPA val`
   FROM BaseData F
)');

SET @SQL=concat(
@CTE,'    
SELECT  
   "setting"         as `Meta`
   ,"width=100px"    as `Date`
   ,"omit=true"      as `Affiliate_id`
   ,"omit=true"      as `Brand`
   ,"width=100px"    as `Signups`
   ,"width=100px"    as `FTD`
   ,"width=100px"    as `CPA`
   ,"width=100px"    as `CPA val`
	FROM DUAL WHERE "',@Meta,'"="YES"
UNION ALL
SELECT "total",T.* FROM TotalRow T
UNION ALL
SELECT "data",T.* FROM BaseData T
;');

/* Karen 06/2026*/

SET @SQLfilters=CONCAT(
@CTE,'
(SELECT 
	"1" as "Korder","Brand" AS "Key",`Brand` AS "Value",
	"Brand" AS `CallKey`,`Brand` as "CallValue" ,"" AS "Rows" 
FROM 
(
	SELECT 
		DISTINCT a.Advertiser_Name as Brand,
		a.id AS id
	FROM campaign_marketing_source m
	INNER JOIN campaign_advertiser a ON m.Advertiser_id = a.id
	WHERE Affiliate_id = ', @Affiliate_id, '
	AND (m.Status_id = "1" OR m.Status_id = "5") 
	AND m.Username_id is not NULL
	GROUP BY a.Advertiser_Name ORDER BY a.Advertiser_Name
)t
) 
;');

IF @Filters!="NO" THEN SET @SQL=@SQLfilters; END IF;

IF @Debug!="NO" THEN SELECT @SQLfilters; END IF;
/**/


IF @Debug!="NO" THEN SELECT @SQL; END IF;   
IF @Debug!="NO" THEN SELECT @Debug,@Month_Report,@Affiliate_id,@Brand,@Filters; END IF;

IF @Debug != "YES" THEN 
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;   
END IF;

END$$
DELIMITER ;

/* Testing

call Dash_Aff_Brand(' ');                                               -- ERROR Sin Affiliate_id, ni Brand
call Dash_Aff_Brand('Affiliate_id=ALL,Month=LM');                       -- ERROR Affiliate_id=ALL
call Dash_Aff_Brand('Affiliate_id=39,Brand=ALL,Month=LM,Filters=yes');  -- OK
call Dash_Aff_Brand('Brand=ALL,Month=LM');                              -- ERROR Affiliate_id=""

call Dash_Aff_Brand('Affiliate_id=39,Brand=betclic,Month=LM,Filters=no,debug=non');

*/