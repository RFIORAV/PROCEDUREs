/*
PROCEDURE_Report_DashTotalByMonth.sql - Report Dashboard Total By Month

Observaciones:

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguido por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.

Keys:

Year            =[ALL | Año]. OPCIONAL. Default=ALL
Owner           =[ALL | id del Owner]. OPCIONAL. Default=ALL
Misc            =[Refresh]. OPCIONAL. Refresca los datos. Default=NO 
Filters         =[Yes | No]. Devuelve la lista de filtros. OPCIONAL. Default=no.
Meta            =[No | Yes]. OPCIONAL. Columna 1 como METADATO: total/data/setting. Default [Yes]
Debug           =[No | Yes | KeyValues]. OPCIONAL. Default=No
                  [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query.

Parámetros ('[Key=Value[,...]'])

Ejemplos:

call Report_DashTotalByMonth('debug=ye'); -- Devuelve todas las líneas
call Report_DashTotalByMonth('year=2024,owner=fullmt,debug=ye');
call Report_DashTotalByMonth('year=2024,filters=yes');

03.12.2025 V1     Primera versión operativa

*/

DROP PROCEDURE IF EXISTS Report_DashTotalByMonth;

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Report_DashTotalByMonth`(IN
   InputCommLine    VARCHAR(250)
   )
    COMMENT 'Report Dashboard Total By Month'
    
proc_label:BEGIN
-- --------------------------------------------------------------------------------------------
-- Defaults
SET @Version         ='v1 03.12.2025';
SET @CurrentDay      =curdate();
SET @Year            =left(curdate(),4);
SET @Owner           =case when database()='euroaffiliati2' then 'All Owners' else 'ALL' end;
SET @Filters         ='NO';
SET @Meta            ='YES';
SET @Debug           ='NO';
SET @Month           ='ALL';
SET @Misc            ='';

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

IF @Debug!="NO" THEN SELECT @InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
   SET @e=INSTR(@InputCommLine,'=');    				   -- Posición del =
   SET @c=INSTR(@InputCommLine,','); 					   -- Posición de la coma
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Key
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- Value
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);   
   
   IF lower(@k)='year'            THEN SET @Year            =      @v;  END IF;
   IF lower(@k)='owner'           THEN SET @Owner           =replace(UPPER(@v),"!"," ");  END IF;
   IF lower(@k)='meta'            THEN SET @Meta            =UPPER(@v); END IF;
   IF lower(@k)='debug'           THEN SET @Debug           =UPPER(@v); END IF;
   IF lower(@k)='filters'         THEN SET @Filters         =UPPER(@v); END IF;
   IF lower(@k)='month'           THEN SET @Month           =UPPER(@v); END IF;

END WHILE;

IF @Debug!="NO" THEN SELECT @Year,@Month,@Owner,@Filters,@Debug,@Meta,@Misc,InputCommLine; END IF;

SET @WhereYear='';
SET @WhereOwner='';
SET @WhereMonth='';

IF @Year !="ALL" and @filters="NO" THEN SET @WhereYear =CONCAT(" AND T.`Year` =",@Year);  END IF;
IF @Owner!="ALL" and @filters="NO" THEN SET @WhereOwner=CONCAT(" AND T.`Owner`='",@Owner,"'"); END IF;

IF @Debug!="NO" THEN SELECT @WhereYear,@WhereMonth,@WhereOwner; END IF;

SET @SQLcall="CALL DashTotalByMonth('LM')";
IF @Misc="Refresh" THEN 
	PREPARE stmt1refresh FROM @SQLcall;
	EXECUTE stmt1refresh;
	DEALLOCATE PREPARE stmt1refresh;
END IF;

SET @Count=0;

/**************************************************************************************************************/

SET @CTE=CONCAT('
WITH Main_Table_Data as (
SELECT 
    T.`Year`
    ,T.`Month`
   ,T.`Owner_id`
   ,IFNULL(T.`Owner`,"none") as `Owner`
   ,format(SUM(IFNULL(T.`Signup`,0)),0) as `Signup`
   ,format(SUM(IFNULL(T.`FTD`,0)),0) as `FTD`
   ,format(SUM(IFNULL(T.`CPA`,0)),0) as `CPA`
   ,format(SUM(IFNULL(T.`CPA_Value`,0)),2) as `CPA_Value`
   ,format(SUM(IFNULL(T.`Net_Rev`,0)),2) as `Net_Rev`
   ,format(SUM(IFNULL(T.`RS_Val`,0)),2) as `RS_Val`
   ,format(SUM(IFNULL(T.`Tot_Comm`,0)),2) as `Tot_Comm`
   ,format(SUM(IFNULL(T.`Profit`,0)),2) as `Profit`
   ,format(SUM(IFNULL(T.`AfCom_cpa`,0)),2) as `AfCom_cpa`
   ,format(SUM(IFNULL(T.`AfCom_rs`,0)),2) as `AfCom_rs`
   ,format(SUM(IFNULL(T.`AfCom_tot`,0)),2) as `AfCom_tot`
FROM dash_total_by_month T
WHERE 1=1 and Date="TOTAL NOW" '
   ,@WhereYear
   ,@WhereOwner
,'
GROUP BY T.`Month`, T.`Owner`
),
Main_Table_Data_total as (
SELECT 
    T.`Year`
    ," " as `Month`
   ,"" as `Owner_id`
   ,IF(@Owner!="ALL","Yearly Total",@Owner) as `Owner`
   ,format(SUM(IFNULL(T.`Signup`,0)),0) as `Signup`
   ,format(SUM(IFNULL(T.`FTD`,0)),0) as `FTD`
   ,format(SUM(IFNULL(T.`CPA`,0)),0) as `CPA`
   ,format(SUM(IFNULL(T.`CPA_Value`,0)),2) as `CPA_Value`
   ,format(SUM(IFNULL(T.`Net_Rev`,0)),2) as `Net_Rev`
   ,format(SUM(IFNULL(T.`RS_Val`,0)),2) as `RS_Val`
   ,format(SUM(IFNULL(T.`Tot_Comm`,0)),2) as `Tot_Comm`
   ,format(SUM(IFNULL(T.`Profit`,0)),2) as `Profit`
   ,format(SUM(IFNULL(T.`AfCom_cpa`,0)),2) as `AfCom_cpa`
   ,format(SUM(IFNULL(T.`AfCom_rs`,0)),2) as `AfCom_rs`
   ,format(SUM(IFNULL(T.`AfCom_tot`,0)),2) as `AfCom_tot`
FROM dash_total_by_month T
WHERE 1=1 '
   ,@WhereYear
   -- ,@WhereMonth
   ,@WhereOwner
,'
GROUP BY T.`Year`
)
');

SET @SQLmeta=CONCAT(
'(
SELECT
   "setting" as Meta
   ,"width=050px"   as `Year`
   ,"width=080px"   as `Month`
   ,"omit=yes"      as `Owner_id`
   ,"width=150px"   as `Owner`
   ,"omit=yes"   as `Signup`
   ,"omit=yes"   as `FTD`
   ,"width=100px,right=true"   as `CPA`
   ,"width=120px,right=true"   as `CPA Volume`
   ,"omit=yes"   as `Net_Rev`
   ,"width=120px,right=true"   as `Rev Share Volume`
   ,"width=120px,right=true"   as `Tot_Comm`
   ,"width=120px,right=true"   as `Gross Margin`
   ,"omit=yes"   as `AfCom_cpa`
   ,"omit=yes"   as `AfCom_rs`
   ,"omit=yes"   as `AfCom_tot`
FROM DUAL WHERE @Meta="YES")
UNION ALL '
);

SET @SQL=CONCAT(
@CTE,
@SQLmeta,
'
SELECT "total" as `Meta`,
   `Year`,
   `Month`,
   `Owner_id`,
   `Owner`,
   `Signup`,
   `FTD`,
   `CPA`,
   `CPA_Value`,
   `Net_Rev`,
   `RS_Val`,
   `Tot_Comm`,
   `Profit`,
   `AfCom_cpa`,
   `AfCom_rs`,
   `AfCom_tot`
FROM Main_Table_Data_total Tot
UNION ALL
SELECT "data" as `Meta`,
   `Year`,
   `Month`,
   `Owner_id`,
   `Owner`,
   `Signup`,
   `FTD`,
   `CPA`,
   `CPA_Value`,
   `Net_Rev`,
   `RS_Val`,
   `Tot_Comm`,
   `Profit`,
   `AfCom_cpa`,
   `AfCom_rs`,
   `AfCom_tot`
FROM Main_Table_Data
ORDER BY 
   CASE `Meta` 
      WHEN "total" THEN 1 
      WHEN "setting" THEN 2 
      WHEN "data" THEN 3 
      ELSE 4 
   END,
   `Year`, 
   `Month`,
   `Owner`
');

-- ------------------------------------------------------------
SET @SQLfilters=CONCAT(@CTE,'
(SELECT "01" as "Korder","Year" AS "Key",CAST(`Year` AS CHAR) AS "Value","Year" AS `CallKey`,CAST(`Year` AS CHAR) AS "CallValue",COUNT(*) AS "Rows"
                                                                                         FROM Main_Table_Data GROUP BY `Year`) UNION ALL
(SELECT "02","Owner" ,`Owner` ,"Owner" ,replace(`Owner`," ","!"),COUNT(*) AS K FROM Main_Table_Data GROUP BY `Owner`) UNION ALL
(SELECT "03","Misc" ,"Refresh data" ,"Misc" ,"Refresh" ,"" AS K FROM DUAL)
ORDER BY 1,3
;');

IF @Filters!="NO" THEN SET @SQL=@SQLfilters; END IF;

IF @Debug!="NO" THEN SELECT @SQLfilters; END IF;
IF @Debug!="NO" THEN SELECT @SQL; END IF;

IF @Debug != "YES" THEN
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;
END IF;

END$$
DELIMITER ;

/*

call Report_DashTotalByMonth('debug=yes'); -- Devuelve todas las líneas
call Report_DashTotalByMonth('year=2024,owner=ALL');
call Report_DashTotalByMonth('year=2024,owner=1,filters=yes');
call Report_DashTotalByMonth('year=2024,filters=no');

*/

