/* 
PROCEDURE_CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix.sql() - CPA x Month/Day x Affiliate - Matriz por Brand 

Observaciones: 

   Columnas Brands variables. 
   Doble columna de Totales
   Parámetro 1=ViewGES PARA VIEWS DEL GESTOR    (usa FACT1)
   Parámetro 1=ViewAFF PARA VIEWS DEL AFILIADO  (usa FACT2)
   Parámetro 4=ByDay agrupa info por DIA. 4<>ByDay agrupa por MES
   Parámetro 6=ROLLUP aplica la cláusula WITH ROLLUP al GROUP BY

Parámetros ( [ViewGES | ViewAFF] , [AffiliateID | ALL] , [Month] , [ByDay | ''] , [Owner | ALL] , [ROLLUP | ' '] )

Ejemplos:

call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewGES','ALL','2022-08',''     ,'ALL','ROLLUP');
call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewAFF','ALL','2022-08',''     ,'ALL','ROLLUP');
call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewAFF','ALL','2022-09','ByDay','ALL','ROLLUP');
call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewGES','39','2022-09',''     ,'ALL','');
call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewGES','ALL','2022-06',''     ,'2'  ,'ROLLUP');
call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewAFF','39' ,'2022-08','ByDay','ALL','rollup');

04.09.2022 V1 Total_FACT1_AFFILIATE_CPAbyDay_BrandMatrix
08.09.2022 V2 FACT1/2 Como parámetro + Currency. Unifica acumulaciones de CPA
26.09.2022 V2.2 Optimización

*/

DROP PROCEDURE IF EXISTS CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix;

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix`(IN
   AreaUser VARCHAR(50),
   AffiliateID VARCHAR(50),
   Month VARCHAR(7),
   ByDay VARCHAR(6),
   Owner VARCHAR(50),
   RollUp VARCHAR(6)
   )
    COMMENT 'CPA [ViewGES/ViewAFF] x [Affiliate/ALL] [Month] x [Owner/ALL] - Matriz por Brand'
BEGIN

	IF AreaUser='ViewGES' THEN
      SET @AreaUser='ViewGES';
      SET @DataTable=" FROM Snapshot_day_by_day_fact1 ";
   ELSE
      SET @AreaUser='ViewAFF';
      SET @DataTable=" FROM Snapshot_day_by_day_fact2 ";
	END IF;
   
   SET @AffiliateID=UPPER(AffiliateID);
	IF @AffiliateID="ALL" THEN SET @WhereAffiliateID=' ';
   ELSE SET @WhereAffiliateID=CONCAT(" AND Affiliate_id='",@AffiliateID,"'"); END IF;

   SET @Owner=UPPER(Owner);
   IF @Owner="ALL" THEN SET @WhereOwner=' ';
   ELSE SET @WhereOwner=CONCAT(" AND Owner='",@Owner,"'"); END IF;

	IF Month is not null THEN
      SET @Month_Report=Month;
   ELSE
      SET @Month_Report=LEFT(curdate(),7);
	END IF;

	IF LOWER(ByDay)='byday' THEN SET @ByDay='"yes"';
   ELSE SET @ByDay='"no"';
	END IF;   

   IF LOWER(RollUp)='rollup' THEN SET @RollUp=' WITH ROLLUP';
   ELSE SET @RollUp='';
	END IF;
   -- ----------------------------------------------------
   IF LOWER(ByDay)='byday' THEN SET @Group_by=' GROUP BY Owner,Date ';
   ELSE SET @Group_by=' GROUP BY Owner,left(Date,7),Affiliate ';
   END IF;
   IF LOWER(RollUp)='rollup' THEN SET @Order_by='';
   ELSE SET @Order_by=' ORDER BY Owner,Date ';
   END IF;
   -- ----------------------------------------------------
   SET @Debug="NO";
   -- ----------------------------------------------------
   
   SET SESSION group_concat_max_len = 100000;

SET @SQLwrkAffiliate_id=
   (SELECT GROUP_CONCAT(CONCAT("\r\nSUM(CASE WHEN Brand='", Brand,"' THEN `Qualified_Players` ELSE 0 END) AS '",Brand,"'")
   ORDER BY Brand)
   FROM (select distinct Brand from Snapshot_day_by_day_fact1
      where LEFT(DATE,7)=@Month_Report
      AND Affiliate_id=@AffiliateID
      AND Qualified_Players<>0
   ) AS xx);
SET @SQLwrkAllAff=
   (SELECT GROUP_CONCAT(CONCAT("\r\nSUM(CASE WHEN Brand='", Brand,"' THEN `Qualified_Players` ELSE 0 END) AS '",Brand,"'")
   ORDER BY Brand)
   FROM (select distinct Brand from Snapshot_day_by_day_fact1
      where LEFT(DATE,7)=@Month_Report
		AND Qualified_Players<>0
   ) AS xx);

IF @Debug="yes" THEN SELECT @SQLwrkAffiliate_id; END IF;   
IF @Debug="yes" THEN SELECT @SQLwrkAllAff; END IF;   
   
   SET @SQL = CONCAT('SELECT Owner
   ,IF(',@ByDay,'="yes",Date,LEFT(Date,7)) as `Date`
   ,IF("',@AffiliateID,'"="ALL",if(',@ByDay,'="yes","ALL",Affiliate),Affiliate) as`Affiliate`
   ,SUM(Qualified_Players) AS `Total`,',
    if(@AffiliateID='ALL',@SQLwrkAllAff,@SQLwrkAffiliate_id)
   ,',\r\nSUM(Qualified_Players) AS `Total` \r\n'
   ,@DataTable
   ,'WHERE LEFT(DATE,7)="',@Month_Report,'"'
   ,@WhereOwner,@WhereAffiliateID,'\r\n'
   ,@Group_by,@RollUp,' HAVING SUM(Qualified_Players)<>0 ',@Order_by,';');
   
IF @Debug="yes" THEN SELECT @SQL; END IF;

IF @Debug!="YES" THEN 
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;   
END IF;

END$$
DELIMITER ;

/*
      call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewGES','ALL','2022-08',''     ,'ALL','ROLLUP');
      call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewAFF','ALL','2022-08',''     ,'ALL','ROLLUP');
      call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewAFF','ALL','2022-09','ByDay','ALL','ROLLUP');
      call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewGES','39','2022-09',''     ,'ALL','');
      call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewGES','ALL','2022-06',''     ,'2'  ,'ROLLUP');
      call CPA_ByAFFILIATE_by_MonthOrDay_BrandMatrix('ViewAFF','39' ,'2022-08','ByDay','ALL','rollup');
*/