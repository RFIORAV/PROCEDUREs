/* PROCEDURE_Show_Diff_CPA_DbD_yesterday.sql - Check Raw Data: CPA missing from yesterday

Observaciones:

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguidO por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.

Keys:

Action          =[View | SET]. Modifica datos o solo muestra. OPCIONAL. Default=VIEW.
Filters         =[Yes | No]. Devuelve la lista de filtros. OPCIONAL. Default=no.
Meta            =[No | Yes]. [Yes] OPCIONAL. Columna 1 como METADATO: total/data/setting.
Debug           =[No | Yes | KeyValues]. OPCIONAL. Default=No
                  [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query.

Parámetros ('[Key=Value[,...]'])

Ejemplos:

CALL Show_Diff_CPA_DbD_yesterday('Action=VIEW');
CALL Show_Diff_CPA_DbD_yesterday('Action=SET'); -- ejecutado por EVENT a partir de las 23

Modificaciones:

25.09.2022 V1     Compara CPA Snapshot_day_by_day ayer con Snapshot_day_by_day_fact1 de hoy
                  Detecta CPA quitadas por MS/Afiliado
19.10.2022 V1.1   Columna Meta
01.11.2022 V1.2   Día 1 compara con mes anterior
23.02.2023        fix error en comparación
10.04.2023 V1.3   Karen. Incluye manejo standard de parámetros de entrada
28.03.2024 v1.3.1 Agregada columna MS_id en grid
   
*/
DROP PROCEDURE IF EXISTS Show_Diff_CPA_DbD_yesterday;

DELIMITER $$
CREATE PROCEDURE Show_Diff_CPA_DbD_yesterday(IN
   InputCommLine    VARCHAR(250)
   )  
   COMMENT 'Check Raw Data: CPA missing from yesterday'
   LANGUAGE SQL

proc_label:BEGIN

SET @Version         ='v1.3.1 28.03.2024';
SET @Action          ='VIEW';
SET @Meta            ='YES';
SET @Debug           ='NO';

SET @InputCommLine=Concat(InputCommLine ,',');      
SET @InputCommLine=replace(@InputCommLine,'"','');  
IF  @Debug!="NO" THEN SELECT @InputCommLine; END IF;

WHILE @InputCommLine>' ' DO

   SET @e=INSTR(@InputCommLine,'=');    				   
   SET @c=INSTR(@InputCommLine,','); 					   
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);   

   IF lower(@k)='action'         THEN SET @Action        =UPPER(@v); END IF;
   IF lower(@k)='meta'           THEN SET @Meta          =UPPER(@v); END IF; 
   IF lower(@k)='debug'          THEN SET @Debug         =UPPER(@v); END IF;

END WHILE;

IF  @Debug!="NO" THEN SELECT @Action,@Meta,@Debug,@Filters; END IF;

IF   DAY(CURDATE())<=3 THEN SET @Curr_Month=LEFT(DATE_SUB(CURDATE(), INTERVAL 1 MONTH),7);
ELSE SET @Curr_Month=left(CURDATE(),7); END IF;

CREATE TABLE IF NOT EXISTS `Snapshot_day_by_day_diff` (
	`Month` VARCHAR(7) NULL DEFAULT NULL,
	`Brand` VARCHAR(50) NULL DEFAULT '0',
	`Username` VARCHAR(50) NULL DEFAULT '0',
	`Tracker_Name` VARCHAR(50) NULL DEFAULT NULL,
	`Tracker_id` VARCHAR(50) NULL DEFAULT NULL,
	`Product` VARCHAR(50) NULL DEFAULT NULL,
	`Qualified_Players` INT(10) NULL DEFAULT '0',
	`Hour_Update` DATETIME NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
	`Creation_date` DATETIME NULL DEFAULT CURRENT_TIMESTAMP,
	UNIQUE INDEX `Month` (`Month`, `Brand`, `Username`, `Tracker_Name`, `Tracker_id`, `Product`) USING BTREE
)
;
-- --------------------------------------------
IF @Action='SET' THEN
   TRUNCATE Snapshot_day_by_day_diff;
   INSERT IGNORE INTO Snapshot_day_by_day_diff 
      SELECT left(DATE,7) as Month,Brand,Username,Tracker_Name,Tracker_id,Product,sum(Qualified_Players) AS CPA,Hour_Update,now()
      FROM  Snapshot_day_by_day D
      WHERE left(DATE,7)=@Curr_Month
      GROUP BY Brand,Username,Tracker_Name,Tracker_id,Product HAVING CPA<>0;
END IF;

-- Si Action='SET' finaliza proceso
IF @Action='SET' THEN LEAVE proc_label; END IF;

-- --------------------------------------------
WITH Day_by_Day AS (
   SELECT LEFT(DATE,7) as Month,Brand,Username_id,Affiliate,Tracker_Name,Tracker_id,Product,sum(Qualified_Players) AS CPA,Hour_Update
   FROM  Snapshot_day_by_day_fact1 D
   WHERE LEFT(DATE,7)=@Curr_Month
   GROUP BY Brand,Username_id,Tracker_Name,Tracker_id,Product HAVING CPA<>0
),
Day_by_Day_Diff AS (
   SELECT Month,Brand,Username,Tracker_Name,Tracker_id,Product,sum(Qualified_Players) AS CPA,Hour_Update
   FROM  Snapshot_day_by_day_diff D
   WHERE Month=@Curr_Month
   GROUP BY Brand,Username,Tracker_Name,Tracker_id,Product HAVING CPA<>0
)
-- UNION ALL 
-- (
-- SELECT "" as Meta,
   -- 'End report','','','','','','','','' FROM dual
-- )    
(
SELECT
  "setting" as Meta
  ,"width=100px"            as DATE
  ,"width=150px"            as Brand
  ,"width=200px"            AS `Account`
  ,"width=100px"            AS `Account id`
  ,"width=200px"            AS `Affiliate`
  ,"width=80px,center=yes"  as `MS id`
  ,"width=100px"            AS `Tracker ID`
  ,"width=150px"            AS `Tracker Name`
  ,"width=150px"            as Product
  ,"width=120px,right=true" as 'CPA yesterday'
  ,"width=120px,right=true" as 'CPA today'
FROM DUAL WHERE @Meta="YES"
)
UNION ALL 
(
SELECT "" as Meta,
    F.Month,F.Brand
    ,CU.Username
    ,F.Username
    ,D.Affiliate
    ,IFNULL(M.id,"") as MS_id,F.Tracker_id,F.Tracker_Name,F.Product
    ,F.CPA as 'CPA yesterday',D.CPA as 'CPA today'
FROM Day_by_Day_Diff F
LEFT JOIN Day_by_Day D 
          on F.Brand=D.Brand 
         and F.Username=D.Username_id 
         and F.Tracker_Name=D.Tracker_Name 
         and F.Tracker_id=D.Tracker_id 
         and F.Product=D.Product
LEFT JOIN `campaign_username` `CU` ON `CU`.`id` = `F`.`Username`         
LEFT JOIN `campaign_marketing_source` `M` 
          ON M.Username_id=F.Username 
         and M.Tracker_id=F.Tracker_id           
WHERE F.CPA>D.CPA
)
;
END$$
DELIMITER ;

/*
Test:

CALL Show_Diff_CPA_DbD_yesterday('Action=VIEW');
CALL Show_Diff_CPA_DbD_yesterday('Action=SET'); -- ejecutado por EVENT a partir de las 23

*/