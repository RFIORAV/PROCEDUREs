        THEN NEW.`Status_id`
        ELSE NEW.`Stat_Adve`
   END
);

SET NEW.Stat_effect=(
   CASE NEW.Stat_aggreg
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

