DELIMITER ;

-- ----------------------------------------------------------------------------
DROP TRIGGER IF EXISTS campaign_username_BEFORE_UPDATE_status_id;
DELIMITER $$
--
CREATE TRIGGER campaign_username_BEFORE_UPDATE_status_id BEFORE UPDATE
ON campaign_username FOR EACH ROW
--
BEGIN
--
SET @Version='v1.1 01.04.2023';

SET NEW.Status=(
   CASE NEW.Status_id
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

SET NEW.Stat_aggreg=(
   CASE WHEN NEW.`Status_id`!='1'
        THEN NEW.`Status_id`
        ELSE NEW.`Stat_Adve`
        END
);

SET NEW.Stat_effect=(
   CASE NEW.Stat_aggreg
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

IF NEW.Stat_aggreg!=OLD.Stat_aggreg THEN SET @UpdateTree=1; else SET @UpdateTree=0; END IF;

/* Replica Status_id en todas las MS del Account*/
IF @UpdateTree=1 THEN
   UPDATE campaign_marketing_source M
   SET M.Stat_Acct=NEW.`Stat_aggreg`
   WHERE M.Username_id=NEW.id;
END IF;

END$$
--
DELIMITER ;

-- ----------------------------------------------------------------------------
DROP TRIGGER IF EXISTS account_account_BEFORE_UPDATE_status_id;
DELIMITER $$
--
CREATE TRIGGER account_account_BEFORE_UPDATE_status_id BEFORE UPDATE
ON account_account FOR EACH ROW
--
BEGIN
--
SET @Version='v1.1 29.03.2023';

SET NEW.Status_id=IFNULL(NEW.Status_id,"1");

SET NEW.Status=(
   CASE NEW.Status_id
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

/* Comprueba que tenga Channel - Si no tiene actualiza Stat_chann de MS */

IF NEW.`Status_id`!=OLD.`Status_id` THEN
   SET @HasChannel=0;
   SET @HasChannel=(SELECT count(CH.id) FROM account_landing_pages CH where CH.Account_id=NEW.id);
END IF;

/* Replica Status_id en los Channels del Afiliado OR sus MS */

IF NEW.`Status_id`!=OLD.`Status_id` THEN
   IF @HasChannel>0 THEN
      UPDATE account_landing_pages  
      SET Stat_Affi=NEW.`Status_id`
      WHERE Account_id=NEW.id;
   ELSE
      UPDATE campaign_marketing_source M
      SET M.Stat_Chan=NEW.`Status_id`
      WHERE M.Affiliate_id=NEW.id;
   END IF;
END IF;

END$$
--
DELIMITER ;

