      ELSE 'Other'
   END
);
/* Replica Status_id en todas las MS del Channel */

IF NEW.Stat_aggreg!=OLD.Stat_aggreg THEN
   UPDATE campaign_marketing_source M
   SET M.Stat_Chan=NEW.`Stat_aggreg`
   WHERE M.Channel_id=NEW.id -- AND M.Affiliate_id=NEW.Account_id
   ;
END IF;

END$$
--
DELIMITER ;

-- ----------------------------------------------------------------------------
-- ----------------------------------------------------------------------------
DROP TRIGGER IF EXISTS campaign_marketing_source_AFTER_INSERT_Stat_aggreg;

DELIMITER $$
--
CREATE TRIGGER campaign_marketing_source_AFTER_INSERT_Stat_aggreg AFTER INSERT
ON campaign_marketing_source FOR EACH ROW
--
BEGIN
--
SET @Version='v1 13.03.2023';

-- No genera rebrandly para MS sin Tracklink
IF NEW.`Tracklink` IS NOT NULL AND
   NEW.`Tracklink`>" "
THEN
   INSERT INTO `campaign_mkt_source_url` (
       `MS_id`        
      ,`Stat_MS`  
      ,`Stat_aggreg`  
      ,`Stat_effect`  
      ,`Affiliate_id` 
      ,`Tracker_ID`   
      ,`Tracklink`    
      ,`Shortlink`    
      ,`Shortlink_id` 
   )
   VALUES (
       NEW.id
      ,NEW.`Status_id`  
      ,NEW.`Stat_aggreg`  
      ,NEW.`Stat_effect`  
      ,NEW.`Affiliate_id` 
      ,NEW.`Tracker_ID`   
      ,NEW.`Tracklink`    
      ,NEW.`Shortlink`    
      ,NEW.`Shortlink_id`
);
END IF;

END$$

DELIMITER ;
-- ----------------------------------------------------------------------------
-- ----------------------------------------------------------------------------
DROP TRIGGER IF EXISTS campaign_marketing_source_BEFORE_INSERT_Stat_aggreg;

DELIMITER $$
--
CREATE TRIGGER campaign_marketing_source_BEFORE_INSERT_Stat_aggreg BEFORE INSERT
ON campaign_marketing_source FOR EACH ROW
--
BEGIN
--
SET @Version='v1.1 01.04.2023';

SET NEW.Status=(
   CASE NEW.Status_id
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

-- Si no tiene Channel, toma el Status del Afiliado
IF  NEW.`Stat_Chan` IS NULL 
THEN SET NEW.`Stat_Chan` =(SELECT IFNULL(A.Status_id,'1') FROM account_account A where A.id=NEW.Affiliate_id);
END IF;


/* Calcula Stat_aggreg */
SET NEW.Stat_aggreg=(
   CASE WHEN IFNULL(NEW.`Status_id`,'1')!='1'
        THEN NEW.`Status_id`
        ELSE 
            CASE WHEN NEW.`Stat_Acct`!='1'
                 THEN NEW.`Stat_Acct`
                 ELSE NEW.`Stat_Chan`
            END
   END
   );

-- Status_id blocked -- Ignora Stat_aggreg
IF    NEW.NotUse_StatEf='1' 
THEN  SET NEW.Stat_aggreg=NEW.`Status_id`;
END IF;

SET NEW.Stat_effect=(
   CASE NEW.Stat_aggreg
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

END$$

DELIMITER ;

-- ----------------------------------------------------------------------------
-- ----------------------------------------------------------------------------
DROP TRIGGER IF EXISTS campaign_marketing_source_before_update_status;  -- antiguo
DROP TRIGGER IF EXISTS campaign_marketing_source_BEFORE_UPDATE_Stat_aggreg;
--
DELIMITER $$

CREATE TRIGGER campaign_marketing_source_BEFORE_UPDATE_Stat_aggreg BEFORE UPDATE
ON campaign_marketing_source FOR EACH ROW
--
BEGIN
--
SET @Version='v1.1 01.04.2023';

SET NEW.Status=(
   CASE NEW.Status_id
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

-- Si no tiene Channel, toma el Status del Afiliado
IF  NEW.`Stat_Chan` IS NULL 
THEN SET NEW.`Stat_Chan` =(SELECT IFNULL(A.Status_id,'1') FROM account_account A where A.id=NEW.Affiliate_id);
END IF;

SET NEW.Stat_aggreg=(
   CASE WHEN NEW.`Status_id`!='1'
        THEN NEW.`Status_id`
        ELSE 
            (CASE WHEN NEW.`Stat_Acct`!='1'
                  THEN NEW.`Stat_Acct`
                  ELSE NEW.`Stat_Chan` END)
        END
);

-- Status_id blocked -- Ignora Stat_aggreg
IF    NEW.NotUse_StatEf='1' 
THEN  SET NEW.Stat_aggreg=NEW.`Status_id`;
END IF;

SET NEW.Stat_effect=(
   CASE NEW.Stat_aggreg
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
   END
);

-- No cambia rebrandly a menos que haya un cambio de enable/disable o cambio de tracklink
IF (NEW.`Stat_aggreg`!=OLD.`Stat_aggreg` 
    AND 
   (NEW.`Stat_aggreg`=1 OR OLD.`Stat_aggreg`=1)
   ) 
   OR
	NEW.`Tracklink`  !=OLD.`Tracklink` 
THEN 
   DELETE FROM `campaign_mkt_source_url` WHERE `MS_id`=NEW.`id`;
   INSERT INTO `campaign_mkt_source_url` (
      `MS_id`        
      ,`Stat_MS`  
      ,`Stat_aggreg`  
      ,`Stat_effect`  
      ,`Affiliate_id` 
      ,`Tracker_ID`   
      ,`Tracklink`    
      ,`Shortlink`    
      ,`Shortlink_id` 
   )
   VALUES (
       NEW.id
      ,NEW.`Status_id`  
      ,NEW.`Stat_aggreg`  
      ,NEW.`Stat_effect`  
      ,NEW.`Affiliate_id` 
      ,NEW.`Tracker_ID`   
      ,NEW.`Tracklink`    
      ,NEW.`Shortlink`    
      ,NEW.`Shortlink_id`
   );
END IF;
END$$
--
DELIMITER ;

-- ----------------------------------------------------------------------------
-- ----------------------------------------------------------------------------
DROP TRIGGER IF EXISTS campaign_mkt_source_url_AFTER_UPDATE_notify;

DELIMITER $$
--
CREATE TRIGGER campaign_mkt_source_url_AFTER_UPDATE_notify AFTER UPDATE
ON campaign_mkt_source_url FOR EACH ROW
--
BEGIN
--
SET @Version='v1 13.03.2023';

IF NEW.`Stat_Sent_to_API`!= OLD.`Stat_Sent_to_API` THEN
   -- Elimina otras notificaciones de hoy para la misma MS
   DELETE FROM account_notifications WHERE Extra_id_1=NEW.MS_id AND LEFT(DATE,10)=CURDATE();
   -- Inserta nueve notificacion
   INSERT INTO account_notifications (Affiliate_id,Extra_id_1,Testo,FromUser,TYPE, Status,Status_id, Read_Status)
      SELECT M.Affiliate_id,M.id
         ,CONCAT(AC.Username," TRACKER ",M.Code_To_Affiliate,"/",AD.Advertiser_Name," now ",UPPER(M.Stat_effect)
            ," (MS:",M.id,"/",M.Product,"/",IFNULL(L.landing_page_name,"Channel:none"),")")
         ,'System','MS Status Change','Pending',0,0
      FROM campaign_marketing_source M
      LEFT  JOIN account_account AC          on M.Affiliate_id =AC.id
      LEFT  JOIN campaign_advertiser AD      ON M.Advertiser_id=AD.id
      LEFT  JOIN account_landing_pages L     ON M.Channel_id   =L.id
      WHERE NEW.MS_ID=M.id;
END IF;

END$$

DELIMITER ;

