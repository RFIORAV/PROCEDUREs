-- ----------------------------------------------------------------------------
DROP TRIGGER IF EXISTS account_landing_pages_BEFORE_UPDATE_status_id;
DELIMITER $$
--
CREATE TRIGGER account_landing_pages_BEFORE_UPDATE_status_id BEFORE UPDATE
ON account_landing_pages FOR EACH ROW
--
BEGIN
--
SET @Version='v1.1 01.04.2023';

SET NEW.Status=(
   CASE NEW.Status_id
      WHEN '0' THEN 'Inactive'
      WHEN '1' THEN 'Active'
      WHEN '4' THEN 'Paused'
      WHEN '6' THEN 'Paused auto NM'
      ELSE 'Other'
