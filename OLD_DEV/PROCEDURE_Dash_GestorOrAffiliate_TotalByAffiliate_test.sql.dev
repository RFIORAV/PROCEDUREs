/* 
PROCEDURE_Dash_GestorOrAffiliate.sql - Dashboard Gestor/Afiliado datos acumulados por Afiliado

Observaciones: 
   Parámetro 1=ViewGES PARA VIEWS DEL GESTOR    (usa FACT1)
   Parámetro 1=ViewAFF PARA VIEWS DEL AFILIADO  (usa FACT2)
   Parámetro 5=EUR/GBP/USD los resultados se expresan en esta moneda CON conversión
   Parámetro 5=ALL los resultados se expresan en la moneda de origen SIN conversión
   Parámetro 7=ROLLUP aplica la cláusula WITH ROLLUP al GROUP BY

Parámetros ( [ViewGES | ViewAFF] , [AffiliateID | ALL] , [Month] , [Owner | ALL] , [Currency | ALL], [ROLLUP | ' '] )

Ejemplos:
      call Dash_TotalByAffiliate('ViewAFF','39' ,'2022-09','ALL','EUR','ROLLUP');
      call Dash_TotalByAffiliate('ViewGES','ALL','2022-09','ALL','USD','ROLLUP');
      call Dash_TotalByAffiliate('ViewGES','ALL','2022-09','ALL','GBP','ROLLUP');
      call Dash_TotalByAffiliate('ViewAFF','ALL','2022-09','ALL','ALL','ROLLUP');      
      call Dash_TotalByAffiliate('ViewAFF','ALL','2022-09','ALL','ALL','');            
      call Dash_TotalByAffiliate('ViewGES','ALL','2022-09','ALL','EUR','');
      call Dash_TotalByAffiliate('ViewGES','ALL','2022-06','2'  ,'EUR','ROLLUP');
      call Dash_TotalByAffiliate('ViewAFF','39' ,'2022-08','ALL','EUR','');

07.09.2022 V1
*/
DROP PROCEDURE IF EXISTS Dash_TotalByAffiliateTest;

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Dash_TotalByAffiliateTest`(IN
   AreaUser VARCHAR(50),
   AffiliateID VARCHAR(50),
   Month VARCHAR(7),
   Owner VARCHAR(50),
   Curr_result VARCHAR(3),
   RollUp VARCHAR(6)
   )
    COMMENT 'Dashboard Gestor o Afiliado. Tot x Affiliate/ALL - Currency conversion'
BEGIN
   
	IF upper(AffiliateID)='ALL' THEN
   	SET @AffiliateID_from='0';
      SET @AffiliateID_until='9999999999999';
   ELSE
   	SET @AffiliateID_from=CAST(AffiliateID AS UNSIGNED INTEGER);
      SET @AffiliateID_until=CAST(AffiliateID AS UNSIGNED INTEGER);
	END IF;

	IF LOWER(ifnull(Owner,'ALL'))='all' THEN
   	SET @Owner_from='0';
      SET @Owner_until='9999999999999';
   ELSE
   	SET @Owner_from=CAST(Owner AS UNSIGNED INTEGER);
      SET @Owner_until=CAST(Owner AS UNSIGNED INTEGER);
	END IF;

	IF Month is not null THEN
      SET @Month_Report=CONCAT("'",Month,"'");
   ELSE
      SET @Month_Report=CONCAT("'",LEFT(curdate(),7),"'");
	END IF;
   
	IF LOWER(ifnull(RollUp,''))='rollup' THEN
      SET @RollUp=' WITH ROLLUP HAVING `CPA_Value_Affiliate`<>0 OR `RS_Affiliate`<>0';
   ELSE
      SET @RollUp=' HAVING `CPA_Value_Affiliate`<>0 OR `RS_Affiliate`<>0 ORDER BY Owner,Data_Currency,Affiliate';
	END IF;
   -- ----------------------------------------------------
   -- ----------------------------------------------------
   SET @Goup_by=' GROUP BY Owner,Affiliate '; 

   IF upper(Curr_result)='ALL' THEN
      SET @Curr_result=CONCAT('"',upper(Curr_result),'"');
      SET @Goup_by=' GROUP BY Owner,Data_Currency,Affiliate ';
   ELSE
      SET @Curr_result=CONCAT('"',upper(Curr_result),'"');
      -- SET @Goup_by=' GROUP BY Owner ';
      -- SET @RollUp=' HAVING `CPA_Value_Affiliate`<>0 OR `RS_Affiliate`<>0 ORDER BY Owner,Affiliate';
	END IF;
   -- ----------------------------------------------------
	IF AreaUser='ViewGES' THEN
      SET @DataTable=" FROM Snapshot_day_by_day_fact3 ";
      SET @SQL_Select='
      ,ROUND(SUM(CPA_Value_Gestor)       /xx.Coef,2) AS `CPA_Value_Gestor`
      ,ROUND(SUM(Net_Revenue)            /xx.Coef,2) AS `Net_Revenue`
      ,ROUND(SUM(Revenue_Share_Gestor)   /xx.Coef,2) AS `RS_Gestor`
      ,ROUND(SUM(CPA_Value_Affiliate)    /xx.Coef,2) AS `CPA_Value_Affiliate`
      ,ROUND(SUM(Revenue_Share_Affiliate)/xx.Coef,2) AS `RS_Affiliate`
      ,ROUND((SUM(CPA_Value_Gestor)-SUM(CPA_Value_Affiliate)
                                        )/xx.Coef,2) AS `CPA_Profit` \r\n';
   ELSE
      SET @DataTable=" FROM Snapshot_day_by_day_fact2 ";
      SET @SQL_Select='
      ,ROUND(SUM(Net_Revenue)            /xx.Coef,2) AS `Net_Revenue`
      ,ROUND(SUM(CPA_Value_Affiliate)    /xx.Coef,2) AS `CPA_Value_Affiliate`
      ,ROUND(SUM(Revenue_Share_Affiliate)/xx.Coef,2) AS `RS_Affiliate`
      ,SUM(`First_Time_Deposit`) AS `FTD`
      ,SUM(`Views`             ) AS `Views`             
      ,SUM(`Clicks`            ) AS `Clicks`            
      ,SUM(`Signups`           ) AS `Signups`           
      ,SUM(`Impressions`       ) AS `Impressions` \r\n';      
	END IF;   
   -- ----------------------------------------------------
   
   
   SET SESSION group_concat_max_len = 100000;
   
   SET @SQL = CONCAT(
   'SELECT Owner,left(Date,7) as `Month`
   	,IF(',@Curr_result,'="ALL",Data_Currency,',@Curr_result,') as `Data_Currency`
   	,`Affiliate`
      ,SUM(Qualified_Players) AS `CPA`'
   ,@SQL_Select
   ,@DataTable
   ,' LEFT JOIN LATERAL (SELECT
     (SELECT Rate FROM exchange_rate x WHERE x.Currency=Data_Currency)/
     (SELECT Rate FROM exchange_rate x WHERE x.Currency='
     ,'IF(',@Curr_result,'="ALL",Data_Currency,',@Curr_result,')) as Coef ) 
      AS xx ON TRUE
   WHERE LEFT(DATE,7)=',@Month_Report
   ,' and Affiliate_id BETWEEN ',@AffiliateID_from,' AND ',@AffiliateID_until
   ,' and Owner BETWEEN ',@Owner_from,' AND ',@Owner_until,'\r\n'
   ,@Goup_by,@RollUp,';');

-- SELECT @SQL;
   PREPARE stmt1 FROM @SQL;
   EXECUTE stmt1;
   DEALLOCATE PREPARE stmt1;

END$$
DELIMITER ;

/*
      call Dash_TotalByAffiliateTest('ViewGES','ALL',LEFT(DATE_SUB(curdate(), INTERVAL 1 MONTH),7),'ALL','EUR','ROLLUP');
      call Dash_TotalByAffiliateTest('ViewGES','ALL',LEFT(CURDATE(),7),'ALL','EUR','ROLLUP');
      call Dash_TotalByAffiliateTest('ViewGES','ALL',LEFT(CURDATE(),7),'ALL','EUR','');
      call Dash_TotalByAffiliateTest('ViewGES','ALL',LEFT(DATE_SUB(curdate(), INTERVAL 1 MONTH),7),'2'  ,'EUR','ROLLUP');

      call Dash_TotalByAffiliate('ViewAFF','39' ,LEFT(DATE_SUB(curdate(), INTERVAL 1 MONTH),7),'ALL','EUR','');
      call Dash_TotalByAffiliate('ViewAFF','ALL',LEFT(DATE_SUB(curdate(), INTERVAL 1 MONTH),7),'ALL','EUR','ROLLUP');
      call Dash_TotalByAffiliate('ViewAFF','ALL',LEFT(CURDATE(),7),'ALL','ALL','ROLLUP');      
      call Dash_TotalByAffiliate('ViewAFF','ALL',LEFT(CURDATE(),7),'ALL','ALL','');            
*/
