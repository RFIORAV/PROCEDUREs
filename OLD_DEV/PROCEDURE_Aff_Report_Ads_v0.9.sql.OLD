/*
PROCEDURE_Aff_Report_Ads.sql - Report Ads

Observaciones:

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguidO por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.

Keys:

Affiliate_id     =[id de Afiliado]

Filters          =[Yes | No]. Devuelve la lista de filtros. OPCIONAL. Default=no.
Meta             =[No | Yes]. OPCIONAL. Columna 1 como METADATO: total/data/setting. Default [No]
Debug            =[No | Yes | KeyValues]. OPCIONAL. Default=No
                  [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query.

Parámetros ('[Key=Value[,...]'])

Ejemplos:

call Aff_Report_Ads('Affiliate_id=490,debug=ye');

v1       14.02.2025 Primera versión operativa

*/

DROP PROCEDURE IF EXISTS Aff_Report_Ads;

DELIMITER $$

CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Aff_Report_Ads`(IN
   InputCommLine    VARCHAR(250)
   )
    COMMENT 'Report Ads Afiliates'
    
proc_label:BEGIN
-- --------------------------------------------------------------------------------------------
-- Defaults
SET @Version         ='v1 14.02.2025';
SET @CurrentDay      =curdate();
SET @Month           =left(curdate(),7);
SET @Affiliate_id    ='ALL';
SET @Status_id       ='ALL';
SET @Debug           ='NO';
SET @Filters         ='NO';
SET @Meta            ='YES';

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
-- SET @InputCommLine=replace(@InputCommLine,' ','');  -- Elimina espacios
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

IF @Debug!="NO" THEN SELECT @InputCommLine; END IF;
-- IF @Debug="YES" THEN SELECT @Owner,@Month,@Currency,@Advertiser_id,@ByAccount,@Debug,@Total,@TotLine,@OrderBy,@Order,@InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit,Product=Sport!-!Footbol,Filter=yes
-- @InputCommLine: ----5----0----5----0----5----0----5----0----5----0----5----0----5----0----5----0
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);

   IF lower(@k)='Affiliate_id'    THEN SET @Affiliate_id  =UPPER(@v); END IF;
   IF lower(@k)='status_id'       THEN SET @Status_id     =      @v;  END IF;
   IF lower(@k)='debug'           THEN SET @Debug         =UPPER(@v); END IF;
   IF lower(@k)='filters'         THEN SET @Filters       =UPPER(@v); END IF;
   IF lower(@k)='meta'            THEN SET @Meta          =UPPER(@v); END IF;

END WHILE;

CREATE TABLE IF NOT EXISTS campaign_advertiser_ads_v2 (
  id INT UNSIGNED NOT NULL AUTO_INCREMENT,  
  Ads_Code      VARCHAR(50)   NOT NULL,  -- Código del anuncio
  Product       VARCHAR(50)   NOT NULL,  -- 'sport', 'casino', etc.
  Brand         VARCHAR(100)  NOT NULL,  -- Nombre de la marca (advertiser), derivada de 'Account' 
  Account_id    INT           NOT NULL,  -- Identificador de cuenta
  Country       VARCHAR(50)   NULL,      -- País al cual se aplica; NULL = para todos
  Title         VARCHAR(255)  NOT NULL,  -- Título resumido del Ad
  Description   TEXT          NOT NULL,  -- Descripción detallada del Ad
  Valid_From    DATE          NOT NULL,  -- Fecha desde la cual aplica
  Valid_To      DATE          NULL,      -- Fecha hasta la cual aplica; NULL = permanente
  -- Campos de control/ auditoría
  Creation_Date DATETIME      NULL DEFAULT CURRENT_TIMESTAMP,
  Last_Update   DATETIME      NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  User          INT           NULL DEFAULT NULL,

  PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS campaign_advertiser_ads_applied_v2 (
  id INT UNSIGNED NOT NULL AUTO_INCREMENT,
  Ads_Code    INT UNSIGNED    NOT NULL,  -- FK que referencia a 'campaign_advertiser_ads_v2(Ads_Code)'
  ms_id       INT UNSIGNED    NOT NULL,  -- FK que referencia a la tabla de Marketing Source
  Status_id   TINYINT         NOT NULL,  -- 1=Activo, 0=Obsoleto (o inactivo)
  Product     VARCHAR(50)     NOT NULL,  -- Copia de 'Product' para control
  Account_id  INT             NOT NULL,  -- Copia de 'Account_id' para control
  Tracklink_new VARCHAR(500)  NOT NULL,  -- URL con el [Ads_Code]
  Valid_From  DATE            NOT NULL,
  Valid_To    DATE            NULL,
  -- Campos de control / auditoría
  Creation_Date DATETIME      NULL DEFAULT CURRENT_TIMESTAMP,
  Last_Update   DATETIME      NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  User          INT           NULL DEFAULT NULL,

  PRIMARY KEY (id)
  ,KEY fk_Ads_Code (Ads_Code)
  -- CONSTRAINT fk_Ads_Code 
    -- FOREIGN KEY (Ads_Code) 
    -- REFERENCES campaign_advertiser_ads_v2(id)
    -- ON UPDATE CASCADE
    -- ON DELETE RESTRICT
);

/*
    Muestra los Ads que son válidos hoy y que coinciden 
    con las MS pertenecientes al afiliado.
    
SELECT `id`,`Owner`,`Code`,`Tracklink`,`Tracker_ID`,`Tracker_Name`,`Code_To_Affiliate`,`Product`
      ,`Source`,`CPA_Limit`,`Status`,`Status_id`,`NotUse_StatEf`,`Stat_effect`,`Stat_aggreg`
      ,`Stat_Chan`,`Stat_Acct`
      ,`Status_Adv_id`,`Status_Acct_id`,`Status_Aff_id`,`Status_Channel_id`,`Status_Pub_id`
      ,`Valid_From`,`Valid_Until`,`Description`
      ,`Affiliate_id`,`Advertiser_id`,`Advertiser_id_OK`,`Publisher_id`,`Campaign_id`,`Username_id`,`Channel_id`
      ,`Deal_id`,`Country_Deal`,`Product_Deal`,`Deal_Valid_From`,`Shortlink`,`Shortlink_id`
      ,`Manual_Adjustment_CPA`,`Manual_Adjustment_Euro`,`Priority`,`Creation_Date`,`Last_Update`,`Operator` 
FROM campaign_marketing_source    
*/
   
WITH Aff_all_ms as (  
  SELECT  
          ms.`id`                as `MS_id`
         ,ms.`Tracklink`         as `Tracklink`
         ,SUBSTRING_INDEX(SUBSTRING(ms.Tracklink,LOCATE('bid=',ms.Tracklink) + 4), "&", 1) as `MS_BID`
         ,ms.`Tracker_ID`        as `Tracker_ID`
         ,ms.`Tracker_Name`      as `Tracker_Name`
         ,ms.`Code_To_Affiliate` as `Code_To_Affiliate`
         ,ms.`Product`           as `MS_Product`
         ,ms.`Affiliate_id`      as `Affiliate_id`
         ,ms.`Username_id`       as `Username_id`
         ,apl.`Ads_Code`         as `apl_Ads_Code`
         ,apl.`Valid_To`         as `apl_Valid_To`
         ,apl.`Status_id`        as `apl_Status_id`         
         ,a.`Ads_Code`,a.`Product`,a.`Brand`,a.`Account_id`,a.`Country`
         ,a.`Title`,a.`Description`,a.`Status_id`,a.`Valid_From`,a.`Valid_To`
    FROM campaign_advertiser_ads_v2 a
    JOIN campaign_marketing_source ms
      ON ms.Product    = a.Product
     AND ms.Username_id = a.Account_id
    LEFT JOIN campaign_advertiser_ads_applied_v2 apl ON apl.`MS_id`=ms.`id`
     
    -- Ejemplo de cómo distinguir Tracklink "directo":
    WHERE ms.affiliate_id = @Affiliate_id
      AND a.`Status_id`=1
      AND ms.Stat_aggreg IN (1,6)
      AND ms.Tracklink NOT LIKE '%rebrand.ly%'
      AND ms.Tracklink NOT LIKE '%affly%'
      AND a.Valid_From <= CURDATE()
      AND (a.Valid_To > CURDATE() OR a.Valid_To IS NULL)
)
SELECT 'all' as `Stat`,A.* FROM Aff_all_ms A; 
/*
SELECT 'Default' as `Stat`,A.* FROM Aff_all_ms A 
-- LEFT JOIN campaign_advertiser_ads_applied_v2 apl ON apl.`MS_id`=A.`MS_id`
WHERE  `MS_BID`!=Ads_Code -- and 
     -- (`apl_Ads_Code` IS NULL OR `apl_Status_id`=0)
UNION ALL
SELECT 'Assigned' as `Stat`,A.* FROM Aff_all_ms A 
-- LEFT JOIN campaign_advertiser_ads_applied_v2 apl ON apl.`MS_id`=A.`MS_id`
WHERE `MS_BID`!=Ads_Code and `apl_Ads_Code` IS NOT NULL and `apl_Status_id`=1
order by Tracklink
;
*/
      
END $$
DELIMITER ;

