/*
16.07.2024
call Report_MarketingSources1('Mode=Gestor,Affiliate_id=440,DealbyProduct=yes,Brand=WilliamHill,filters=NO,meta=yes,debug=ye');

*/

WITH FactX as (
	SELECT
       D.MS_id
      ,D.`Product`
      ,ROUND(SUM(IFNULL(D.`Qualified_Players`  	    ,0)),0) AS `CPA`
      ,ROUND(SUM(IFNULL(D.`First_Time_Deposit`      ,0)),0) AS `FTD`
      ,ROUND(SUM(IFNULL(D.`Views`                   ,0)),0) AS `Views`
      ,ROUND(SUM(IFNULL(D.`Clicks`                  ,0)),0) AS `Clicks`
      ,ROUND(SUM(IFNULL(D.`Signups`                 ,0)),0) AS `Signups`
      ,ROUND(SUM(IFNULL(D.`Impressions`             ,0)),0) AS `Impress`
      ,ROUND(SUM(IFNULL(D.`Deposits`                ,0)),2) AS `Deposits`
      ,ROUND(SUM(IFNULL(D.`Depositing_Customers`    ,0)),0) AS `Dep Cust`
      ,ROUND(SUM(IFNULL(D.`Active_Customers`        ,0)),0) AS `Act Cust`
      ,ROUND(SUM(IFNULL(D.`New_Depositing_Customers`,0)),0) AS `New Dep Cust`
      ,ROUND(SUM(IFNULL(D.`New_Active_Customers`    ,0)),0) AS `New Act Cust`
      ,D.`Language`                                         AS `Country`
      ,D.`Deal_Aff_id`
      ,D.`Deal_Aff_Valid_From`
      ,D.`Channel_id`
   FROM Snapshot_day_by_day_fact1 D
   WHERE LEFT(D.DATE,7)=LEFT(CURDATE(),7) 
   GROUP by D.MS_id,D.Deal_Aff_id -- ,D.Product
)
,
campaign_marketing_source_updated AS (
SELECT 'data' as `Meta`,'...' as `Action`,
   M.`id`                  AS MS_id
  ,P.`Advertiser_name`     as `Publisher`
  ,AD.Advertiser_Name      as `Brand`
  ,CU.Username             as `Account`
  ,M.`Tracker_ID`          -- as `Tracker ID`
  ,M.`Tracker_Name`        -- as `Tracker Name`
  ,A.username              as `Affiliate`
  ,ifnull(CH.landing_page_name,"none") as `Channel`
  ,ifnull(M.Product,"any") AS `Product`
  ,case when M.`Status_id`!=M.`Stat_aggreg`
        then case when M.`Status_id`=1
                  then M.`Status`
                  else concat(M.`Status`," *")
                  end
        else concat(M.`Status`," *")
        end                                        as `MStatus`
    ,(CASE WHEN M.`Status_id`="1"
           THEN (CASE WHEN M.`Stat_Acct`!="1" or M.`Stat_Chan`!="1"
                      THEN (CASE WHEN M.`Stat_Acct`="0" THEN "Inactive *"
                                 WHEN M.`Stat_Acct`="4" THEN "Paused *"
                                 WHEN M.`Stat_Acct`="6" THEN "Paused auto NM *"
                                 WHEN M.`Stat_Acct`>"1" THEN "Other *"
                                 WHEN M.`Stat_Chan`="0" THEN "Inactive *"
                                 WHEN M.`Stat_Chan`="4" THEN "Paused *"
                                 WHEN M.`Stat_Chan`="6" THEN "Paused auto NM *"
                                 WHEN M.`Stat_Chan`>"1" THEN "Other *"
                                 ELSE "Active" END)
                      ELSE "Active" END)
           ELSE (CASE WHEN M.`Stat_Acct`!="1" or M.`Stat_Chan`!="1"
                      THEN (CASE WHEN M.`Stat_Acct`="0" THEN "Inactive "
                                 WHEN M.`Stat_Acct`="4" THEN "Paused "
                                 WHEN M.`Stat_Acct`="6" THEN "Paused auto NM "
                                 WHEN M.`Stat_Acct`>"1" THEN "Other "
                                 WHEN M.`Stat_Chan`="0" THEN "Inactive "
                                 WHEN M.`Stat_Chan`="4" THEN "Paused "
                                 WHEN M.`Stat_Chan`="6" THEN "Paused auto NM "
                                 WHEN M.`Stat_Chan`>"1" THEN "Other "
                                 ELSE "Active" END)
                      ELSE "Active" END)
           END)                                       as `Derived_Status`
  ,M.`Shortlink`
  ,CU.`Area`               -- AS `Area`
  ,IF(@DealbyProduct="NO","--",M1.`Deal_id`)         as `Deal_id`
  ,IF(@DealbyProduct="NO","--",M1.`Deal_Valid_From`) as `Valid From`
  ,IF(@DealbyProduct="NO","--",CDA.Deal_Name)        as `Deal Name`
  ,IF(@DealbyProduct="NO",0,CDA.CPA_Value)        as `CPA_Value`       -- Karen 04/03/2024
  ,IF(@DealbyProduct="NO",0,CDA.RS_Percentage)    as `RS_Percentage`   -- Karen 04/03/2024
  ,IF(@DealbyProduct="NO",0,CDA.Baseline)         as `Baseline`        -- Karen 04/03/2024
  ,IF(@DealbyProduct="NO","--",if(M1.`Product`="","any",M1.`Product`)) AS `Product Fact` -- 02.03.2024
  ,IF(@DealbyProduct="NO","--",M1.`Deal_id`)         as `Deal Fact`    
  ,ifnull(D1.CPA,0)        as `Sum_CPA`
  ,M.`CPA_Limit`           --  `CPA Limit`
  ,M.`Status_id`           --  `Stat id`
  ,CU.`Stat_Adve`          --  `Stat Adv`
  ,M.`Stat_Acct`           --  `Stat Acct`
  ,CH.`Stat_Affi`          --  `Stat Aff`
  ,M.`Stat_Chan`           --  `Stat Chan`
  ,M.`Shortlink_id`
  ,M.`Tracklink`
  ,M.`Description`
  ,M.`Code_To_Affiliate`      as `Tracker Aff`
  -- ,IF(CU.Owner=A.id,"Direct","") AS `Owner`
  ,M.Owner                    AS `Owner_id`
  ,OW.username                AS `Owner`
  ,D1.`FTD`
  ,D1.`Views`
  ,D1.`Clicks`
  ,D1.`Signups`
  ,D1.`Impress`
  ,D1.`Deposits`
  ,D1.`Dep Cust`
  ,D1.`Act Cust`
  ,D1.`New Dep Cust`
  ,D1.`New Act Cust`
  ,D1.`Country`
  ,M.`Creation_Date`,M.`Last_Update`,M.`Operator`,@Count:=@Count+1 as `Count`
  ,`M2`.`Affiliate_id`,`M`.`Channel_id`,`M`.`Username_id`
  ,`CU`.`Advertiser_id`
  ,`CU`.`Publisher_id`
  ,M.`Code_To_Affiliate`
  ,M.`Status`
  ,M.`Stat_effect`
  ,M.`Stat_aggreg`
--   ,M.`NotUse_StatEf`
  ,case when M.`Status_id`!=M.`Stat_aggreg`
        then case when M.`Status_id`="1"
                  then concat(M.`Stat_effect`," *")
                  else concat(M.`Status`," *") end
        else concat(M.`Status`," *") end `TStat_final`
  ,M.`Stat_effect` as `MStat_effect`
  ,CASE M.`Stat_Chan` 
        WHEN "0"  THEN "Inactive"
        WHEN "4"  THEN "Paused"
        WHEN "6"  THEN "PauseNM"
        ELSE "Other" END as `MStat_Chan`
  ,CASE M.`Stat_Acct` 
        WHEN "0"  THEN "Inactive"
        WHEN "4"  THEN "Paused"
        WHEN "6"  THEN "PauseNM"
        ELSE "Other" END as `MStat_Acct`

FROM `campaign_marketing_source` `M`
-- ---Seleccion de Affiliate-----(tomado de Snapshot_day_by_day_fact1_upd_from_dbd)------
LEFT JOIN LATERAL (
	SELECT *,ROW_NUMBER() OVER(PARTITION BY MS_id ORDER BY Deal_Valid_From DESC,id DESC) AS RowNr  -- 15.02.2023
	FROM `campaign_mkt_source_deal` WHERE `MS_id` = M.id AND `is_active` = 1
--                                   AND `Deal_Valid_From` <= `D`.`Date`
	ORDER BY RowNr LIMIT 1
) AS M2 ON TRUE
-- ---Seleccion de Product-------(tomado de Snapshot_day_by_day_fact1_upd_from_dbd)------
LEFT JOIN LATERAL (
	SELECT * FROM (
      SELECT *,ROW_NUMBER() OVER(PARTITION BY Product ORDER BY Deal_Valid_From DESC,id DESC) AS RowNr  -- 15.02.2023
      FROM `campaign_mkt_source_deal` WHERE `MS_id` = M.id AND Affiliate_id=M2.Affiliate_id AND `is_active` = 1
--                                      AND `Deal_Valid_From` <= `D`.`Date`
	) AS DbP
	WHERE RowNr=1 -- AND IFNULL(DbP.`Product`,"") IN (IFNULL(M.Product,""),""," ") -- 28.04.2023
	ORDER BY DbP.`Product` DESC  ) AS M1 ON TRUE
LEFT JOIN FactX D1 ON D1.MS_id=M.id and D1.Deal_Aff_id=`M1`.`Deal_id`
LEFT JOIN `account_account` `A`           ON `A`.`id`  = `M2`.`Affiliate_id`
LEFT JOIN `account_account` `OW`          ON `OW`.`id` = `M`.`Owner`
LEFT JOIN `campaign_deal_affiliate` `CDA` ON `CDA`.`id`= `M1`.`Deal_id`
LEFT JOIN `account_landing_pages` `CH`    ON `CH`.`id` = `M`.`Channel_id`
LEFT JOIN `campaign_username` `CU`        ON `CU`.`id` = `M`.`Username_id`
LEFT JOIN `campaign_advertiser` `AD`      ON `AD`.`id` = `CU`.`Advertiser_id`
LEFT JOIN `campaign_publisher` `P`        ON `P`.`id`  = `CU`.`Publisher_id`
WHERE 1=1 -- and M.`Tracklink` > " "
 AND CU.Advertiser_id IN (14, 123) AND M2.Affiliate_id  =440)
,
MS_filtered AS (
SELECT * FROM campaign_marketing_source_updated M
WHERE 1=1  )
(
SELECT
   "setting" as Meta
   ,"width=80px,action=2" as `Action`
   ,"width=80px,center=true" as MS_id
   ,if(@Publisher_id="ALL","width=120px","omit=true") as Publisher
   ,if(@Advertiser_id="ALL","width=120px","omit=true") as Brand
   ,if(@Account_id="ALL" and @Account="ALL","width=120px,tooltip=yes","omit=true") as Account
   ,"width=150px,tooltip=yes" as `Tracker ID`
   ,"width=150px,tooltip=yes" as `Tracker name`
   ,if(@Affiliate_id="ALL","width=160px","omit=true") as Affiliate
   ,if(@Channel!="ALL" or @Channel_id!="ALL","omit=true","width=150px") Channel
   ,if(@Product!="ALL","omit=true","width=100px") Product
   -- -----------------------------------------------------
   ,"width=80px" `MS Status`
   ,"width=90px" `Derived Status`
   ,"width=160px" as Shortlink
   ,IF(@Kforex>0,"width=80px,center=true","omit=true") as Area
   -- -----------------------------------------------------
   ,IF(@DealbyProduct="NO","omit=true","width=090px,center=true") `Deal id`
   ,IF(@DealbyProduct="NO","omit=true","width=090px,center=true") `Deal Valid From`
   ,IF(@DealbyProduct="NO","omit=true","width=400px")             `Deal Name`
   ,IF(@DealbyProduct="NO","omit=true","width=090px")             `Deal CPA`
   ,IF(@DealbyProduct="NO","omit=true","width=090px")             `Deal RS`
   ,IF(@DealbyProduct="NO","omit=true","width=090px")             `Deal BS`
   ,IF(@DealbyProduct="NO","omit=true","width=120px")             `Product Deal`
   -- ,IF(@DealbyProduct="NO","omit=true","width=090px")          `Deal id Fact`
   ,"omit=true"   `Deal id Fact`
   ,"width=090px" `CPAs F2 CMonth`
   ,"width=090px,center=true" `CPA Limit`
   ,"omit=true"   `St`
   ,"omit=true"   `St1`
   ,"omit=true"   `St2`
   ,"omit=true"   `St3`
   ,"omit=true"   `St4`
   ,"omit=true" as Shortlink_id
   ,"omit=true" `Tracklink`
   ,"omit=true" as Description
   ,"width=150px" `Code To Affiliate`
   ,if(@Owner!="ALL","omit=true","width=80px") as `Owner id`
   ,if(@Owner!="ALL","omit=true","width=120px") as Owner
   ,"width=90px"  `FTD`
   ,"width=90px"  `Views`
   ,"width=90px"  `Clicks`
   ,"width=90px"  `Signups`
   ,"width=90px"  `Imprss`
   ,"width=100px"  `Deposits`
   ,"width=90px"  `Dep Cust`
   ,"width=90px"  `Act Cust`
   ,"width=90px"  `New Dep Cust`
   ,"width=90px"  `New Act Cust`
   ,"width=90px"  `Country`
   ,"omit=true" as Creation_Date,"omit=true" as LastUpd,"omit=true" as Operator,"omit=true" as cont
   ,"omit=true" Affiliate_id
   ,"omit=true" Channel
   ,"omit=true" Username_id
   ,"omit=true" Advertiser_id
   ,"omit=true" Publisher_id
   ,"omit=true" Code_To_Affiliate
   ,"omit=true" `Status`
   ,"omit=true" `Stat_effect`
   ,"omit=true" `Stat_aggreg`
   ,"omit=true" Stat_final
   ,"omit=true" Mtat_final
   ,"width=100px" `Status Channel`
   ,"width=100px" `Status Account`   
	FROM DUAL WHERE @Meta="YES") UNION ALL 
(SELECT * FROM MS_filtered M
)
ORDER BY `Area` desc,`Brand`,Account,Affiliate,MS_id;