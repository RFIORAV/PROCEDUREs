   `Date` DATE NULL DEFAULT NULL COMMENT 'Issued date',
   `Due_Date` DATE NULL DEFAULT NULL COMMENT 'Due date',
   `Paymt_Date` DATE NULL DEFAULT NULL COMMENT 'Payment date',
   `Ammount` DECIMAL(10,2) NULL DEFAULT '0.00',
