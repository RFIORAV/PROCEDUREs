/**
PROCEDURE_Set_record_dbd_manual_v1.sql **	Agrega/modifica record a tabla Snapshot_day_by_day_manual

Observaciones:

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguidO por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.

Keys:

DbD_id                     =[ '' | record id Snapshot_day_by_day_manual]. ''=Add record. OPCIONAL. Default=''
MS_id                      =[id de MS]. OBLIGATORIO
is_active                  =[ 0 | 1]. OPCIONAL. Default=0 (Paused)
deal_to_apply              =[ 0 | 1 | 2]. 0=Deal Ges+Aff 1=Deal Aff 2=Deal Ges. OPCIONAL. Default=0
Date                       =[AAAA-MM-DD]. OPCIONAL. Default=Current Day.
Product                    =OPCIONAL. Default=''
Qualified_Players          =OPCIONAL. Default='0'
First_Time_Deposit         =OPCIONAL. Default='0'
Views                      =OPCIONAL. Default='0'
Clicks                     =OPCIONAL. Default='0'
Signups                    =OPCIONAL. Default='0'
Deposits                   =OPCIONAL. Default='0'
Depositing_Customers       =OPCIONAL. Default='0'
Active_Customers           =OPCIONAL. Default='0'
First_Time_Active_Customers=OPCIONAL. Default='0'
Turnover                   =OPCIONAL. Default='0'
Net_Revenue                =OPCIONAL. Default='0'

Debug           =[No | Yes | Any ]. OPCIONAL. Default=No
                  [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [Any] EJECUTA QUERY y devuelve KeyValues del Query.

Parámetros ('[Key=Value[,...]'])

Ejemplos:

CALL Set_record_dbd_manual ('is_active=2,deal_to_apply=1,MS_id=5722,date=2026-01-03,Qualified_Players=-1,debug=yes');
CALL Set_record_dbd_manual ('is_active=1,deal_to_apply=1,MS_id=568,date=2023-02-02,Product=Sport ,Country=MX,Qualified_Players=2,Net_Revenue=2221.20,debug=yes');


13.02.2023 v1
14.02.2023        Procedure procesa Altas (DbD_id='') y Modificaciones (DbD_id=int)
18.03.2024 v1.1   Product default=Product Real MS
26.01.2026 v1.2   Revisión para correcto funcionamiento de Qualified_Players
12.02.2026 v1.2.1 Se elimina el parámetro Country.

*/

DROP PROCEDURE IF EXISTS Set_record_dbd_manual;
DROP PROCEDURE IF EXISTS Set_record_dbd_manual_dev;
-- -------------------------------------------------------------
DELIMITER //

CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Set_record_dbd_manual`(IN
   InputCommLine    VARCHAR(500)
   )
    COMMENT 'ADD/EDIT record Snapshot_day_by_day_manual'
    
proc_label:BEGIN
-- --------------------------------------------------------------------------------------------
-- Defaults
SET @Version         ='v1.2.1 12.02.2026';
SET @CurrentDay      =curdate();
SET @Month           =LEFT(CURDATE(),7);

SET @DbD_id                     ='' ;
SET @MS_id                      ='' ;
SET @is_active                  ='0';
SET @deal_to_apply              ='0';
SET @Date                       =CURDATE();
SET @Product                    ='' ;
SET @Qualified_Players          ='0';
SET @First_Time_Deposit         ='0';
SET @Views                      ='0';
SET @Clicks                     ='0';
SET @Signups                    ='0';
SET @Deposits                   ='0';
SET @Depositing_Customers       ='0';
SET @Active_Customers           ='0';
SET @First_Time_Active_Customers='0';
SET @Turnover                   ='0';
SET @Net_Revenue                ='0';

SET @Debug           ='NO';
SET @Meta            ='YES';
SET @Filters         ='NO';

SET @xDbD_id=' ',@xMS_id=' ',@xis_active=' ',@xdeal_to_apply=' ',@xDate=' ',@xProduct=' '
   ,@xQualified_Players=' ',@xFirst_Time_Deposit=' ',@xViews=' ',@xClicks=' ',@xSignups=' '
   ,@xDeposits=' ',@xDepositing_Customers=' ',@xActive_Customers=' '
   ,@xFirst_Time_Active_Customers=' ',@xTurnover=' ',@xNet_Revenue=' ';

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

IF @Debug!="NO" THEN SELECT @InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit,Product=Sport!-!Footbol,Filter=yes
-- @InputCommLine: ----5----0----5----0----5----0----5----0----5----0----5----0----5----0----5----0
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);
--                                                                                            variable que indica dato informado
   if lower(@k)='dbd_id'                      THEN SET @DbD_id                     =@v; SET @xDbD_id                     ='x'; END IF;
   if lower(@k)='ms_id'                       THEN SET @MS_id                      =@v; SET @xMS_id                      ='x'; END IF;
   if lower(@k)='is_active'                   THEN SET @is_active                  =@v; SET @xis_active                  ='x'; END IF;
   if lower(@k)='deal_to_apply'               THEN SET @deal_to_apply              =@v; SET @xdeal_to_apply              ='x'; END IF;
   if lower(@k)='date'                        THEN SET @Date                       =@v; SET @xDate                       ='x'; END IF;
   if lower(@k)='product'                     THEN SET @Product                    =@v; SET @xProduct                    ='x'; END IF;
   if lower(@k)='qualified_players'           THEN SET @Qualified_Players          =@v; SET @xQualified_Players          ='x'; END IF;
   if lower(@k)='first_time_deposit'          THEN SET @First_Time_Deposit         =@v; SET @xFirst_Time_Deposit         ='x'; END IF;
   if lower(@k)='views'                       THEN SET @Views                      =@v; SET @xViews                      ='x'; END IF;
   if lower(@k)='clicks'                      THEN SET @Clicks                     =@v; SET @xClicks                     ='x'; END IF;
   if lower(@k)='signups'                     THEN SET @Signups                    =@v; SET @xSignups                    ='x'; END IF;
   if lower(@k)='deposits'                    THEN SET @Deposits                   =@v; SET @xDeposits                   ='x'; END IF;
   if lower(@k)='depositing_customers'        THEN SET @Depositing_Customers       =@v; SET @xDepositing_Customers       ='x'; END IF;
   if lower(@k)='active_customers'            THEN SET @Active_Customers           =@v; SET @xActive_Customers           ='x'; END IF;
   if lower(@k)='first_time_active_customers' THEN SET @First_Time_Active_Customers=@v; SET @xFirst_Time_Active_Customers='x'; END IF;
   if lower(@k)='turnover'                    THEN SET @Turnover                   =@v; SET @xTurnover                   ='x'; END IF;
   if lower(@k)='net_revenue'                 THEN SET @Net_Revenue                =@v; SET @xNet_Revenue                ='x'; END IF;
   IF lower(@k)='debug'                       THEN SET @Debug                      =@v; END IF;

END WHILE;

SET @DbD_id_INT=CAST(@DbD_id AS UNSIGNED);

IF @DbD_id_INT>0 THEN SET @DbD_id=@DbD_id_INT; ELSE SET @DbD_id=''; END IF;

IF @Product="any" THEN SET @Product=""; SET @xProduct=''; END IF;    -- 18.03.2024
-- ------------------------------------------------------------------------

/*
SELECT `id`,`is_active`,`deal_to_apply`,`MS_id`,`Area`,`Owner`,`Affiliate`,`Campaign`,`Deal`,`Deal_Aff`,`Hour_Update`
,`Date`,`Username`,`Portal`,`Brand`,`Tracker_ID`,`Tracker_Name`,`Code_To_Affiliate`,`Product`,`Product_Real`
,`Qualified_Players`,`Qualified_Players_Adjusted`,`Criteria_Type`,`Level_Reached`
,`First_Time_Deposit`,`Views`,`Clicks`,`Signups`,`Impressions`,`Sign_Up_Offer`,`Type`,`Language`,`Country`,`Brand_Name`,`Registration_Date`
,`Deposits`,`Depositing_Customers`,`Active_Customers`,`New_Depositing_Customers`,`New_Active_Customers`
,`First_Time_Active_Customers`,`Turnover`,`Net_Revenue`,`Revenue_Share_Gestor`,`Revenue_Share_Affiliate`
,`CPA_Value_Affiliate`,`CPA_Value_Gestor`
FROM Snapshot_day_by_day_manual
*/
IF  @DbD_id=''
THEN
   INSERT IGNORE INTO Snapshot_day_by_day_manual (
      `MS_id`
      ,`is_active`
      ,`deal_to_apply`
      ,`Date`
      ,`Product`
      ,`Qualified_Players`
      ,`First_Time_Deposit`
      ,`Views`
      ,`Clicks`
      ,`Signups`
--       ,`Country`
      ,`Deposits`
      ,`Depositing_Customers`
      ,`Active_Customers`
      ,`First_Time_Active_Customers`
      ,`Turnover`
      ,`Net_Revenue`
      ,`Area`
      ,`Username`
      ,`Brand`
      ,`Tracker_ID`
      ,`Tracker_Name`
      ,`Code_To_Affiliate`
      ,`Product_Real`
   )
   SELECT
       @MS_id                       AS `MS_id`
      ,@is_active                   AS `is_active`
      ,@deal_to_apply               AS `deal_to_apply`
      ,@Date                        AS `Date`
      ,case when @Product=""                                 -- 18.03.2024
            then M.`Product`                                 -- 18.03.2024
            else  @Product end      AS `Product`             -- 18.03.2024
      ,@Qualified_Players           AS `Qualified_Players`
      ,@First_Time_Deposit          AS `First_Time_Deposit`
      ,@Views                       AS `Views`
      ,@Clicks                      AS `Clicks`
      ,@Signups                     AS `Signups`
--       ,M.`Country`                  AS `Country`
      ,@Deposits                    AS `Deposits`
      ,@Depositing_Customers        AS `Depositing_Customers`
      ,@Active_Customers            AS `Active_Customers`
      ,@First_Time_Active_Customers AS `First_Time_Active_Customers`
      ,@Turnover                    AS `Turnover`
      ,@Net_Revenue                 AS `Net_Revenue`
      ,CU.`Area`                    AS `Area`
      ,M.`Username_id`              AS `Username`
      ,AD.`Advertiser_Name`         AS `Brand`
      ,M.`Tracker_ID`               AS `Tracker_ID`
      ,M.`Tracker_Name`             AS `Tracker_Name`
      ,M.`Code_To_Affiliate`        AS `Code_To_Affiliate`
      ,M.`Product`                  AS `Product_Real`
   FROM `campaign_marketing_source` `M`
   LEFT JOIN `campaign_username` `CU`   ON `CU`.`id` = `M`.`Username_id`
   LEFT JOIN `campaign_advertiser` `AD` ON `AD`.`id` = `CU`.`Advertiser_id`
   WHERE `M`.`id` = @MS_id
	;
ELSE
   UPDATE Snapshot_day_by_day_manual D
   SET  `is_active`                   =IF(@Xis_active                  ="x",@is_active                  ,is_active                  )
       ,`deal_to_apply`               =IF(@Xdeal_to_apply              ="x",@deal_to_apply              ,deal_to_apply              )
       ,`Date`                        =IF(@XDate                       ="x",@Date                       ,Date                       )
       ,`Product`                     =(case when @Product!=""    then @Product                         -- 18.03.2024
                                             WHEN `Product`="any" then `Product_Real`                   -- 18.03.2024
                                             else `Product` end)                                        -- 18.03.2024
       ,`Qualified_Players`           =IF(@XQualified_Players          ="x",@Qualified_Players          ,Qualified_Players          )
       ,`First_Time_Deposit`          =IF(@XFirst_Time_Deposit         ="x",@First_Time_Deposit         ,First_Time_Deposit         )
       ,`Views`                       =IF(@XViews                      ="x",@Views                      ,Views                      )
       ,`Clicks`                      =IF(@XClicks                     ="x",@Clicks                     ,Clicks                     )
       ,`Signups`                     =IF(@XSignups                    ="x",@Signups                    ,Signups                    )
       ,`Deposits`                    =IF(@XDeposits                   ="x",@Deposits                   ,Deposits                   )
       ,`Depositing_Customers`        =IF(@XDepositing_Customers       ="x",@Depositing_Customers       ,Depositing_Customers       )
       ,`Active_Customers`            =IF(@XActive_Customers           ="x",@Active_Customers           ,Active_Customers           )
       ,`First_Time_Active_Customers` =IF(@XFirst_Time_Active_Customers="x",@First_Time_Active_Customers,First_Time_Active_Customers)
       ,`Turnover`                    =IF(@XTurnover                   ="x",@Turnover                   ,Turnover                   )
       ,`Net_Revenue`                 =IF(@XNet_Revenue                ="x",@Net_Revenue                ,Net_Revenue                )
   WHERE D.id=@DbD_id
   ;
END IF;

IF @Debug="YES" THEN SELECT @xDbD_id,@xMS_id,@xis_active,@xdeal_to_apply,@xDate,@xProduct,@xQualified_Players;           END IF;
IF @Debug="YES" THEN SELECT @xFirst_Time_Deposit,@xViews,@xClicks,@xSignups,@xDeposits,@xDepositing_Customers; END IF;
IF @Debug="YES" THEN SELECT @xActive_Customers,@xFirst_Time_Active_Customers,@xTurnover,@xNet_Revenue;                   END IF;
IF @Debug="YES" THEN SELECT @MS_id,@DbD_id_INT,@is_active,@Date,@Product,@Qualified_Players,@First_Time_Deposit,@Views,@Clicks
                           ,@Signups,@Deposits,@Depositing_Customers,@Active_Customers,@First_Time_Active_Customers
                           ,@Turnover,@Net_Revenue; END IF;

END;
//
DELIMITER ;

/*
-- -----------------------------------------------------
Ejemplos:

CALL Set_record_dbd_manual ('is_active=2,deal_to_apply=1,Clicks=-120
 , Date=2026-01-15
 , Deposits=-25, First_Time_Deposit=-2, MS_id=5729
 , Net_Revenue=-20, Qualified_Players=-2, Signups=-2
 ,debug=yes');

TRUNCATE TABLE Snapshot_day_by_day_manual;
-- add Rec 1 a 3
CALL Set_record_dbd_manual ('is_active=1,deal_to_apply=0,MS_id=568,date=2023-02-01,Product=Sport ,Country=CO,Qualified_Players=1,Net_Revenue=1121.10,debug=yes');
CALL Set_record_dbd_manual ('is_active=1,deal_to_apply=1,MS_id=568,date=2023-02-02,Product=Sport ,Country=MX,Qualified_Players=2,Net_Revenue=2221.20,debug=yes');
CALL Set_record_dbd_manual ('is_active=1,deal_to_apply=2,MS_id=568,date=2023-02-03,Product=Sport ,Country=AR,Qualified_Players=3,Net_Revenue=3321.30,debug=yes');
-- add Rec 4 a 6                                                                                 
CALL Set_record_dbd_manual ('is_active=0,deal_to_apply=0,MS_id=568,date=2023-02-04,Product=Sport ,Country=ES,Qualified_Players=4,Net_Revenue=4421.40,debug=yes');
CALL Set_record_dbd_manual ('is_active=0,deal_to_apply=1,MS_id=568,date=2023-02-05,Product=Sport ,Country=IT,Qualified_Players=5,Net_Revenue=5521.50,debug=yes');
CALL Set_record_dbd_manual ('is_active=0,deal_to_apply=2,MS_id=568,date=2023-02-06,Product=Sport ,Country=US,Qualified_Players=6,Net_Revenue=6621.60,debug=yes');
-- add Rec 7 a 9                                                                                 
CALL Set_record_dbd_manual ('is_active=0,deal_to_apply=0,MS_id=568,date=2023-02-04,Product=Sport ,Country=ES,Qualified_Players=4,Net_Revenue=4421.40,debug=yes');
CALL Set_record_dbd_manual ('is_active=0,deal_to_apply=1,MS_id=568,date=2023-02-05,Product=Sport ,Country=IT,Qualified_Players=5,Net_Revenue=5521.50,debug=yes');
CALL Set_record_dbd_manual ('is_active=0,deal_to_apply=2,MS_id=568,date=2023-02-06,Product=Sport ,Country=US,Qualified_Players=6,Net_Revenue=6621.60,debug=yes');
-- edit Rec 7 a 9
CALL Set_record_dbd_manual ('dbd_id=7,is_active=0,deal_to_apply=0,MS_id=568 ,date=2023-02-14 ,Product=Sport,Country=ES,Qualified_Players=1,Net_Revenue=0421.40,debug=yes');
CALL Set_record_dbd_manual ('dbd_id=8,is_active=0,deal_to_apply=1,MS_id=568 ,date=2023-02-15 ,Product=Sport,Country=IT,Qualified_Players=1,Net_Revenue=0521.50,debug=yes');
CALL Set_record_dbd_manual ('dbd_id=9,is_active=0,deal_to_apply=2,MS_id=568 ,date=2023-02-16 ,Product=Sport,Country=US,Qualified_Players=1,Net_Revenue=0621.60,debug=yes');
-- edit Rec 7 a 9 solo cambia is_active
CALL Set_record_dbd_manual ('dbd_id=7,is_active=1,debug=yes');
CALL Set_record_dbd_manual ('dbd_id=8,is_active=1,debug=yes');
CALL Set_record_dbd_manual ('dbd_id=9,is_active=1,debug=yes');

CALL Set_record_dbd_manual ('MS_id=569, date=2023-01-24 ,Product=Sport, Country=MX, Qualified_Players=2, Net_Revenue=521.50, is_active=1, First_Time_Deposit=0, Views=0,Clicks=0, Signups=0');

-- -----------------------------------------------------
