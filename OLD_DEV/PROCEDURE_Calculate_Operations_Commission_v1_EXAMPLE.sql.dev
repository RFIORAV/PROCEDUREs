-- ============================================================================
-- 2. EJEMPLOS DE USO DEL PROCEDIMIENTO BÁSICO
-- ============================================================================

-- Ejemplo 1: Cálculo para todo el período de enero 2025
SELECT 'EJEMPLO 1: Cálculo completo enero 2025' AS ejemplo;
call Calculate_Operations_Commission('2025-01-01', '2025-01-31', NULL, NULL);

-- Ejemplo 2: Cálculo solo para Sport
SELECT 'EJEMPLO 2: Cálculo solo para Sport' AS ejemplo;
call Calculate_Operations_Commission('2025-01-01', '2025-01-31', NULL, 'Sport');

-- Ejemplo 3: Cálculo para un tracker específico
SELECT 'EJEMPLO 3: Cálculo para tracker 3' AS ejemplo;
call Calculate_Operations_Commission('2025-01-01', '2025-01-31', 3, NULL);

-- ============================================================================
-- 3. EJEMPLOS DE USO DEL PROCEDIMIENTO AVANZADO
-- ============================================================================

-- Ejemplo 4: Cálculo con salida resumida
SELECT 'EJEMPLO 4: Cálculo con salida resumida' AS ejemplo;
call Calculate_Operations_Commission_Advanced('start_date=2025-01-01,end_date=2025-01-31,output_type=summary');

-- Ejemplo 5: Cálculo con salida detallada
SELECT 'EJEMPLO 5: Cálculo con salida detallada' AS ejemplo;
call Calculate_Operations_Commission_Advanced('start_date=2025-01-01,end_date=2025-01-31,output_type=detail');

-- Ejemplo 6: Cálculo con debug y guardado de resultados
SELECT 'EJEMPLO 6: Cálculo con debug y guardado' AS ejemplo;
call Calculate_Operations_Commission_Advanced('start_date=2025-01-01,end_date=2025-01-31,output_type=debug,save_results=yes');

-- Ejemplo 7: Cálculo filtrado por tracker y producto
SELECT 'EJEMPLO 7: Cálculo filtrado tracker 2, Casino' AS ejemplo;
call Calculate_Operations_Commission_Advanced('start_date=2025-01-01,end_date=2025-01-31,tracker_id=2,product=Casino,output_type=detail');

-- ============================================================================
-- 4. CONSULTAS DE ANÁLISIS ADICIONALES
-- ============================================================================

-- Análisis de los datos de prueba
SELECT 'ANÁLISIS DE DATOS DE PRUEBA' AS titulo;

-- Resumen de movimientos por producto
SELECT 
    'RESUMEN DE MOVIMIENTOS POR PRODUCTO' AS tipo_analisis,
    product,
    COUNT(*) AS total_movimientos,
    SUM(deposits) AS total_deposits,
    AVG(deposits) AS promedio_deposits,
    MIN(deposits) AS minimo_deposits,
    MAX(deposits) AS maximo_deposits
FROM DBD_movements
WHERE date BETWEEN '2025-01-01' AND '2025-01-31'
GROUP BY product
ORDER BY total_deposits DESC;

-- Resumen de movimientos por tracker
SELECT 
    'RESUMEN DE MOVIMIENTOS POR TRACKER' AS tipo_analisis,
    tracker_id,
    product,
    COUNT(*) AS total_movimientos,
    SUM(deposits) AS total_deposits,
    AVG(deposits) AS promedio_deposits
FROM DBD_movements
WHERE date BETWEEN '2025-01-01' AND '2025-01-31'
GROUP BY tracker_id, product
ORDER BY tracker_id, total_deposits DESC;

-- Análisis de deals disponibles
SELECT 
    'DEALS DISPONIBLES' AS tipo_analisis,
    product,
    criteria,
    threshold,
    level,
    cpa,
    CASE 
        WHEN product = '' THEN 'Cualquier producto'
        ELSE product
    END AS producto_descripcion
FROM deals
ORDER BY product, threshold;

-- Simulación de cálculo manual para verificar lógica
SELECT 
    'SIMULACIÓN MANUAL - TRACKER 1 SPORT' AS tipo_analisis,
    m.tracker_id,
    m.product,
    SUM(m.deposits) AS total_deposits,
    d.level AS nivel_alcanzado,
    d.cpa AS comision_cpa,
    d.threshold AS threshold_deal
FROM DBD_movements m
LEFT JOIN deals d ON (
    (d.product = m.product OR d.product = '')
    AND SUM(m.deposits) >= d.threshold
    AND d.criteria = 'Deposits'
)
WHERE m.date BETWEEN '2025-01-01' AND '2025-01-31'
  AND m.tracker_id = 1
  AND m.product = 'Sport'
GROUP BY m.tracker_id, m.product, d.id
HAVING d.id IS NOT NULL
ORDER BY d.threshold DESC
LIMIT 1;

-- ============================================================================
-- 5. CONSULTAS PARA VERIFICAR RESULTADOS GUARDADOS
-- ============================================================================

-- Verificar si se guardaron resultados en la tabla permanente
SELECT 
    'RESULTADOS GUARDADOS EN TABLA PERMANENTE' AS tipo_analisis,
    COUNT(*) AS total_registros_guardados
FROM operations_commission_history
WHERE start_date = '2025-01-01' AND end_date = '2025-01-31';

-- Mostrar resultados guardados si existen
SELECT 
    'DETALLE DE RESULTADOS GUARDADOS' AS tipo_analisis,
    tracker_id,
    product,
    total_criteria_value,
    level_achieved,
    commission_cpa,
    criteria_used,
    currency,
    calculation_date
FROM operations_commission_history
WHERE start_date = '2025-01-01' AND end_date = '2025-01-31'
ORDER BY tracker_id, product;

