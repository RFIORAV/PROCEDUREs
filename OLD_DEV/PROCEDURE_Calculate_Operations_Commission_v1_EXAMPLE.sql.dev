/*
EXAMPLE_Operations_Commission_Usage.sql - Ejemplo de uso de los procedimientos de cálculo de comisiones

Este script muestra cómo usar los procedimientos de cálculo de comisiones de operaciones
incluyendo ejemplos de datos de prueba y diferentes escenarios de uso.

Contenido:
1. Creación de datos de prueba para las tablas DBD_movements y Deals
2. Ejemplos de uso del procedimiento básico
3. Ejemplos de uso del procedimiento avanzado
4. Consultas de análisis adicionales

*/

-- ============================================================================
-- 1. CREACIÓN DE DATOS DE PRUEBA
-- ============================================================================

-- Crear tabla de movimientos de prueba si no existe
CREATE TABLE IF NOT EXISTS DBD_movements (
    id INT AUTO_INCREMENT PRIMARY KEY,
    date DATE NOT NULL,
    tracker_id INT NOT NULL,
    product VARCHAR(80) NOT NULL,
    deposits DECIMAL(15,2) NOT NULL DEFAULT 0,
    INDEX idx_date (date),
    INDEX idx_tracker_product (tracker_id, product)
) ENGINE=InnoDB;

-- Crear tabla de deals de prueba si no existe
CREATE TABLE IF NOT EXISTS deals (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product VARCHAR(80) NULL,
    criteria VARCHAR(50) NOT NULL,
    threshold DECIMAL(15,2) NOT NULL,
    level VARCHAR(50) NOT NULL,
    cpa DECIMAL(12,2) NOT NULL,
    INDEX idx_product_criteria (product, criteria),
    INDEX idx_threshold (threshold)
) ENGINE=InnoDB;

-- Limpiar datos existentes
TRUNCATE TABLE DBD_movements;
TRUNCATE TABLE deals;

-- Insertar datos de prueba en la tabla deals
INSERT INTO deals (product, criteria, threshold, level, cpa) VALUES
-- Deals para Sport
('Sport', 'Deposits', 50, 'Bronze', 25),
('Sport', 'Deposits', 100, 'Silver', 45),
('Sport', 'Deposits', 200, 'Gold', 80),
