/* PROCEDURE_Compare_Fact1_Fact2.sql - Check data: Main Table Vs Main Aff Table (Fact1/Fact2)


Descripción:
  Procedimiento Compare_Fact1_Fact2.
Observaciones:

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguidO por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.

Keys:
InputCommLine = [valor]. Parámetro de entrada.

Month           =[AAAA-MM]. OPCIONAL. Default=Current Month.
MS_id           =[ALL | id de la MS]. OPCIONAL. Default=ALL. tiene prioridad sobre el resto de parámetros, excepto la fecha
Area            =[ALL | gaming / forex]. OPCIONAL. Default=ALL
Month           =[AAAA-MM]. OPCIONAL. Default=Current Month.
Affiliate_id    =[ALL | id del Affiliate]. OPCIONAL. Default=ALL
Brand           =[ALL | Name del Brand]. OPCIONAL. Default=ALL
Filters         =[Yes | No]. Devuelve la lista de filtros. OPCIONAL. Default=no.
Meta            =[No | Yes]. OPCIONAL. Columna 1 como METADATO: total/data/setting. Default [yes]
Debug           =[No | Yes | KeyValues]. OPCIONAL. Default=No
                  [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query.

Parámetros ('[Key=Value[,...]'])

19.03.2024 V1

Ejemplos:

call Compare_Fact1_Fact2('month=LM,FILTERS=yes,debug=YE');
call Compare_Fact1_Fact2('month=2024-01,Brand=Sisal,debug=ye');

*/

DROP PROCEDURE IF EXISTS Compare_Fact1_Fact2;

DELIMITER $$

CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Compare_Fact1_Fact2`(IN
   InputCommLine    VARCHAR(250)
   )
COMMENT 'Procedimiento Compare_Fact1_Fact2.'
   LANGUAGE SQL
   COMMENT 'Check data: Main Table Vs Main Aff Table (Fact1/Fact2)'

proc_label:BEGIN

SET @Version='v1 19.03.2024';

SET @Month           =LEFT(CURDATE(),7);
SET @MS_id           ='ALL';
SET @Area            ='ALL';
SET @Owner           ='ALL';
SET @Brand           ='ALL';
SET @Affiliate_id    ='ALL';
SET @Meta            ="YES";
SET @Filters         ='NO';
SET @Debug           ='NO';

-- --------------------------------------------------------------------
SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
--  @InputCommLine=replace(@InputCommLine,' ','');  -- Elimina espacios
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

IF @Debug!="NO" THEN SELECT @InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit,Product=Sport!-!Footbol,Filter=yes
-- @InputCommLine: ----5----0----5----0----5----0----5----0----5----0----5----0----5----0----5----0
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);

   IF lower(@k)='month'           THEN SET @Month         =UPPER(@v); END IF;
   IF lower(@k)='ms_id'           THEN SET @MS_id         =UPPER(@v); END IF;
   IF lower(@k)='area'            THEN SET @Area          =lower(@v); END IF;
   IF lower(@k)='owner'           THEN SET @Owner         =UPPER(@v); END IF;
   IF lower(@k)='advertiser_id'   THEN SET @Advertiser_id =UPPER(@v); END IF;
   IF lower(@k)='brand'           THEN SET @Brand         =UPPER(@v); END IF;
   IF lower(@k)='affiliate_id'    THEN SET @Affiliate_id  =UPPER(@v); END IF;

   IF lower(@k)='Filters'         THEN SET @Filters       =UPPER(@v); END IF;
   IF lower(@k)='debug'           THEN SET @Debug         =UPPER(@v); END IF;
   IF lower(@k)='meta'            THEN SET @Meta          =UPPER(@v); END IF;

END WHILE;

IF  @Month = "CM" THEN SET @Month=LEFT(CURDATE(),7); END IF;
IF  @Month = "LM" THEN SET @Month=LEFT(DATE_SUB(CURDATE(), INTERVAL 1 MONTH),7); END IF;

IF @Debug!="NO" THEN SELECT @Month,@View,@Filters,@OWNER,@OnlyOverCap,@Brand_Group,@Publisher_id
                           ,@Brand,@Affiliate_id,@Account_id,@Account,@Channel_id,@Product
                           ,@Platform,@Currency,@Total,@Debug,@Meta,InputCommLine; END IF;

SET @WhereMS_id='';
SET @WhereOwner='';
SET @WhereArea='';
SET @WhereBrand ='';
SET @WhereAffiliate_id  ='';

SET @COMILLA="'";

IF @MS_id             !="ALL" THEN SET @WhereMS_id           =CONCAT(" AND D.MS_id=",@MS_id);                               END IF;
IF @Owner             !="ALL" THEN SET @WhereOwner           =CONCAT(" AND D.Owner=",@Owner);                               END IF;
IF @Area              !="ALL" THEN SET @WhereArea            =CONCAT(" AND D.Area='",@Area,"'");                            END IF;
IF @Brand             !="ALL" THEN SET @WhereBrand           =CONCAT(" AND IFNULL(D.Brand        ,'')='",@Brand,"'");       END IF;
IF @Affiliate_id      !="ALL" THEN SET @WhereAffiliate_id    =CONCAT(" AND IFNULL(D.Affiliate_id ,'')=",@Affiliate_id  );   END IF;

-- ----------------------------------------------------------------------------------------------------
SET SESSION group_concat_max_len = 200000;

SET @CTE=CONCAT('
WITH DbD_fact1 as (
SELECT
	 `Owner`
	,LEFT(DATE,7) `Date`
	,`Brand`
	,`Username`
	,`Username_id`
	,`Affiliate`
	,`Affiliate_id`
	,SUM(`Qualified_Players_Adjusted`)        AS `CPA` -- 07.08.2023
	,SUM(IF(Deal_Aff_RS>0,`Net_Revenue`,0))   AS `NR`
	,`Tracker_Name`,`Tracker_ID`
   ,ifnull(MS_id,0) AS MS_id
   ,Deal_Aff_id
   ,Count(*) as `K`
FROM
	`Snapshot_day_by_day_fact1` D
WHERE Affiliate!="_Unassigned" AND LEFT(DATE,7)="',@Month,'"
'
   ,@WhereMS_id
   ,@WhereOwner
   ,@WhereArea
   ,@WhereBrand
   ,@WhereAffiliate_id
,'
GROUP BY ifnull(MS_id,0)'
   ,IF(@Filters="YES",",Brand,Affiliate_id",""),
'),

DbD_fact2 as (
SELECT
	 `Owner`
	,LEFT(DATE,7) `Date`
	,`Brand`
	,`Username`
	,`Username_id`
	,`Affiliate`
	,`Affiliate_id`
	,SUM(`Qualified_Players`)                 AS `CPA`
	,SUM(IF(Deal_Aff_RS>0,`Net_Revenue`,0))   AS `NR`
	,`Tracker_Name`,`Tracker_ID`
   ,ifnull(MS_id,0) AS MS_id
   ,Deal_Aff_id
   ,Count(*) as `K`
FROM
	`Snapshot_day_by_day_fact2` D
WHERE Affiliate!="_Unassigned" AND LEFT(DATE,7)="',@Month,'"
'
   ,@WhereMS_id
   ,@WhereOwner
   ,@WhereArea
   ,@WhereBrand
   ,@WhereAffiliate_id
,'
GROUP BY ifnull(MS_id,0)',
--    ,IF(@Filters="YES",",Brand,Affiliate_id",""),
'),

DIFF_Fact1_vs_Fact2 as (
SELECT "data" as Meta,
	 CASE WHEN IFNULL(F2.CPA,0)>IFNULL(F1.CPA,0) THEN "CPAs in Excess in Affiliate"
         WHEN IFNULL(F1.CPA,0)>IFNULL(F2.CPA,0) THEN "CPAs Missing in Affiliate"
         WHEN IFNULL(F2.NR ,0)>IFNULL(F1.NR ,0) THEN "Update Net Rev"
         WHEN IFNULL(F1.NR ,0)>IFNULL(F2.NR ,0) THEN "Update Net Rev"
         END AS Result
	,F1.`Owner`,left(F1.DATE,7) AS Month,F1.Brand,F1.Affiliate,F1.Affiliate_id
	,F1.Tracker_Name,F1.Tracker_ID
   ,F1.MS_id
	,IFNULL(F2.CPA,0)                   AS `CPA in F2`
   ,IFNULL(F1.CPA,0)                   AS `CPA in F1`
	,IFNULL(F2.CPA,0)-IFNULL(F1.CPA,0)  AS `CPA DIFF`
	,IFNULL(F2.NR ,0)-IFNULL(F1.NR ,0)  AS `NR DIFF`
	,round(IFNULL(F2.NR,0),2)           AS `NR in F2`
   ,round(IFNULL(F1.NR,0),2)           AS `NR in F1`
   ,CASE WHEN F1.MS_id=0 THEN "" ELSE
       CASE WHEN IFNULL(F2.CPA,0)<>IFNULL(F1.CPA,0) OR (
                 IFNULL(F2.CPA,0)= IFNULL(F1.CPA,0) AND
                 IFNULL(F2.NR ,0)<>IFNULL(F1.NR ,0))
            THEN CONCAT("Sync_MS_Fact1_Fact2_lm(",@COMILLA,"ms_id=",F1.MS_id,@COMILLA,")")
            ELSE "" END
         END as "CALL TO SYNC this MS"
FROM DbD_fact1 F1
LEFT JOIN DbD_fact2 F2 ON IFNULL(F1.MS_id,0)=IFNULL(F2.MS_id,0)
WHERE F1.MS_id>0 AND (IFNULL(F1.CPA,0)!=IFNULL(F2.CPA,0) OR IFNULL(F1.NR,0)!=IFNULL(F2.NR,0))

UNION ALL  -- -------------------------------------------------------------- 

SELECT
   "data" as Meta,
	"DELETE CPA from Affiliate" AS Result
	,F2.`Owner`
   ,left(F2.DATE,7) AS Month
   ,F2.Brand
   ,F2.Affiliate,F2.Affiliate_id
	,F2.Tracker_Name
   ,F2.Tracker_ID
   ,F2.MS_id
	,IFNULL(F2.CPA,0)                   AS `CPA in F2`
   ,IFNULL(F1.CPA,0)                   AS `CPA in F1`
	,IFNULL(F2.CPA,0)-IFNULL(F1.CPA,0)  AS `CPA DIFF`
	,IFNULL(F2.NR ,0)-IFNULL(F1.NR ,0)  AS `NR DIFF`
	,round(IFNULL(F2.NR,0),2)           AS `NR in F2`
   ,round(IFNULL(F1.NR,0),2)           AS `NR in F1`
	,IF(F2.MS_id>0
                  ,CONCAT("Sync_MS_Fact1_Fact2_lm(",@COMILLA,"ms_id=",F2.MS_id,@COMILLA,")") -- 17.09.2023
                  ,"")
                  as "CALL TO SYNC this MS"
FROM DbD_fact2 F2
LEFT JOIN DbD_fact1 F1 ON IFNULL(F1.MS_id,0)=IFNULL(F2.MS_id,0)
WHERE F1.MS_id is null)
'
);

SET @SQL=CONCAT(
@CTE,
'
SELECT * FROM DIFF_Fact1_vs_Fact2
UNION ALL
(
SELECT
"setting" as Meta          -- "data" as Meta,
,"width=150px" as `1`      -- "DELETE CPA from Affiliate" AS Result
,"width=80px"  as `2`      -- ,F1.`Owner`
,"width=80px"  as `3`      -- ,left(F1.DATE,7) AS Month
,"width=100px" as `4`      -- ,F1.Brand
,"width=130px" as `5`      -- ,F1.Affiliate
,"omit=yes"    as `5a`     -- ,F1.Affiliate_id
,"Width=150px" as `6`      -- ,F1.Tracker_Name
,"width=100px" as `7`      -- ,F1.Tracker_ID
,"width=90px"  as `8`      -- ,F1.MS_id
,"width=90px"  as `9`      -- ,IFNULL(F2.CPA,0)                   AS `CPA in F2`
,"width=90px"  as `10`     -- ,IFNULL(F1.CPA,0)                   AS `CPA in F1`
,"width=90px"  as `11`     -- ,IFNULL(F2.CPA,0)-IFNULL(F1.CPA,0)  AS `CPA DIFF`
,"width=90px"  as `12`     -- ,IFNULL(F2.NR ,0)-IFNULL(F1.NR ,0)  AS `NR DIFF`
,"width=90px"  as `13`     -- ,round(IFNULL(F2.NR,0),2)           AS `NR in F2`
,"width=90px"  as `14`     -- ,round(IFNULL(F1.NR,0),2)           AS `NR in F1`
-- ,"omit=yes"    as `16`     -- "grow=2,action=1" as "16" --
FROM DUAL WHERE @Meta="YES"
)
ORDER BY CASE WHEN `CPA DIFF`=0 THEN 0 ELSE 1 END DESC
	,CAST(`CPA DIFF` AS SIGNED) DESC
;');

SET @CTE_filter=REPLACE(@CTE,"WITH","");

SET @SQLfilters=CONCAT('
WITH RECURSIVE MonthFilter AS (
  SELECT  CURDATE() AS date
  UNION ALL
  SELECT DATE_SUB(date, INTERVAL 1 MONTH) FROM MonthFilter
  WHERE DATE_SUB(date, INTERVAL 1 MONTH) >= DATE_SUB(CURDATE(), INTERVAL 12 MONTH)
  		and DATE_SUB(date, INTERVAL 1 MONTH) >= "2022-01-01"
),'
,@CTE_filter,
'

(SELECT "01" as "Korder","Date" AS "Key",LEFT(`Date`,7) AS "Value"
                                       ,"Month" AS `CallKey`,LEFT(`Date`,7) AS `CallValue`
                                                                         ,"" AS "Rows" FROM MonthFilter)UNION ALL
-- (SELECT "02","Option"     ,"Group by MS","GroupByMS"    ,"yes"           ,"" AS "Rows" FROM DUAL) UNION ALL
(SELECT "13","Brand" 	  ,`Brand` 	    ,"Brand"        ,replace(Brand," ","!")     
                                                                         ,COUNT(*) AS K FROM DIFF_Fact1_vs_Fact2 WHERE `Brand` >" "      GROUP BY IFNULL(`Brand` ,""))      UNION ALL
(SELECT "19","Affiliate"  ,`Affiliate`  ,"Affiliate_id" ,`Affiliate_id`  ,COUNT(*) AS K FROM DIFF_Fact1_vs_Fact2 WHERE `Affiliate`  >" " GROUP BY IFNULL(`Affiliate`  ,"")) -- UNION ALL
-- ORDER BY 1,3
ORDER BY 1, case when `CallKey`="Month" then `CallValue` else "" end desc, 3
;'); 

IF @Debug!="NO" THEN SELECT @SQLfilters; END IF;
IF @Debug!="NO" THEN SELECT @SQL; END IF;

IF @Filters="YES" THEN SET @SQL=@SQLfilters; END IF;

IF @Debug != "YES" THEN
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;
END IF;

END$$
DELIMITER ;

/* -- TEST --------------
call Compare_Fact1_Fact2('month=LM,FILTERS=yes,debug=YE');
call Compare_Fact1_Fact2('month=2024-01,Brand=Sisal,debug=ye');

*/