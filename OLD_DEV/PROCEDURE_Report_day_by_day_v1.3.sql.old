/**
PROCEDURE_Report_day_by_day.sql

Observaciones:

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguidO por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.

Keys:

DbD             =[manual | gaming | forex]. OPCIONAL. Default=manual
Area            =[manual | gaming | forex]. OPCIONAL. Default=gaming
Month           =[AAAA-MM]. OPCIONAL. Default=Current Month.
is_active       =[ALL | 0 | 1]. OPCIONAL. Default=ALL
error           =[MS | No ]. OPCIONAL. Default=no. Sólo errores MS inexistente
Affiliate_id    =[ALL | id del Affiliate]. OPCIONAL. Default=ALL
Advertiser_id   =[ALL | id del Advertiser]. OPCIONAL. Default=ALL
Account_id      =[ALL | id del Adv_Account. OPCIONAL. Default=ALL
MS_id           =[ALL | id de la MS]. OPCIONAL. Default=ALL.
Filters         =[Yes | No]. Devuelve la lista de filtros. OPCIONAL. Default=no.
Meta            =[No | Yes]. OPCIONAL Default=[Yes] . Columna 1 como METADATO: total/data/setting.
Debug           =[No | Yes | KeyValues]. OPCIONAL. Default=No
                  [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query.

Parámetros ('[Key=Value[,...]'])

Ejemplos:

call Report_day_by_day(''); -- utiliza Snapshot_day_by_day_manual
call Report_day_by_day('dbd=forex'); -- utiliza forex_day_by_day_2
call Report_day_by_day('month=2023-01');
call Report_day_by_day('month=2023-02,filters=yes');
call Report_day_by_day('Account_id=79,month=2023-02');
call Report_day_by_day('Account_id=79,month=2023-02,filters=yes');

11.02.2023 V1
11.02.2023 V1     Limit a grid sin filtro
13.02.2023 V1.1   Select DbD to use
23.02.2023 v1.2   Karen - Agrega campo `id` para permitir la actualización
24.02.2023        rf - Muestra campo Status en la grid  
13.09.2023 v1.3   rf - Filtro por error MS inexistente

*/

DROP PROCEDURE IF EXISTS Report_day_by_day;
-- -------------------------------------------------------------
DELIMITER //

CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Report_day_by_day`(IN
   InputCommLine    VARCHAR(250)
   )
    COMMENT 'Report_day_by_day'

proc_label:BEGIN
-- --------------------------------------------------------------------------------------------
-- Defaults
SET @Version         ='v1.3 13.09.2023';
SET @CurrentDay      =curdate();
SET @Month           ='all';  -- LEFT(CURDATE(),7);
SET @DbD             ='manual';
SET @Error           ='';
SET @Area            ='ALL';
SET @is_active       ='ALL';
SET @MS_id           ='ALL';
SET @Advertiser_id   ='ALL';
SET @Account_id      ='ALL';
SET @Affiliate_id    ='ALL';
SET @Debug           ='NO';
SET @Meta            ='YES';
SET @Filters         ='NO';

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
-- SET @InputCommLine=replace(@InputCommLine,' ','');  -- Elimina espacios
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

IF @Debug!="NO" THEN SELECT @InputCommLine; END IF;
-- IF @Debug="YES" THEN SELECT @Owner,@Month,@Currency,@Advertiser_id,@ByAccount,@Debug,@Total,@TotLine,@OrderBy,@Order,@InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit,Product=Sport!-!Footbol,Filter=yes
-- @InputCommLine: ----5----0----5----0----5----0----5----0----5----0----5----0----5----0----5----0
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);

   IF lower(@k)='dbd'             THEN SET @DbD           =     (@v); END IF;
   IF lower(@k)='ms_id'           THEN SET @MS_id         =     (@v); END IF;
   IF lower(@k)='month'           THEN SET @Month         =     (@v); END IF;
   IF lower(@k)='meta'            THEN SET @Meta          =UPPER(@v); END IF;
   IF lower(@k)='error'           THEN SET @Error         =UPPER(@v); END IF;
   IF lower(@k)='filters'         THEN SET @Filters       =UPPER(@v); END IF;
   IF lower(@k)='debug'           THEN SET @Debug         =UPPER(@v); END IF;
   IF lower(@k)='area'            THEN SET @Area          =UPPER(@v); END IF;
   IF lower(@k)='is_active'       THEN SET @is_active     =     (@v); END IF;
   IF lower(@k)='affiliate_id'    THEN SET @Affiliate_id  =     (@v); END IF;
   IF lower(@k)='advertiser_id'   THEN SET @Advertiser_id =     (@v); END IF;
   IF lower(@k)='account_id'      THEN SET @Account_id    =     (@v); END IF;
   -- IF lower(@k)='view'            THEN SET @View          =UPPER(@v); END IF;
   -- IF lower(@k)='totline'         THEN SET @TotLine       =UPPER(@v); END IF;
   -- IF lower(@k)='total'           THEN SET @Total         =UPPER(@v); END IF;
   -- IF lower(@k)='status'          THEN SET @Status        =      @v;  END IF;
   -- IF lower(@k)='search'          THEN SET @Search        =     (@v); END IF;
   -- IF lower(@k)='publisher_id'    THEN SET @Publisher_id  =     (@v); END IF;
   -- IF lower(@k)='product'         THEN SET @Product       =      @v;  END IF;
   -- IF lower(@k)='platform'        THEN SET @Platform      =      @v;  END IF;
   -- IF lower(@k)='owner'           THEN SET @Owner         =UPPER(@v); END IF;
   -- IF lower(@k)='onlyovercap'     THEN SET @OnlyOverCap   =UPPER(@v); END IF;
   -- IF lower(@k)='mode'            THEN SET @Mode          =UPPER(@v); END IF;
   -- IF lower(@k)='groupbyms'       THEN SET @GroupByMS     =UPPER(@v); END IF;
   -- IF lower(@k)='dealbyproduct'   THEN SET @DealbyProduct =UPPER(@v); END IF;
   -- IF lower(@k)='currency'        THEN SET @Currency      =UPPER(@v); END IF;
   -- IF lower(@k)='channel_id'      THEN SET @Channel_id    =     (@v); END IF;

END WHILE;
-- ------------------------------------------------------------------------

IF @Debug!="NO" THEN SELECT @DbD,@Month,@View,@is_active,@Error,@Filters,@OWNER,@OnlyOverCap,@Brand_Group,@Advertiser_id,@Affiliate_id,@Account_id
,@Channel_id,@Product,@DealbyProduct,@Platform,@Currency,@Total,@Debug,@Meta,InputCommLine; END IF;

SET @TableToUse=(case when @DbD="forex"  then "forex_day_by_day_2" 
                      when @DbD="gaming" then "Snapshot_day_by_day" 
                      else "Snapshot_day_by_day_manual" end);
-- Sola la tabla manual tiene el campo is_active                      
IF  @TableToUse="Snapshot_day_by_day_manual"
THEN SET @UseIsActive="yes"; ELSE SET @UseIsActive="no"; END IF;

SET @WhereMS_id='';
SET @Whereis_active='';
SET @WhereMonth='';
SET @WhereOwner='';
SET @WhereAdvertiser_id ='';
SET @WhereAffiliate_id  ='';
SET @WhereAccount_id    ='';
SET @WhereChannel_id    ='';
SET @WhereProduct       ='';
SET @WhereStatus        ='';
SET @WhereError         ='';
SET @WhereSearch        ='';
SET @SQLlimit           ='LIMIT 500';

-- Limita grid a 500 líneas excepto que se aplique algún filtro que no sea @is_active
IF @MS_id!='ALL' OR @Affiliate_id!='ALL' OR @Account_id!='ALL' OR @Advertiser_id!='ALL'
THEN SET @SQLlimit=''; END IF;

IF @Month         !='ALL' THEN SET @WhereMonth        =CONCAT(' AND LEFT(D.Date,7)="',@Month,'" ');     END IF;
IF @MS_id         !='ALL' THEN SET @WhereMS_id        =CONCAT(' AND MS_id='          ,@MS_id);          END IF;
IF @Affiliate_id  !='ALL' THEN SET @WhereAffiliate_id =CONCAT(' AND `A`.`id`='       ,@Affiliate_id );  END IF;
IF @Account_id    !='ALL' THEN SET @WhereAccount_id   =CONCAT(' AND `D`.`Username`="',@Account_id,'"'); END IF;
IF @Advertiser_id !='ALL' THEN SET @WhereAdvertiser_id=CONCAT(' AND `AD`.`id`='      ,@Advertiser_id ); END IF;
IF @ERROR          ='MS'  THEN SET @WhereError        =CONCAT(' AND `M`.`id` is null ');                END IF;
IF @UseIsActive="yes" THEN
   IF @is_active  !='ALL' THEN SET @Whereis_active    =CONCAT(' AND D.is_active='    ,@is_active);      END IF;
END IF;


IF @Debug!="NO" THEN SELECT @WhereOwner,@WhereMonth,@Whereis_active,@WhereAdvertiser_id,@WhereAffiliate_id,@WhereAccount_id,@WhereChannel_id
                           ,@WhereProduct,@WhereStatus,@WhereMS_id,@WhereSearch; END IF;

SET @Count=0;

/**************************************************************************************************************/

SET SESSION group_concat_max_len = 200000;

-- ------------------------------------------------------------------------
SET @CTE=CONCAT('
Main_Table_Data as (
SELECT '
,IF(@UseIsActive="yes","D.is_active as `Status`,","-- "),
'   
   `D`.`id`                               AS `id`,
-- "gaming"                               as `Area`,
-- `CU`.`Owner` 			 	 	 				AS `Owner`,          -- 05.08.2022
   IFNULL(`A`.`username`, "_Unassigned") 	AS `Affiliate`,
   IFNULL(`A`.`id`, 1)                    AS `Affiliate_id`,
   IFNULL(`CDG`.`Deal_Name`,"")           AS `Deal`,
   IFNULL(`CDA`.`Deal_Name`,"")           AS `Deal_Aff`,
   `D`.`Hour_Update`                      AS `Hour_Update`,
   `D`.`Date`                             AS `Date`,
   `CU`.`Username`                        AS `Username`,
   `D`.`Username`                         AS `Username_id`,
-- `D`.`Portal`                           AS `Portal`,
   `AD`.`Advertiser_Name`                 AS `Brand`,          -- 30.10.2022
   `AD`.`id`                              AS `Advertiser_id`,
-- CU`.`Publisher_id`                     AS `Publisher_id`,   -- 21.01.2023
-- IFNULL(`AD`.`Brand_Group`,"")          AS `Brand_Group`,    -- 11.10.2022
-- IF(`AD`.`Brand_Group`>"",IFNULL(`AD`.`Brand_Group_Acum`,0),0) AS `Brand_Group_Acum`,  -- 28.10.2022
   IFNULL(`M`.`Tracker_ID`,`D`.`Tracker_ID`) AS `Tracker_ID`,     -- 26.10.2022 if ms=null Tracker_id de DbD
-- `D`.`Tracker_ID`                       AS `Tracker_ID_DbD`,
   `M`.`id`                               AS `MS_id`,
-- `D`.`Tracker_Name`                     AS `Tracker_Name`,                                     
-- `M`.`Code_To_Affiliate`                AS `Code_To_Affiliate`,                                
   IFNULL(`D`.`Product`, "")              AS `Product`,                                          
   IFNULL(`M`.`Product`, "")              AS `Product_Real`,                                     
   `D`.`Qualified_Players`                AS `Qualified_Players`,                                
                                                                                                 
   -- @CPA :=(CASE WHEN IFNULL(`D`.`Qualified_Players`,0)=0            -- 18.11.2022             
                 -- AND IFNULL(D.CPA_Value_Gestor,0)<>0                -- 18.11.2022             
                 -- AND IFNULL(`CDG`.`CPA_Value`,0)>0                  -- 18.11.2022             
                -- THEN ROUND(D.CPA_Value_Gestor/`CDG`.`CPA_Value`,0)  -- 18.11.2022             
                -- ELSE IFNULL(`D`.`Qualified_Players`,0) END)         -- 18.11.2022             
                                          -- AS `Qualified_Players`,   -- 18.11.2022             
                                                                                                 
-- `D`.`Qualified_Players_Adjusted`       AS `Qualified_Players_Adjusted`,                       
   `D`.`First_Time_Deposit`               AS `First_Time_Deposit`,                               
   `D`.`Views`                            AS `Views`,                                            
   `D`.`Clicks`                           AS `Clicks`,                                           
   `D`.`Signups`                          AS `Signups`,                                          
-- `D`.`Impressions`                      AS `Impressions`,                                      
-- `D`.`Sign_Up_Offer`                    AS `Sign_Up_Offer`,                                    
-- `D`.`Type`                             AS `Type`,                                             
-- `D`.`Language`                         AS `Language`,                                         
   `D`.`Country`,                                                                                
-- `D`.`Brand_Name`,                                                                             
-- `D`.`Registration_Date`                AS `Registration_Date`,                                
   `D`.`Deposits`                         AS `Deposits`,                                         
   `D`.`Depositing_Customers`             AS `Depositing_Customers`,                             
-- `D`.`Active_Customers`                 AS `Active_Customers`,                                 
-- `D`.`New_Depositing_Customers`         AS `New_Depositing_Customers`,
-- `D`.`New_Active_Customers`             AS `New_Active_Customers`,
   `D`.`First_Time_Active_Customers`      AS `First_Time_Active_Customers`,
-- `D`.`Turnover`                         AS `Turnover`,

   `D`.`Net_Revenue`,
   -- AS `NR_DbD`,CU.RSasNR,`CDG`.`RS_Percentage`,    -- para Debug -- 22.11.2022
   -- @NR :=(CASE WHEN CU.RSasNR=1 AND IFNULL(`CDG`.`RS_Percentage`,0)>0                 -- 22.11.2022
               -- THEN ROUND(`D`.`Net_Revenue` / `CDG`.`RS_Percentage` * 100,2)          -- 22.11.2022
          -- ELSE IFNULL(`D`.`Net_Revenue`, 0) END) as `Net_Revenue`,                    -- 22.11.2022

-- `M`.`Shortlink`                        AS `Shortlink`,
-- `M`.`CPA_Limit`                        AS `CPA_Limit`,
-- `lp`.`id`                              AS `Channel_id`,
-- `lp`.`landing_page_name`               AS `Channel`,
-- IFNULL(`A`.`first_level`, " ") 	      AS `Level_1`,
-- IFNULL(`A`.`second_level`, " ") 	      AS `Level_2`,
-- IFNULL(`A`.`third_level`, " ") 	      AS `Level_3`,
-- IFNULL(`A`.`fourth_level`, " ") 	      AS `Level_4`,
   ROUND(((`D`.`Net_Revenue` * IFNULL(`CDG`.`RS_Percentage`, 0)) / 100), 2) AS `Revenue_Share_Gestor`,
   ROUND(((`D`.`Net_Revenue` * IFNULL(`CDA`.`RS_Percentage`, 0)) / 100), 2) AS `Revenue_Share_Affiliate`,
   ROUND((`D`.`Qualified_Players` * IFNULL(`CDA`.`CPA_Value`, 0)), 0)       AS `CPA_Value_Affiliate`,    -- 18.11.2022
   ROUND((`D`.`Qualified_Players` * IFNULL(`CDG`.`CPA_Value`, 0)), 0)       AS `CPA_Value_Gestor`        -- 18.11.2022
-- IFNULL(`CDA`.`id`, 0) 				      AS `Deal_Aff_id`,
-- IFNULL(`CDA`.`CPA_Value`, 0) 		      AS `Deal_Aff_CPA`,
-- IFNULL(`CDA`.`Carry_Over`, 0) 	      AS `Deal_Aff_Carry_Over`,
-- IFNULL(`CDA`.`RS_Against_CPA`, 0)      AS `Deal_Aff_RS_Against_CPA`,
-- IFNULL(`CDA`.`RS_Base`, 0) 		      AS `Deal_Aff_RS_Base`,
-- IFNULL(`CDA`.`RS_Percentage`, 0)       AS `Deal_Aff_RS`,
-- IFNULL(`M1`.`Deal_Valid_From`, 0)      AS `Deal_Aff_Valid_From`,           -- 05.11.2022
-- IFNULL(`CDG`.`id`, 0) 				      AS `Deal_Ges_id`,
-- IFNULL(`CDG`.`CPA_Value`, 0) 		      AS `Deal_Ges_CPA`,
-- IFNULL(`CDG`.`Carry_Over`, 0) 	      AS `Deal_Ges_Carry_Over`,
-- IFNULL(`CDG`.`RS_Against_CPA`, 0)      AS `Deal_Ges_RS_Against_CPA`,
-- IFNULL(`CDG`.`RS_Base`, 0) 		      AS `Deal_Ges_RS_Base`,
-- IFNULL(`CDG`.`RS_Percentage`, 0)       AS `Deal_Ges_RS`,
-- IFNULL(`CDP`.`Valid_From`, 0) 	      AS `Deal_Ges_Valid_From`,           -- 05.11.2022
-- CU.Data_Currency,
-- CU.is_indirect,                                                            -- 28.11.2022
-- CU.Advertiser_indirect_id,                                                 -- 28.11.2022
-- left(NOW(),16) as "TimeGen"
FROM ',@TableToUse,' `D`
-- FROM `Snapshot_day_by_day` `D`
LEFT JOIN `campaign_username` `CU` ON (`CU`.`id` = `D`.`Username`)
-- LEFT JOIN `campaign_advertiser` `AD` ON (`AD`.`Advertiser_Name` = `D`.`Brand`)
LEFT JOIN `campaign_advertiser` `AD` ON (`AD`.`id` = `CU`.`Advertiser_id`)          -- 30.10.2022
		-- AND (`AD`.`Owner` = `D`.`Owner`)                                           -- 10.08.2022
-- ----------------------------Seleccion MS----------------------------------------------
LEFT JOIN LATERAL (                                                                        -- 02.12.2022
   SELECT                                                                                  -- 02.12.2022
      CASE  WHEN M.Tracker_ID = D.Tracker_ID and M.Tracker_Name = D.Tracker_Name then 4    -- 02.12.2022
            WHEN M.Tracker_ID = D.Tracker_ID then 3                                        -- 02.12.2022
            WHEN M.Tracker_Name = D.Tracker_Name then 2                                    -- 02.12.2022
            ELSE 1 END AS MatchValue                                                       -- 02.12.2022
      ,M.* FROM campaign_marketing_source M                                                -- 02.12.2022
   WHERE M.Username_id = D.Username AND                                                    -- 02.12.2022
		(D.Tracker_ID IN (M.Tracker_ID,M.Tracker_Name)                                       -- 02.12.2022
	OR  D.Tracker_Name IN (M.Tracker_ID,M.Tracker_Name))                                    -- 02.12.2022
	ORDER BY MatchValue DESC LIMIT 1                                                        -- 02.12.2022
	) AS M ON true                                                                          -- 02.12.2022
-- ----------------------------Seleccion de Affiliate------------------------------------
LEFT JOIN LATERAL (                                                                            -- 09.11.2022
	SELECT *,ROW_NUMBER() OVER(PARTITION BY MS_id ORDER BY Deal_Valid_From DESC) AS RowNr       -- 09.11.2022
	FROM `campaign_mkt_source_deal` WHERE `MS_id` = M.id AND `is_active` = 1                    -- 09.11.2022
                                     AND `Deal_Valid_From` <= `D`.`Date`                       -- 09.11.2022
	ORDER BY RowNr LIMIT 1                                                                      -- 09.11.2022
) AS M2 ON TRUE                                                                                -- 09.11.2022
-- ----------------------------Seleccion de producto-------------------------------------      -- 09.11.2022
LEFT JOIN LATERAL (                                                                            -- 09.11.2022
	SELECT * FROM (                                                                             -- 09.11.2022
      SELECT *,ROW_NUMBER() OVER(PARTITION BY Product ORDER BY Deal_Valid_From DESC) AS RowNr  -- 09.11.2022
      FROM `campaign_mkt_source_deal` WHERE `MS_id` = M.id AND Affiliate_id=M2.Affiliate_id    -- 09.11.2022
                                        AND `is_active` = 1                                    -- 09.11.2022
                                        AND `Deal_Valid_From` <= `D`.`Date`                    -- 09.11.2022
	) AS DbP                                                                                    -- 09.11.2022
	WHERE RowNr=1 AND IFNULL(DbP.`Product`,"") IN (IFNULL(D.Product, ""),""," ")                -- 09.11.2022
	ORDER BY DbP.`Product` DESC LIMIT 1	                                                        -- 09.11.2022
) AS M1 ON TRUE                                                                                -- 09.11.2022
-- --------------------------------------------------------------------------------------

LEFT JOIN `account_account` `A` ON `A`.`id` = `M2`.`Affiliate_id`
LEFT JOIN `campaign_deal_affiliate` `CDA` ON `CDA`.`id` = `M1`.`Deal_id`

LEFT JOIN LATERAL (                                                                       -- 09.11.2022
	SELECT * FROM (                                                                        -- 09.11.2022
      SELECT *,ROW_NUMBER() OVER(PARTITION BY Product ORDER BY Valid_From DESC) AS RowNr  -- 09.11.2022
      FROM `campaign_deal_gestor_prod_date`                                               -- 09.11.2022
      WHERE `Username_id` = `D`.`Username` AND `Advertiser_id` = `CU`.`Advertiser_id`     -- 09.11.2022
        AND `is_active` = 1  AND `Valid_From` <= `D`.`Date`                               -- 09.11.2022
	) AS DbP                                                                               -- 09.11.2022
	WHERE RowNr=1 AND IFNULL(DbP.`Product`,"") IN (IFNULL(D.Product, ""),""," ")           -- 09.11.2022
	ORDER BY DbP.`Product` DESC LIMIT 1	                                                   -- 09.11.2022
) AS CDP ON TRUE                                                                          -- 09.11.2022

LEFT JOIN `campaign_deal_gestor` `CDG` ON ((`CDG`.`id` = `CDP`.`Deal_id`))
LEFT JOIN `campaign_advertiser_status` `CS` ON ((`CS`.`id` = `AD`.`id`))
LEFT JOIN `account_landing_pages` `lp` ON ((`lp`.`id` = `M2`.`Channel_id`))

WHERE 1=1 '
   ,@WhereMonth
   ,@WhereAccount_id
   ,@Whereis_active
   ,@WhereError
   ,@WhereAdvertiser_id
   ,@WhereAffiliate_id
   ,@WhereMS_id
--
--    -- ,@WhereOwner
--    -- ,@WhereAdv_Account
--    -- ,@WhereChannel_id
--    -- ,@WhereProduct
--    -- ,@WherePlatform
--    -- ,@WhereBrand_Group
--    -- ,@WhereSearch
,')
,Main_Table_Data_Filter as (
SELECT COUNT(*) AS K,Brand,Advertiser_id,Username,Username_id,Affiliate,Affiliate_id
FROM Main_Table_Data MT
GROUP BY Advertiser_id,Username_id,Affiliate_id
)'
,'
,Main_Table_Data_Acum as (
SELECT
    sum(`Qualified_Players`)           as `CPA`
   ,sum(`First_Time_Deposit`)          as `FTD`
   ,sum(`Views`)                       as `Views`
   ,sum(`Clicks`)                      as `Clicks`
   ,sum(`Signups`)                     as `Signups`
   ,sum(`Deposits`)                    as `Deposits`
   ,sum(`Depositing_Customers`)        as `Dep_Customers`
   ,sum(`First_Time_Active_Customers`) as `FTA_Customers`
   ,sum(`Net_Revenue`)                 as `Net_Revenue`
   ,sum(`Revenue_Share_Gestor`)        as `RS_Network`
   ,sum(`Revenue_Share_Affiliate`)     as `RS_Affiliate`
   ,sum(`CPA_Value_Affiliate`)         as `CPA_Value_Affiliate`
   ,sum(`CPA_Value_Gestor`   )         as `CPA_Value_Network`
FROM Main_Table_Data MT
)'
);

SET @SQLdetail=CONCAT(
'
UNION ALL 
SELECT
   "data"                      Meta
	,"..."                     `Action` '
,IF(@UseIsActive="yes",",`Status`","-- "),   
'
   ,`Date`
   ,`Affiliate`
   ,`Affiliate_id`
   ,`Hour_Update`
   ,`Username`
   ,`Username_id`
   ,`Brand`        
   ,`Advertiser_id`
   ,`Tracker_ID`
   ,`MS_id`
   ,`Qualified_Players`
   ,`First_Time_Deposit`
   ,`Views`
   ,`Clicks`
   ,`Signups`
   ,`Country`
   ,`Deposits`
   ,`Depositing_Customers`
   ,`First_Time_Active_Customers`
   ,`Net_Revenue`
   ,`Product`          
   ,`Product_Real`     
   ,`Deal`
   ,`Deal_Aff`
   ,`Revenue_Share_Gestor`
   ,`Revenue_Share_Affiliate`
   ,`CPA_Value_Affiliate`   
   ,`CPA_Value_Gestor`        
	,`id`       
FROM Main_Table_Data MT -- limit 500
'
);

SET @SQLtotal=CONCAT(
'
UNION ALL 
SELECT
   "total"   `Meta`
	,"~~~~~"  `Action` 
',IF(@UseIsActive="yes",",'~~~~~'","-- "), 
'
  ,"~~~~~"  `Date`
   ,"~~~~~"  `Affiliate`
   ,"~~~~~"  `Affiliate id`
   ,"~~~~~"  `Hour Update`
   ,"~~~~~"  `Username`
   ,"~~~~~"  `Username id`
   ,"~~~~~"  `Brand`
   ,"~~~~~"  `Advertiser id`
   ,"~~~~~"  `Tracker ID`
   ,"~~~~~"  `MS id`
   ,         `CPA`
   ,         `FTD`
   ,         `Views`
   ,         `Clicks`
   ,         `Signups`
   ,"~~~~~"  `Country`
   ,         `Deposits`
   ,         `Dep_Customers`
   ,         `FTA_Customers`
   ,         `Net_Revenue`
   ,"~~~~~"  `Product`
   ,"~~~~~"  `Product MS`
   ,"~~~~~"  `Deal`
   ,"~~~~~"  `Deal Aff`
   ,         `RS_Network`
   ,         `RS_Affiliate`
   ,         `CPA_Value_Affiliate`
   ,         `CPA_Value_Network`
	,"~~~~~"  `id`                
FROM Main_Table_Data_Acum MT
'
);

SET @SQLmeta=CONCAT(
'(
SELECT
   "setting" as Meta
	,"width=080px,action=2" as `Action`
',IF(@UseIsActive="yes",",'width=80px' as`Status`","-- "), 
'
  ,"width=100px" as              `Date`
   ,"width=120px" as              `Affiliate`
   ,"omit=yes"    as              `Affiliate id`
   ,"omit=yes"    as              `Hour Update`
   ,"width=120px" as              `Account`
   ,"omit=yes"    as              `Username_id`
   ,"width=130px" as              `Brand`
   ,"omit=yes"    as              `Advertiser id`
   ,"width=140px" as              `Tracker ID`
   ,"width=080px" as              `MS id`
   ,"width=080px" as              `CPA`
   ,"width=080px" as              `FTD`
   ,"width=080px" as              `Views`
   ,"width=080px" as              `Clicks`
   ,"width=080px" as              `Sign ups`
   ,"width=080px" as              `Cntry`
   ,"width=100px" as              `Deposits`
   ,"width=080px" as              `Dep Custom`
   ,"width=080px" as              `FTA Custom`
   ,"width=100px" as              `Net Revenue`
   ,"width=100px" as              `Product`
   ,"width=100px" as              `Product MS`
   ,"width=300px" as              `Deal`
   ,"width=300px" as              `Deal Aff`
   ,"width=100px" as              `RS Network`
   ,"width=100px" as              `RS Affiliate`
   ,"width=100px" as              `CPA Value Affiliate`
   ,"width=100px" as              `CPA Value Network`
   ,"omit=yes"    as              `id`                                     
FROM DUAL WHERE @Meta="YES")
'
);

SET @SQL=CONCAT('WITH ',
@CTE,
@SQLmeta,
@SQLdetail,
@SQLtotal,
-- '
-- SELECT "data" as `Meta`
	-- ,"..." as `Action`
	-- ,MT.*
-- FROM Main_Table_Data MT
-- ',
'
ORDER BY Meta desc,Brand,Username_id,Date ',
@SQLlimit,'
;');

-- ------------------------------------------------------------
SET @SQLfilters=CONCAT('
WITH RECURSIVE MonthFilter AS (
  SELECT  CURDATE() AS date
  UNION ALL
  SELECT DATE_SUB(date, INTERVAL 1 MONTH) FROM MonthFilter
  WHERE DATE_SUB(date, INTERVAL 1 MONTH) >= DATE_SUB(CURDATE(), INTERVAL 5 MONTH)
),',
@CTE,
'
(SELECT "01" as "Korder","Date" AS "Key",LEFT(`Date`,7) AS "Value","Month" AS `CallKey`,LEFT(`Date`,7) AS `CallValue`,"" AS "Rows" FROM MonthFilter) UNION ALL
(SELECT "02","Status"   ,"All"      ,"is_active"      ,"all"           ,"" AS "Rows" FROM DUAL) UNION ALL
(SELECT "02","Status"   ,"Active"   ,"is_active"      ,"1"             ,"" AS "Rows" FROM DUAL) UNION ALL
(SELECT "02","Status"   ,"No Active","is_active"      ,"0"             ,"" AS "Rows" FROM DUAL) UNION ALL
(SELECT "03","Errors"   ,"No MSource","Error"         ,"MS"            ,"" AS "Rows" FROM DUAL) UNION ALL
(SELECT "05","Brand" 	,`Brand`    ,"Advertiser_id"  ,`Advertiser_id` ,SUM(K) AS K  FROM Main_Table_Data_Filter WHERE IFNULL(`Advertiser_id`,"")>"" GROUP BY IFNULL(`Advertiser_id` ,"")) UNION ALL
(SELECT "07","Account" 	,`Username` ,"Username_id"    ,`Username_id`   ,SUM(K) AS K  FROM Main_Table_Data_Filter WHERE IFNULL(`Username_id`,"")>"" GROUP BY IFNULL(`Username_id` ,"")) UNION ALL
(SELECT "09","Affiliate",`Affiliate`,"Affiliate_id"   ,`Affiliate_id`  ,SUM(K) AS K  FROM Main_Table_Data_Filter WHERE IFNULL(`Affiliate_id`,"")>"" GROUP BY IFNULL(`Affiliate_id` ,""))
-- ORDER BY 1, 3
ORDER BY 1, case when `CallKey`="Month" then `CallValue` else "" end desc, 3
;');

IF @Filters!="NO" THEN SET @SQL=@SQLfilters; END IF;

IF @Debug!="NO" THEN SELECT @CTE; END IF;
IF @Debug!="NO" THEN SELECT @SQLfilters; END IF;
IF @Debug!="NO" THEN SELECT @SQL; END IF;

IF @Debug != "YES" THEN
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;
END IF;

END//
DELIMITER ;

