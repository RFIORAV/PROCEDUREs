/*
PROCEDURE_Dash_Gestor_ProfitByAff.sql - Dashboard Gestor Profit by Affiliate

09.01.2023 V1
11.01.2023 v1.1	Cambio de cálculo a diferencia proporcional entre view_monthly_fact_aff3 y total_monthy_comm_ges
						La proporción es establece entre CPA y Net Revenue para la RS
08.03.2023        Agregada columna Average                  
17.03.2023        Nueva forma de calcular                  

*/
DROP PROCEDURE IF EXISTS Dash_Gestor_ProfitByAff;

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Dash_Gestor_ProfitByAff`(IN
   InputCommLine    VARCHAR(250)
   )
COMMENT 'Dashboard Gestor. PERFORMANCE - Profit by Affiliate'

BEGIN

-- Defaults
SET @Version      ='v1.2 17.03.2023';
SET @Debug        ='NO';
SET @Meta         ='YES';

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
-- SET @InputCommLine=replace(@InputCommLine,' ','');  -- Elimina espacios
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

-- IF @Debug="YES" THEN SELECT @Owner,@Month,@Currency,@Advertiser_id,@ByAccount,@Debug,@Total,@TotLine,@OrderBy,@Order,@InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit
-- @InputCommLine: ----5----0----5----0----5----0----5----0--
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);   

   IF lower(@k)='debug'         THEN SET @Debug        =UPPER(@v); END IF;
   IF lower(@k)='meta'          THEN SET @Meta         =UPPER(@v); END IF;

END WHILE;

SET @Days=DATEDIFF(curdate(),concat(Left(date_sub(curdate(),interval 11 month),7),"-01"));
-- SELECT @Days;
   
SET @SumBy_Month=concat(' 
    sum(Profit) as `Total`
   ,round(sum(Profit)/@Days*30.4,2) as `Monthly AVG`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  0 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  0 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  1 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  1 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  2 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  2 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  3 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  3 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  4 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  4 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  5 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  5 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  6 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  6 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  7 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  7 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  8 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  8 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval  9 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval  9 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval 10 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval 10 month),7),'`
   ,sum(case when `Month`=Left(date_sub(curdate(),interval 11 month),7) then Profit else 0 end) as `',left(date_sub(curdate(),interval 11 month),7),'`
');

SET @SQLmeta=concat(
' UNION ALL (
SELECT
   "setting"
   ,"width=150px" as Aff
   ,"width=80px,center=true" as Aff_id
   ,"width=100px,right=true,sortable=yes" Tot
   ,"width=100px,right=true,sortable=yes" AVG
   ,"width=100px,right=true,sortable=yes" M0
   ,"width=100px,right=true,sortable=yes" M1
   ,"width=100px,right=true,sortable=yes" M2
   ,"width=100px,right=true,sortable=yes" M3
   ,"width=100px,right=true,sortable=yes" M4
   ,"width=100px,right=true,sortable=yes" M5
   ,"width=100px,right=true,sortable=yes" M6
   ,"width=100px,right=true,sortable=yes" M7
   ,"width=100px,right=true,sortable=yes" M8
   ,"width=100px,right=true,sortable=yes" M9
   ,"width=100px,right=true,sortable=yes" M10
   ,"width=100px,right=true,sortable=yes" M11
	FROM DUAL WHERE @Meta="YES")'
);

SET @SQL=concat(' 
with grossCommByMonth_fact1 as (
SELECT left(DATE,7) AS Month,Brand,Advertiser_id,Data_Currency,Username_id,Affiliate_id,Affiliate
   ,sum(Qualified_Players      ) as `CPA`
   ,sum(CPA_Value_Gestor       ) as `CPA_Val_Ges`
   ,sum(CPA_Value_Affiliate    ) as `CPA_Val_Aff`
   ,sum(Net_Revenue            ) as `Net_Revenue`
   ,sum(case when Net_Revenue<0 then Net_Revenue
         else 0 end)             as `NR_Negative`
   ,sum(case when Net_Revenue>0 then Net_Revenue
         else 0 end)             as `NR_Positive`
   ,sum(Revenue_Share_Gestor   ) as `RS_Val_Ges`
   ,sum(Revenue_Share_Affiliate) as `RS_Val_Aff`
   ,sum(CPA_Value_Gestor-CPA_Value_Affiliate+Revenue_Share_Gestor-Revenue_Share_Affiliate)
                                 as `Profit`
FROM Snapshot_day_by_day_fact1
WHERE left(Date,7)>=left(date_sub(curdate(),interval 11 month),7) and Owner=2
GROUP BY MONTH,Affiliate,Brand
)
SELECT '
,IF(@Meta="YES","'data' as `Meta`,",""),
-- 'Affiliate,Affiliate_id as `Aff ID`,',
'Affiliate,sum(CPA) as `CPAs`,',
@SumBy_Month,'
FROM grossCommByMonth_fact1
GROUP BY Affiliate WITH ROLLUP
'
,IF(@Meta="YES",@SQLmeta,""),'
ORDER BY Affiliate
;');

-- select @SumBy_Month,@SQL;


IF @Debug!="NO" THEN SELECT @SQL; END IF;

IF @Debug!="YES" THEN
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;
END IF;

END$$
DELIMITER ;


/* TEST --------------

call Dash_Gestor_ProfitByAff('meta=yes,debug=ye');
call Dash_Gestor_ProfitByAff12('meta=ye,debug=ye');
*/