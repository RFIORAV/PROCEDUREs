),

DbD_Fact1_Account_monthly_join as (
      SELECT * FROM DbD_Fact1_Account_monthly_calc_NO_COver
      UNION ALL -- ----------------------------------
      SELECT * FROM DbD_Fact1_Account_monthly_calc_COver
)
-- Tests de queries parciales ------------------------------------------------------
-- SELECT * FROM DbD_Fact1_Account_monthly_CPA_minus_RS; 
-- SELECT * FROM DbD_Fact1_Account_monthly_CPA_minus_RS_acum;
-- SELECT * FROM DbD_Fact1_Account_monthly_calc_NO_COver;
-- SELECT * FROM DbD_Fact1_Account_monthly_calc_COver;
-- SELECT * FROM DbD_Fact1_Account_monthly_join;
-- ---------------------------------------------------------------------------------
SELECT
    CU.Owner
   ,CU.Area
   ,CU.`Data_Currency`
   ,"CPA+RS" as `Comm_type`
	,J.`Month`
   ,J.`Publisher`
   ,J.`Brand`
   ,J.`Username`
	,J.`Publisher_id`
	,J.`Advertiser_id`
	,J.`Username_id`
   ,sum(`CPA`                            )     as `CPA`
	,round(sum(`Net_Revenue`              ),2)  as `Net_Revenue`  
	,round(sum(`gross_CPA_Val`            ),2)  as `gross_CPA_Val`
	,round(sum(`gross_RS_Val`             ),2)  as `gross_RS_Val` 
   ,round(sum(`net_CPA_Val`              ),2)  as `net_CPA_Val`  
   ,round(sum(`net_RS_Val`               ),2)  as `net_RS_Val`   
   ,round(sum(`net_CPA_Val`+`net_RS_Val` ),2)  as `net_Total_comm`   
   ,round(sum(`Saldo_CO`                 ),2)  as `RS_CarryOver_Pend` 
	,max(`CarryOver`)                           as `CarryOver`
   ,J.`RS_Base`  
   ,J.`Product`    
FROM DbD_Fact1_Account_monthly_join J
LEFT JOIN `campaign_username` `CU` ON `CU`.`id` = `J`.`Username_id`
WHERE STR_TO_DATE(CONCAT(J.`Month`,'-01'), '%Y-%m-%d') >= @LMonthDate
GROUP BY `Username_id`,`Month`,`CarryOver`,`RS_Base`,J.`Product`
ORDER BY `Username_id`,`Month`,`CarryOver`,`RS_Base`,J.`Product`
;
/*-------- CALCULO DE BONUS/FEE -----------------------------------*/

INSERT IGNORE INTO `monthly_comms_gestor_v5` (
 `Owner`,`Username_id`,`Comm_type`,`Data_Currency`,`Month`,`net_Total_comm`,`Brand`
,`Username`,`Publisher_id`,`Publisher`)

WITH RECURSIVE date_series AS (
    SELECT 
      MIN(CONCAT(B.Month_Valid_From,"-01")) AS date_value    
    FROM campaign_deal_gestor_bonus B
    -- WHERE B.Month_Valid_to <= LEFT(CURDATE(),7)
    WHERE STR_TO_DATE(CONCAT(B.Month_Valid_to,'-01'), '%Y-%m-%d')
          BETWEEN @LMonthDate AND @CurrentMonthDate
    UNION ALL
    SELECT DATE_ADD(date_value, INTERVAL 1 MONTH)
    FROM date_series
    WHERE DATE_ADD(date_value, INTERVAL 1 MONTH)
         <= (SELECT STR_TO_DATE(CONCAT(MAX(Month_Valid_to),'-01'), '%Y-%m-%d')
             FROM campaign_deal_gestor_bonus 
             -- WHERE Month_Valid_to <= LEFT(CURDATE(),7))
             WHERE STR_TO_DATE(CONCAT(Month_Valid_to,'-01'), '%Y-%m-%d')
                   BETWEEN @LMonthDate AND @CurrentMonthDate)
)
  
SELECT 
       U.Owner                  `Owner`
      ,B.Username_id            `Username_id`
      ,B.Description            `Comm_type`
      ,U.`Data_Currency`        `Data_Currency`
      ,LEFT(ds.date_value,7) as `Month`
      ,B.Bonus_Value         as `net_Total_comm`
      ,A.Advertiser_Name        `Brand`
      ,U.username               `Username`
      ,B.`Publisher_id`         `Publisher_id`
      ,P.`Advertiser_Name`      `Publisher`
FROM campaign_deal_gestor_bonus B
JOIN date_series ds ON ds.date_value BETWEEN STR_TO_DATE(CONCAT(B.Month_Valid_From,'-01'), '%Y-%m-%d')
                                       AND STR_TO_DATE(CONCAT(B.Month_Valid_to,'-01'), '%Y-%m-%d')
LEFT JOIN campaign_publisher   P ON P.id=B.`Publisher_id`
LEFT JOIN campaign_username    U ON U.id=B.`Username_id`
LEFT JOIN campaign_advertiser  A ON A.id=U.`Advertiser_id`
WHERE STR_TO_DATE(CONCAT(B.Month_Valid_to,'-01'), '%Y-%m-%d') <= @CurrentMonthDate
;

END$$
DELIMITER ;

