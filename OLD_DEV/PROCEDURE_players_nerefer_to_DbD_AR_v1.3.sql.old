/**
	PROCEDURE_players_nerefer_to_DbD_AR_v1.sql

	**	Actualiza tabla Snapshot_day_by_day desde players_netrefer_API
	
   **	ADAPTADA PARA USO DE AFFILIATE REVOLUTION
   
	22.03.2025 v1     
	30.04.2025 v1.1   Agrega LeoVegas y Country  
   16.05.2025 v1.2   `Prodotto` IN ("Customer Account","Customer Account-20") PARA QUE SEA CPA
   16.05.2025 v1.3   Actualiza Dbd -  Conserva FTD, Clicks y Views
   
   call players_nerefer_to_DbD_AR('');
   call players_nerefer_to_DbD_AR('LM');   
   call players_nerefer_to_DbD_AR('2025-03');   
   
*/

DROP PROCEDURE IF EXISTS players_nerefer_to_DbD_AR;
-- DROP PROCEDURE IF EXISTS players_nerefer_to_DbD_AR_dev;
-- -------------------------------------------------------------
DELIMITER //

CREATE PROCEDURE players_nerefer_to_DbD_AR(IN Curr_Last_Month varchar(7))
COMMENT 'AR - Actualiza tabla Snapshot_day_by_day desde players_netrefer_API - Last Month y Cte / AAAA-MM'
DETERMINISTIC
MODIFIES SQL DATA
-- SQL SECURITY INVOKER
 
Proc_main:BEGIN

SET @Version ='v1.3 16.05.2025';
SET @DB      =database();    
SET @DateFrom=LEFT(CURDATE(),7);    -- Asume Curr Month por defecto

IF UPPER(Curr_Last_Month)='LM' THEN SET @DateFrom=LEFT(DATE_SUB(CURDATE(), INTERVAL 1 MONTH),7); END IF;

-- Cuando se pide reproceso general de todo, limita a MES de movimiento más antiguo DbD
SET @MinDateFromDbD=(SELECT MIN(LEFT(DATE,7)) FROM players_netrefer_API WHERE DATE IS NOT NULL);
IF    UPPER(Curr_Last_Month)='ALLALL' 
THEN  SET @DateFrom=@MinDateFromDbD;
END IF;

-- SELECT  Curr_Last_Month,@MinDateFromDbD,@DateFrom from dual;

-- Valida fecha
IF    LEFT(Curr_Last_Month,3)='202' 
THEN
      IF   SUBSTRING(Curr_Last_Month,6,2) IN ('01','02','03','04','05','06','07','08','09','10','11','12')
      THEN SET @DateFrom=LEFT(Curr_Last_Month,7);
      ELSE SELECT "Invalid Month parameter" from dual;
           LEAVE Proc_main; 
      END IF;
END IF;

-- Valida que se haya pedido un mes dentro del rango de datos de DbD
IF    @DateFrom < @MinDateFromDbD OR @DateFrom > LEFT(CURDATE(),7)
THEN  SELECT "Month out of range DbD data" from dual;
      LEAVE Proc_main; 
END IF;

-- ------------------ SOLAMENTE PARA affiliaterevolution -----------------------
-- USE affiliaterevolution;
-- -----------------------------------------------------------------------------

CREATE TABLE IF NOT EXISTS Snapshot_day_by_day_temp_NR LIKE Snapshot_day_by_day;

/***** LOOP POR Account_id *****/

Cycle_Username_id:BEGIN
    -- Declarar variables para el cursor
    DECLARE done INT DEFAULT FALSE;
    DECLARE current_username VARCHAR(255);
    
    -- Declarar cursor para recorrer todos los Username_id únicos
    DECLARE username_cursor CURSOR FOR 
        SELECT DISTINCT Username_id 
        FROM players_netrefer_API 
        WHERE (LEFT(DATE,7)=@DateFrom OR '1'=IF(UPPER(Curr_Last_Month)='ALLALL','1','0'));
    
    -- Declarar handler para cuando no hay más registros
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    -- Abrir cursor
    OPEN username_cursor;
    
    -- Iniciar ciclo
    username_loop: LOOP
        -- Obtener el siguiente Username_id
        FETCH username_cursor INTO current_username;
        
        -- Salir del ciclo si no hay más registros
        IF done THEN
            LEAVE username_loop;
        END IF;
        
        -- Paso 1: Eliminar datos del usuario actual en Snapshot_day_by_day_temp_NR
        DELETE FROM Snapshot_day_by_day_temp_NR 
        WHERE (LEFT(DATE,7)=@DateFrom OR '1'=IF(UPPER(Curr_Last_Month)='ALLALL','1','0'))
        AND Username = current_username;
        /*
        SELECT 
        `id`,`Owner`,`Affiliate`,`Campaign`,`Deal`,`Deal_Aff`,`Hour_Update`
        ,`Date`,`Username`,`Portal`,`Brand`,`Tracker_ID`,`Tracker_Name`,`Code_To_Affiliate`,`Product`
        ,`Product_Real`,`Qualified_Players`,`Qualified_Players_Adjusted`,`Criteria_Type`,`Level_Reached`
        ,`First_Time_Deposit`,`Views`,`Clicks`,`Signups`,`Impressions`
        ,`Sign_Up_Offer`,`Type`,`Language`,`Country`,`Brand_Name`,`Registration_Date`,`Deposits`,`Depositing_Customers`
        ,`Active_Customers`,`New_Depositing_Customers`,`New_Active_Customers`,`First_Time_Active_Customers`
        ,`Turnover`,`Net_Revenue`,`Revenue_Share_Gestor`,`Revenue_Share_Affiliate`,`CPA_Value_Affiliate`,`CPA_Value_Gestor` 
        FROM Snapshot_day_by_day
        */
        -- Paso 2: Insertar datos existentes del usuario actual en Snapshot_day_by_day
        INSERT INTO Snapshot_day_by_day_temp_NR 
              (`Date`,`Username`,`Portal`,`Brand`,`Tracker_ID`,`Tracker_Name`,`Product`
              ,`First_Time_Deposit`,`Views`,`Clicks`)
        SELECT `Date`,`Username`,`Portal`,`Brand`,`Tracker_ID`,`Tracker_Name`,`Product`
               ,SUM(`First_Time_Deposit`)
               ,SUM(`Views`             )
               ,SUM(`Clicks`            )
        FROM Snapshot_day_by_day 
        WHERE (LEFT(DATE,7)=@DateFrom OR '1'=IF(UPPER(Curr_Last_Month)='ALLALL','1','0'))
        AND Username = current_username
        GROUP BY `Username`,`Brand`,`Tracker_ID`,`Tracker_Name`
         HAVING SUM(`First_Time_Deposit`) >0
             OR SUM(`Views`             ) >0
             OR SUM(`Clicks`            ) >0
        ;
        
        -- Paso 3: Insertar nuevos datos del usuario actual
        INSERT IGNORE INTO Snapshot_day_by_day_temp_NR (
            `Date`
            ,`Hour_Update`
            ,`Brand`
            ,`Username`
            ,`Product`
            ,`Country`
            ,`Sign_Up_Offer`
            ,`Tracker_Name`
            ,`Tracker_ID`
            ,`Level_Reached`
            ,`Brand_Name`   
            ,`Signups`   
            ,`Qualified_Players`          
            ,`Deposits`             
            ,`Turnover`               
            ,`Net_Revenue`
            ,`First_Time_Deposit`
            ,`Views`             
            ,`Clicks`            
            
        )
        SELECT
            `Date`,
            `Hour_Update`,
            `Advertiser`,
            `Username_id`,
            CASE WHEN @DB="affiliaterevolution" AND `Advertiser`="Snai"
                      AND DATE_FORMAT(STR_TO_DATE(Signup_Date, "%d-%m-%Y"), "%Y-%m-%d")<"2024-12-01"
                 THEN CONCAT(`Prodotto`,"-20")
                 ELSE `Prodotto` END AS `Product`,
            IFNULL(UPPER(C.`alpha_2`),"") AS `Country`,
            `Reward_Plan`           as `Sign_Up_Offer`,
            `Marketing_Source_Name` as `Tracker_Name`,
            `Marketing_Source_ID`   as `Tracker_ID`,
            `Customer_Level`        as `Level_Reached`,
            `Brand`                 as `Brand_Name`,
            SUM(CASE WHEN Signup_Date>"" AND DATE_FORMAT(STR_TO_DATE(Signup_Date, "%d-%m-%Y"), "%Y-%m")=LEFT(`Date`,7)
                    THEN 1 ELSE 0 END) AS `Signups`,     
            SUM(CASE WHEN `Prodotto` IN ("Customer Account","Customer Account-20")
                      AND CPA_Processed_Date>"" 
                      AND DATE_FORMAT(STR_TO_DATE(CPA_Processed_Date, "%d-%m-%Y"), "%Y-%m")=LEFT(`Date`,7)
                    THEN 1 ELSE 0 END) AS `Qualified_Players`,     
            ROUND(SUM(`Deposits`          ),2) AS `Deposits`,
            ROUND(SUM(`Turnover`          ),2) AS `Turnover`,
            ROUND(SUM(`Total_Net_Revenue` ),2) AS `Net_Revenue` 
            ,0 as `First_Time_Deposit`
            ,0 as `Views`             
            ,0 as `Clicks`
        FROM players_netrefer_API p
        LEFT JOIN `util_countries` C ON C.`en`=p.`Country` 
        WHERE (LEFT(DATE,7)=@DateFrom OR '1'=IF(UPPER(Curr_Last_Month)='ALLALL','1','0'))
        AND Username_id = current_username
        GROUP BY 
            `Advertiser`,
            `Username_id`,
            `Date`,
            `Product`,
            `Reward_Plan`,
            `Marketing_Source_Name`,
            `Marketing_Source_ID`,
            `Brand`,
            `Country`
            ;
    
    END LOOP;
    
    -- Cerrar cursor
    CLOSE username_cursor;
    
END Cycle_Username_id;

/*************** UPDATE ONLY AFFILIATE REVOLUTION ********************************/

IF DATABASE()!="affiliaterevolution" THEN LEAVE Proc_main; END IF;

SET @Month=@DateFrom,@DB="affiliaterevolution", @Username1=124,@Username2=133;

-- DELETE FROM Snapshot_day_by_day_dev
DELETE FROM Snapshot_day_by_day
    WHERE LEFT(DATE,7)=@Month AND Database()=@DB AND `Username` IN (@Username1,@Username2)
      -- AND `Portal` IN ("SNAI deal adjust","players_netrefer_API")
;

-- INSERT IGNORE INTO Snapshot_day_by_day_dev (
INSERT IGNORE INTO Snapshot_day_by_day (
   `Portal`
   ,`Date`
   ,`Hour_Update`
   ,`Brand`
   ,`Username`
   ,`Product`
   ,`Country`
   ,`Sign_Up_Offer`
   ,`Tracker_Name`
   ,`Tracker_ID`
   ,`Level_Reached`
   ,`Brand_Name`   
   ,`Qualified_Players`          
   ,`Signups`   
   ,`Deposits`             
   ,`Net_Revenue`
   ,`Turnover` 
   ,`First_Time_Deposit`
   ,`Views`             
   ,`Clicks`  
)
SELECT
    "players_netrefer_API" AS `Portal`,
    `Date`,
     CURRENT_TIMESTAMP(),
    `Brand`,
    `Username`,
    CASE WHEN NR.`Product` LIKE "%-20" 
         THEN `Sign_Up_Offer` 
         ELSE NR.`Product` END as `Product`,
    `Country`,
    `Sign_Up_Offer`,
    `Tracker_Name`,
    `Tracker_ID`,
    `Level_Reached`,
    `Brand_Name`,
    SUM(`Qualified_Players`)  AS `Qualified_Players`,
    SUM(`Signups`)            AS `Signups`,
    SUM(`Deposits`)           AS `Deposits`,
    SUM(`Net_Revenue`)        AS `Net_Revenue`,
    SUM(`Turnover`)           AS `Turnover`
   ,SUM(`First_Time_Deposit`) as `First_Time_Deposit`
   ,SUM(`Views`             ) as `Views`             
   ,SUM(`Clicks`            ) as `Clicks`               
FROM Snapshot_day_by_day_temp_NR NR
WHERE LEFT(DATE,7)=@Month
  AND Database()=@DB AND  `Username` IN (@Username1,@Username2)
  -- AND NR.`Product` LIKE "%-20"
GROUP BY `Username`,`Tracker_ID`,`Tracker_Name`,NR.`Product`,`Sign_Up_Offer`,`Country`
;
END Proc_main;
//
DELIMITER ;

