/*
PROCEDURE_economics_by_affiliate_v1.2.sql - GENERACION DE RESUMEN ECONOMICS

Observaciones:

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguidO por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.

Keys:

Affiliate_id    =[ALL | id del Affiliate]. OBLIGATORIO. Default=''
Filters         =[Yes | No]. Devuelve la lista de filtros. OPCIONAL. Default=no.
OnlyBalance     =[Yes | No]. Sólo la línea de saldo final. OPCIONAL. Default=no.
Meta            =[No | Yes]. OPCIONAL. Columna 1 como METADATO: total/data/setting. Default [No]
Debug           =[No | Yes | KeyValues]. OPCIONAL. Default=No
                  [No] NO EJECUTA QUERY y devuelve el código del Query.
                  [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query.


Parámetros ('[Key=Value[,...]'])

Ejemplos:

call economics_by_affiliate(''); -- Devuelve todas las MS
call economics_by_affiliate('debug=yes,MS_ID=859,filters=no');

01.03.2022 v1.0   Mov "Accepted" el día 20
09.05.2022 v1.0   Optimización
02.09.2022 v1.0   Prueba y deploy
17.11.2022 v1.1   Refactoring
22.11.2022 v1.2   Parámetro OnlyBalance
11.01.2024 v1.3   view_monthly_fact_aff4
                  Tratamiento comisiones referral
04.08.2024 v1.4   Tratamiento Currency
                  Obtiene @Currency desde @GridCurrency en tabla util_settings
06.08.2024 v1.5   Reestructuración query con CTE para evitar warnings
                  Posible ejecución autónoma con filtros
09.08.2024 v1.6   Acumula comisiones del mes para poder mostrar en dashboard
10.09.2024 v1.6.1 Withdraw pending resta de Bal_Confirmed
02.11.2024 v1.7   Utiliza monthly_comms_affiliate_v5 en lugar de view_monthly_fact_aff4
                  Identifica comisiones de Referrer como "RFR"
*/
SET NAMES 'utf8mb4' COLLATE 'utf8mb4_0900_ai_ci';

-- -----------------------------------------------------
DROP PROCEDURE IF EXISTS economics_by_affiliate1_dev;
DROP PROCEDURE IF EXISTS economics_by_affiliate1;
-- -----------------------------------------------------

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `economics_by_affiliate1`(IN
   InputCommLine    VARCHAR(250)
   )
    COMMENT 'RESUMEN [Affiliate_id] de Comisiones, Pagos, Ajustes desde el inicio, en forma de cuadro contabilidad'

ProcedureBody: BEGIN
-- --------------------------------------------------------------------------------------------
-- Defaults
SET @Version         ='v1.7 02.11.2024';
SET @CurrentDay      =curdate();
SET @Affiliate_id    ='0';
SET @OnlyBalance     ='NO';
SET @Meta            ='YES';
SET @Month           =LEFT(CURDATE(),7);

SET @STATUS          ='ALL';
SET @Currency        ='EUR';
SET @Filters         ='NO';
SET @Debug           ='NO';

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
-- SET @InputCommLine=replace(@InputCommLine,' ','');  -- Elimina espacios
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

IF @Debug!="NO" THEN SELECT @InputCommLine; END IF;
-- IF @Debug="YES" THEN SELECT @Owner,@Month,@Currency,@Advertiser_id,@ByAccount,@Debug,@Total,@TotLine,@OrderBy,@Order,@InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit,Product=Sport!-!Footbol,Filter=yes
-- @InputCommLine: ----5----0----5----0----5----0----5----0----5----0----5----0----5----0----5----0
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   SET @k=TRIM(@k);
   SET @v=TRIM(@v);

   IF lower(@k)='affiliate_id'    THEN SET @Affiliate_id  =UPPER(@v); END IF;
   IF lower(@k)='OnlyBalance'     THEN SET @OnlyBalance   =UPPER(@v); END IF;
   IF lower(@k)='currency'        THEN SET @Currency      =UPPER(@v); END IF;
   IF lower(@k)='debug'           THEN SET @Debug         =UPPER(@v); END IF;
   IF lower(@k)='filters'         THEN SET @Filters       =UPPER(@v); END IF;
   IF lower(@k)='meta'            THEN SET @Meta          =UPPER(@v); END IF;
   IF lower(@k)='status'          THEN SET @Status        =      @v;  END IF;

END WHILE;

/**************************************************************************************************************/
               -- IF @Affiliate_id!="ALL" AND @Affiliate_id,0)<=0
               -- THEN SELECT "Affiliate_id obligatorio";
                    -- LEAVE ProcedureBody; END IF;
/**************************************************************************************************************/
IF @Affiliate_id="0" THEN SET @Affiliate_id="ALL"; END IF; -- ALL no muestra detalles en grid


-- Obtiene @MultiCurrency y @Currency desde tabla util_settings
SET @MultiCurrency=(SELECT IFNULL(`Value_01`,'NO')  FROM `util_settings` WHERE Setting='MultiCurrency');
SET @Currency=     (SELECT IFNULL(`Value_01`,'EUR') FROM `util_settings` WHERE Setting='GridCurrency');

SET @LMonth=left(DATE_SUB(CURDATE(), INTERVAL 1 MONTH),7);
SET @Date_confirm=CONCAT(LEFT(CURDATE(),7),"-20");

IF @Debug!="NO" THEN SELECT @Affiliate_id,@Date_confirm,@LMonth,@OnlyBalance,@MultiCurrency,@Currency,@Filters,@Meta; END IF;

SET @SQLmeta=concat(
'(
SELECT
   "setting"                   `Meta`
   ,"width=090px"              `Month`
   ,"width=100px"              `Date`
   ,"width=300px"              `Descr`
   ,"width=100px"              `Op`
   ,"width=100px"              `Operation Currency`
   ,"width=100px,right=true"   `Operation Value`
   ,IF(@MultiCurrency="YES","width=090px,right=true","omit=true") AS `Financial currency`
   ,IF(@MultiCurrency="YES","width=090px,right=true","omit=true") AS `Financial Value`
   ,"width=090px"              `Status`
   ,"width=100px,right=true"   `Estimated Balance`
   ,"width=100px,right=true"   `Confirmed Balance`
   ,"omit=true"                `Acum_Comm_CM`
   ,"omit=true"                `RowNum`
FROM DUAL
)
UNION ALL
'
);

SET @CTE=CONCAT(
'
WITH All_records AS (
SELECT Affiliate_id
	,(DATE_ADD(DATE_SUB(CONCAT(`Month`,"-01"), INTERVAL 1 DAY), INTERVAL 1 MONTH)) as `DATE`
	,"CPA" AS Op_type
   ,Currency AS Currency
   ,CONCAT_WS(" ",Brand,Product_Real,Channel,Sub_Affiliate) AS Description
   ,(net_CPA_Val) AS Amount
   ,getCurrencyConversion(net_CPA_Val,Currency,@Currency) AS Transact
	,CASE WHEN `Month`<@LMonth THEN "1"
         WHEN `Month`=@LMonth and CURDATE()>=@Date_confirm THEN "1"
         ELSE 0 END AS Status
	,CASE WHEN `Month`<@LMonth THEN "Confirmed"
         WHEN `Month`=@LMonth and CURDATE()>=@Date_confirm THEN "Confirmed"
         ELSE "Provisional" END AS StatusText
	,0 as balance_est,0 as balance_conf
FROM monthly_comms_affiliate_v5 F
WHERE ',IF(@Affiliate_id="ALL","1=1","F.Affiliate_id=@Affiliate_id"),' AND (net_CPA_Val)<>0 AND Sub_Affiliate_id=0

UNION ALL -- ----------------------------------------------------------------
SELECT Affiliate_id
	,(DATE_ADD(DATE_SUB(CONCAT(`Month`,"-01"), INTERVAL 1 DAY), INTERVAL 1 MONTH)) as `DATE`
	,"RShare" AS Op_type
   ,Currency AS Currency
   ,CONCAT_WS(" ",Brand,Product_Real,Channel,Sub_Affiliate) AS Description
   ,(net_RS_Val) AS Amount
   ,getCurrencyConversion(net_RS_Val,Currency,@Currency) AS Transact
	,CASE WHEN `Month`<@LMonth THEN "1"
         WHEN `Month`=@LMonth and CURDATE()>=@Date_confirm THEN "1"
         ELSE 0 END AS Status
	,CASE WHEN `Month`<@LMonth THEN "Confirmed"
         WHEN `Month`=@LMonth and CURDATE()>=@Date_confirm THEN "Confirmed"
         ELSE "Provisional" END AS StatusText
	,0 as balance_est,0 as balance_conf
FROM monthly_comms_affiliate_v5 F
WHERE ',IF(@Affiliate_id="ALL","1=1","F.Affiliate_id=@Affiliate_id"),' AND (net_RS_Val)<>0 AND Sub_Affiliate_id=0

UNION ALL -- ----------------------------------------------------------------
SELECT Affiliate_id
	,(DATE_ADD(DATE_SUB(CONCAT(`Month`,"-01"), INTERVAL 1 DAY), INTERVAL 1 MONTH)) as `DATE`
	,"RFR" AS Op_type
   ,Currency AS Currency
   ,CONCAT_WS(" ",Brand,Product_Real,Channel,Sub_Affiliate) AS Description
   ,(net_Total_comm) AS Amount
   ,getCurrencyConversion(net_Total_comm,Currency,@Currency) AS Transact
	,CASE WHEN `Month`<@LMonth THEN "1"
         WHEN `Month`=@LMonth and CURDATE()>=@Date_confirm THEN "1"
         ELSE 0 END AS Status
	,CASE WHEN `Month`<@LMonth THEN "Confirmed"
         WHEN `Month`=@LMonth and CURDATE()>=@Date_confirm THEN "Confirmed"
         ELSE "Provisional" END AS StatusText
	,0 as balance_est,0 as balance_conf
FROM monthly_comms_affiliate_v5 F
WHERE ',IF(@Affiliate_id="ALL","1=1","F.Affiliate_id=@Affiliate_id"),' AND (net_Total_comm)<>0 AND Sub_Affiliate_id!=0

UNION ALL -- ----------------------------------------------------------------
SELECT Affiliate_id,LEFT(Date,10) AS "Date"
   ,Op_type
   ,Currency
   ,Description
   ,Amount_Debit*-1 AS Amount
   ,getCurrencyConversion(Amount_Debit*-1,Currency,@Currency) AS Transact
   ,CASE WHEN IFNULL(Status,"0")="0" AND Op_type="WithDraw" THEN "1" ELSE IFNULL(Status,"0") END AS `Status`
	,CASE IFNULL(Status,"0")
		WHEN "0" THEN "Pending"
		WHEN "1" THEN "Accepted"
		WHEN "2" THEN "Paid"
		WHEN "3" THEN "Denied"
	 END AS StatusText
	,0 as balance_est, 0 as balance_conf
FROM account_financial_movement F
WHERE ',IF(@Affiliate_id="ALL","1=1","F.Affiliate_id=@Affiliate_id"),' AND ifnull(F.Status,0)<>3

UNION ALL -- ----------------------------------------------------------------
SELECT Affiliate_id,LEFT(Date,10) AS "Date"
   ,Op_type
   ,Currency
   ,Description
   ,Amount_Credit AS Amount
   ,getCurrencyConversion(Amount_Credit,Currency,@Currency) AS Transact
   ,IFNULL(Status,0) AS Status
	,CASE IFNULL(Status,0)
		WHEN 0 THEN "Pending"
		WHEN 1 THEN "Accepted"
		WHEN 2 THEN "Paid"
		WHEN 3 THEN "Denied"
		WHEN 5 THEN "INFO" END AS StatusText
	,0 as balance_est,0 as balance_conf
FROM account_manual_adjustments F
WHERE ',IF(@Affiliate_id="ALL","1=1","F.Affiliate_id=@Affiliate_id"),' AND ifnull(F.Status,0)<>3
ORDER BY DATE ASC
),
--
All_records_numbered as (
SELECT Date,Description,Op_type,Currency,Amount,Transact,Status,StatusText
	,ROW_NUMBER() OVER (ORDER BY Date) as RowNum
from All_records
)');

SET @SQL=CONCAT(
@CTE
,IF(@Meta="YES",@SQLmeta,""),
'
(SELECT
   ',
    IF(@Meta="YES","'data' as `Meta`,",""),'
   left(date,7) as Month,Date,DESCRIPTION,Op_type
   ,Currency               AS `Operation Currency`
   ,round(Amount,2)        AS `Operation Value`
   ,@Currency              AS `Financial currency`
   ,round(Transact,2)      AS `Financial Value`
   ,StatusText             AS `Status`
   ,SUM(CASE WHEN Status IN (0, 1, 2) THEN Transact ELSE 0 END) OVER (ORDER BY RowNum) AS `Bal_Estimated`
   ,SUM(CASE WHEN Status IN (1, 2)    THEN Transact ELSE 0 END) OVER (ORDER BY RowNum) AS `Bal_Confirmed`
   ,SUM(CASE WHEN Status IN (0, 1, 2) AND LEFT(Date,7)=@Month AND Op_type IN ("CPA","RShare")
             THEN Transact ELSE 0 END) OVER (ORDER BY RowNum)                          AS `Acum_Comm_CM`
	-- ,round(balance_est,2)   AS `Bal_Estimated`
   -- ,round(balance_conf,2)  AS `Bal_Confirmed`
   ,RowNum
from All_records_numbered
WHERE @Affiliate_id!="ALL"
)
ORDER BY CASE WHEN LEFT(`RowNum`,4)!="omit" THEN CONVERT(`RowNum`,UNSIGNED) ELSE 0 END desc'
,IF(@OnlyBalance="YES","LIMIT 1",""),
';');

SET @SQLfilters=CONCAT(
@CTE,'
(SELECT "01" as "Korder"
            ,"Affiliate" AS "Key"
                         ,a.`username` AS "Value"
                                          ,"Affiliate_id" AS `CallKey`
                                                         ,`Affiliate_id` AS "CallValue"
                                                                         ,COUNT(*) AS "Rows"
FROM All_records R
INNER JOIN account_account a ON a.id=R.Affiliate_id
GROUP BY `Affiliate_id`
)
ORDER BY 1,3
;');

IF @Debug!="NO"   THEN SELECT @SQL;          END IF;
IF @Filters="YES" THEN SET @SQL=@SQLfilters; END IF;
IF @Debug!="NO"   THEN SELECT @SQLfilters;   END IF;

IF @Debug != "YES" THEN
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;
END IF;

END;
$$
DELIMITER ;

-- -----------------------------------------------------
-- -----------------------------------------------------
/*

CALL  economics_by_affiliate1('Affiliate_id=all,Meta=no,debug=ye');
CALL  economics_by_affiliate1('Affiliate_id=39,OnlyBalance=YES,Meta=yes,debug=ye');
CALL  economics_by_affiliate1('Affiliate_id=130,Meta=no,debug=ye');
CALL  economics_by_affiliate1('Affiliate_id=827,Meta=yes,debug=ye');
CALL  economics_by_affiliate1_dev('Affiliate_id=all,filters=yeS,debug=ye');
CALL  economics_by_affiliate1('Affiliate_id=74,filters=ye,debug=ye');
*/
