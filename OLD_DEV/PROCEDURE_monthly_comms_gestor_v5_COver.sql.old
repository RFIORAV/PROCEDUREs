/* PROCEDURE_monthly_comms_gestor_v4_COver - COMISIONES del GESTOR

	22.02.2022 Calculos sobre Snapshot_day_by_day_fact1
	02.04.2022 Se agrega Tracker_ID para estadisticas
	19.04.2022 Tratamiento de Deal por producto y fecha
	27.07.2022 Multimoneda
	13.09.2022 incluye Product
   10.10.2022 V3.1   incluye group by deal
   27.10.2022 V3.2   Nuevo cálculo de RS (acumula por Adv Account)
   28.10.2022 V3.2   Utiliza Brand_Group y Brand_Group_Acum
-- 28.11.2022 v3.3   Se trata nuevos campos is_indirect,Advertiser_indirect_id,Advertiser_indirect
   21.01.2023 v3.4   Trata nuevo concepto Publisher (pagador)
   31.01.2023 v3.5   `Area`
   10.03.2023 v4     PROCEDURE_monthly_comms_gestor_v4_COver.sql - C.Over
   10.03.2023 v4     PROCEDURE_monthly_comms_affiliate_v4_COver.sql - C.Over
   17.05.2024 v5     Nuevo cálculo de Carry Over
  
**/

DROP PROCEDURE IF EXISTS monthly_comms_gestor4;
DROP PROCEDURE IF EXISTS monthly_comms_gestor;

DELIMITER $$

CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE monthly_comms_gestor()
   COMMENT 'Commission calc using C.Over and CPAminusRS'
   LANGUAGE SQL
 
BEGIN
-- Defaults
SET @VERSION         ='v5 17.05.2023';
SET @CurrentDay      =curdate();

-- IF CURDATE()<='2023-03-15' THEN DROP TABLE IF EXISTS `monthly_comms_gestor`; END IF;

CREATE TABLE IF NOT EXISTS `monthly_comms_gestor_v5` (
	`Owner`             VARCHAR(150)  NOT NULL DEFAULT '',
	`Area`              VARCHAR(150)  NOT NULL DEFAULT '',
	`Data_Currency`     VARCHAR(150)  NOT NULL DEFAULT '',
	`Month`             VARCHAR(7)    NOT NULL DEFAULT '0000-00',
	`Publisher`         VARCHAR(150)  NOT NULL DEFAULT '',
	`Brand`             VARCHAR(150)  NOT NULL DEFAULT '',
	`Username`          VARCHAR(150)  NOT NULL DEFAULT '',
	`Publisher_id`      INT(10)       NOT NULL DEFAULT '0',
	`Advertiser_id`     INT(10)       NOT NULL DEFAULT '0',
	`Username_id`       INT(10)       NOT NULL DEFAULT '0',
	`CPA`               DECIMAL(12,0) NOT NULL DEFAULT '0',
	`Net_Revenue`       DECIMAL(12,2) NOT NULL DEFAULT '0',
	`gross_CPA_Val`     DECIMAL(12,2) NOT NULL DEFAULT '0',
	`gross_RS_Val`      DECIMAL(12,2) NOT NULL DEFAULT '0',
	`net_CPA_Val`       DECIMAL(12,2) NOT NULL DEFAULT '0',
	`net_RS_Val`        DECIMAL(12,2) NOT NULL DEFAULT '0',
	`net_Total_comm`    DECIMAL(12,2) NOT NULL DEFAULT '0',
	`RS_CarryOver_Pend` DECIMAL(12,2) NOT NULL DEFAULT '0',
	`CarryOver`         VARCHAR(2)    NOT NULL DEFAULT '0',
	UNIQUE INDEX `Month` (`Month`, `Publisher_id`, `Advertiser_id`, `Username_id`) USING BTREE,
	INDEX `Month_Username_id` (`Month`, `Username_id`) USING BTREE,
	INDEX `Month_Advertiser_id` (`Month`, `Advertiser_id`) USING BTREE   
)
ENGINE=InnoDB
;

TRUNCATE TABLE `monthly_comms_gestor_v5`;

INSERT IGNORE INTO `monthly_comms_gestor_v5`
WITH DbD_Fact1_Account_monthly as (
	SELECT
		 LEFT(DATE,7) AS `Month`
		,IFNULL(p.`Advertiser_name`,"_none_") AS `Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
      ,CAST(`Username_id` AS UNSIGNED)                AS `Username_id`
		,SUM(IFNULL(`Qualified_Players`,0))  				AS `CPA`
		,SUM(IFNULL(`Net_Revenue`,0))							AS `Net_Revenue`
		,ROUND(SUM(IFNULL(`CPA_Value_Gestor`,0)),2)     AS `gross_CPA_Val`
		,ROUND(SUM(IFNULL(`Revenue_Share_Gestor`,0)),2) AS `gross_RS_Val`
		,if(`Deal_Ges_Carry_Over`="1","1","0")          as `CarryOver`
		,if(`Deal_Ges_RS_Against_CPA`="1","1","0")      as `CPAminusRS`
		,`Deal_Ges_id`
		,`Deal_Ges_CPA`
		,`Deal_Ges_RS_Base`
		,`Deal_Ges_RS`
		,`Deal_Ges_Valid_From`
		,Data_Currency
		FROM `Snapshot_day_by_day_fact1` D
      LEFT JOIN campaign_publisher p ON p.id=D.`Publisher_id`
      -- ---------for-testing------------
      -- WHERE username_id IN (24,196)
      -- --------------------------------
   	GROUP BY LEFT(DATE,7),`Username_id`,`Deal_Ges_RS_Against_CPA`,`Deal_Ges_Carry_Over`
),
-- ---------------------------------------------------------------------------------
DbD_Fact1_Account_monthly_CPA_minus_RS as (
   (
   SELECT
		 `Month`
      ,`Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
		,`Username_id`
		,`CPA`
		,`Net_Revenue`
		,`gross_CPA_Val`
		,`gross_RS_Val`
		,`CarryOver`
		,`CPAminusRS`
      ,(CASE WHEN `gross_RS_Val`>=0 THEN `gross_CPA_Val`   -- no hay RS para descontar de CPA
             ELSE                                          -- hay RS para descontar de CPA
                 (CASE WHEN `gross_CPA_Val`>=ABS(gross_RS_Val) 
                       THEN (`gross_CPA_Val`-ABS(gross_RS_Val))
                       ELSE 0 END)
             END)                                        AS `net_CPA_Val`      

      ,(CASE WHEN `gross_RS_Val`>=0 THEN `gross_RS_Val`                     -- no hay RS para descontar de CPA
             ELSE                                                           -- hay RS negativa
                 (CASE WHEN `gross_CPA_Val`>=ABS(gross_RS_Val) 
                       THEN 0                                               -- RS se descuenta totalmente
                       ELSE (ABS(gross_RS_Val)-`gross_CPA_Val`)             -- RS se descuenta totalmente pero hay remanente
                       END)
             END)                                        AS `net_RS_before_CO`  
             
	FROM `DbD_Fact1_Account_monthly` D
   WHERE `CPAminusRS`=1
   )
   UNION ALL -- --------------------------------------------
   (
	SELECT
		 `Month`
      ,`Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
		,`Username_id`
		,`CPA`
		,`Net_Revenue`
		,`gross_CPA_Val`
		,`gross_RS_Val`
		,`CarryOver`
		,`CPAminusRS`
      ,`gross_CPA_Val` AS `net_CPA_Val`
      ,`gross_RS_Val`  AS `net_RS_before_CO`
	FROM `DbD_Fact1_Account_monthly` D
   WHERE `CPAminusRS`=0
   )   
	ORDER BY `Username_id`,`Month`,`CarryOver`,`CPAminusRS`
),
-- ---------------------------------------------------------------------------------
DbD_Fact1_Account_monthly_CPA_minus_RS_acum as (
   SELECT
		 `Month`
      ,`Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
		,`Username_id`
		,sum(`CPA`          )                   as `CPA`          
		,round(sum(`Net_Revenue`           ),2) as `Net_Revenue`  
		,round(sum(`gross_CPA_Val`         ),2) as `gross_CPA_Val`
		,round(sum(`gross_RS_Val`          ),2) as `gross_RS_Val` 
      ,round(sum(`net_CPA_Val`           ),2) as `net_CPA_Val`  
      ,round(sum(`net_RS_before_CO`      ),2) as `net_RS_before_CO`       
	   ,max(`CarryOver`)  as `CarryOver`
	   ,max(`CPAminusRS`) as `CPAminusRS`
	FROM `DbD_Fact1_Account_monthly_CPA_minus_RS`
   GROUP BY `Username_id`,`Month`,`CarryOver`
	ORDER BY `Username_id`,`Month`,`CarryOver`
),

-- ---------------------------------------------------------------------------------
DbD_Fact1_Account_monthly_calc_NO_COver as (
SELECT g.*
   ,0.00 as `TmpInt`
   ,""   as `TmpControl`
   ,case when `net_RS_before_CO`<0 then 0
         else `net_RS_before_CO`
    end                                      as `net_RS_Val` 
   ,0    as `Saldo_CO` 
from DbD_Fact1_Account_monthly_CPA_minus_RS_acum g
WHERE `CarryOver`!=1
),

DbD_Fact1_Account_monthly_calc_COver as (
SELECT g.*
   ,case when IFNULL(@ACCOUNT,0)!=`Username_id` then @Saldo_CO:=0.00         else @Saldo_CO end as `TmpInt`
   ,case when IFNULL(@ACCOUNT,0)!=`Username_id` then @Account:=`Username_id` ELSE @ACCOUNT  end as `TmpControl`
   ,case when  `net_RS_before_CO`<0            then 0
         when (`net_RS_before_CO`+@Saldo_CO)<0 then 0
         ELSE (`net_RS_before_CO`+@Saldo_CO) 
    END                                          as `net_RS_Val` 
   ,case when (@Saldo_CO+`net_RS_before_CO`)>=0  -- RS compensa todo el saldo anterior
         then @Saldo_CO:=0.00                                            -- inicializa solo luego de haber utilizado
         ELSE (@Saldo_CO:=@Saldo_CO+`net_RS_before_CO`) END as `Saldo_CO`      
from DbD_Fact1_Account_monthly_CPA_minus_RS_acum g
WHERE `CarryOver`=1
GROUP BY `Username_id`,`Month`
-- ORDER BY `Username_id`,`Month`
),

DbD_Fact1_Account_monthly_join as (
      SELECT * FROM DbD_Fact1_Account_monthly_calc_NO_COver
      UNION ALL -- ----------------------------------
      SELECT * FROM DbD_Fact1_Account_monthly_calc_COver
)
-- Tests de queries parciales ------------------------------------------------------
-- SELECT * FROM DbD_Fact1_Account_monthly_CPA_minus_RS; 
-- SELECT * FROM DbD_Fact1_Account_monthly_CPA_minus_RS_acum;
-- SELECT * FROM DbD_Fact1_Account_monthly_calc_NO_COver;
-- SELECT * FROM DbD_Fact1_Account_monthly_calc_COver;
-- SELECT * FROM DbD_Fact1_Account_monthly_join;
-- ---------------------------------------------------------------------------------
SELECT
    CU.Owner,CU.Area,CU.`Data_Currency`
	,J.`Month`
   ,J.`Publisher`
   ,J.`Brand`
   ,J.`Username`
	,J.`Publisher_id`
	,J.`Advertiser_id`
	,J.`Username_id`
   ,sum(`CPA`                            )     as `CPA`
	,round(sum(`Net_Revenue`              ),2)  as `Net_Revenue`  
	,round(sum(`gross_CPA_Val`            ),2)  as `gross_CPA_Val`
	,round(sum(`gross_RS_Val`             ),2)  as `gross_RS_Val` 
   ,round(sum(`net_CPA_Val`              ),2)  as `net_CPA_Val`  
   ,round(sum(`net_RS_Val`               ),2)  as `net_RS_Val`   
   ,round(sum(`net_CPA_Val`+`net_RS_Val` ),2)  as `net_Total_comm`   
   ,round(sum(`Saldo_CO`                 ),2)  as `RS_CarryOver_Pend` 
	,max(`CarryOver`)                           as `CarryOver`
FROM DbD_Fact1_Account_monthly_join J
LEFT JOIN `campaign_username` `CU` ON `CU`.`id` = `J`.`Username_id` 
GROUP BY `Username_id`,`Month`
ORDER BY `Username_id`,`Month`
;

END$$
DELIMITER ;

/*
call monthly_comms_gestor;
 
*/
