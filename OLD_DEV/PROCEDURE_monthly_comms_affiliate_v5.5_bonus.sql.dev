/* PROCEDURE_monthly_comms_affiliate_v4_COver  - COMISIONES del AFILIADO

	22.02.2022 Calculos sobre Snapshot_day_by_day_fact1
	02.04.2022 Se agrega Tracker_ID para estadisticas
	19.04.2022 Tratamiento de Deal por producto y fecha
	27.07.2022 Multimoneda
	13.09.2022 incluye Product
   10.10.2022 V3.1   incluye group by deal
   27.10.2022 V3.2   Nuevo cálculo de RS (acumula por Adv Account)
   28.10.2022 V3.2   Utiliza Brand_Group y Brand_Group_Acum
-- 28.11.2022 v3.3   Se trata nuevos campos is_indirect,Advertiser_indirect_id,Advertiser_indirect
   21.01.2023 v3.4   Trata nuevo concepto Publisher (pagador)
   31.01.2023 v3.5   `Area`
   10.03.2023 v4     PROCEDURE_monthly_comms_gestor_v4_COver.sql - C.Over
   11.03.2023 v4     PROCEDURE_monthly_comms_affiliate_v4_COver.sql - C.Over
   11.01.2024 v4.1   Se agrega cálculo comision referral
                     Modifica índices monthly_comms_affiliate
                     compatibilidad con view_monthly_fact_aff4
   29.07.2024 v5     Tratamiento de Currency del deal
   09.08.2024 v5.1   Agregado channel y product
   03.09.2024 v5.1.1 Fix cuando no existe deal afiliado (por error deshabilitando reglas en campaign_mkt_source_deal)
              v5.2   Tramiento de RS negativas
   06.09.2024 v5.2.1 Tratamiento From/To master_affiliate_deals_per_affiliate
   19.09.2024 v5.2.2 Calculo deals referrer por Brand sobre Snapshot_day_by_day_fact2
   01.11.2024 v5.3   Calculo deals referrer por Brand sobre monthly_comms_affiliate_v5
                     Incluye % comisión sobre total comisión afiliado. Acumula a comision por CPA
   20.11.2024 v5.4   Agregado Owner a la tabla
   16.12.2024 v5.5   Recálculo restringido a mes corriente y mes anterior.
                     Cálculo de Bonus
                     ALTER TABLE `monthly_comms_affiliate_v5` ADD COLUMN `Comm_type`
                        VARCHAR(80) NULL DEFAULT "CPA+RS" COMMENT 'null/bonus' AFTER `Account_id`;

**/
SET NAMES 'utf8mb4' COLLATE 'utf8mb4_0900_ai_ci';

DROP PROCEDURE IF EXISTS monthly_comms_affiliate_v5;

DELIMITER $$

CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE monthly_comms_affiliate_v5()
   COMMENT 'Commission calc using C.Over and CPAminusRS'
   LANGUAGE SQL

BEGIN
-- Defaults
SET @Version         ='v5.5 16.12.2024';
SET @CurrentDay      =CURDATE();
SET @LMonth          =LEFT(DATE_SUB(CURDATE(), INTERVAL 1 MONTH),7);


IF CURDATE()<='2024-12-15' THEN SET @LMonth='2022-01'; END IF;
IF CURDATE()<='2024-12-15' THEN DROP TABLE IF EXISTS `monthly_comms_affiliate_v5`; END IF;

CREATE TABLE IF NOT EXISTS `monthly_comms_affiliate_v5` (
-- `id` INT(10)                      NOT NULL AUTO_INCREMENT,
	`Owner`            INT            NOT NULL DEFAULT '0',
	`Account_id`       INT            NOT NULL DEFAULT '0',
	`Comm_type`        VARCHAR(80)        NULL DEFAULT NULL COMMENT 'null/bonus',
	`Month`            VARCHAR(7)     NOT NULL DEFAULT '0000-00',
	`Affiliate`        VARCHAR(80)    NOT NULL DEFAULT '',
	`Brand`            VARCHAR(80)    NOT NULL DEFAULT '',
	`Affiliate_id`     INT            NOT NULL DEFAULT '0',
	`Advertiser_id`    INT            NOT NULL DEFAULT '0',
	`Currency`         VARCHAR(20)    NOT NULL DEFAULT '',
	`CPA`              DECIMAL(12,0)  NOT NULL DEFAULT '0',
	`net_CPA_Val`      DECIMAL(12,2)  NOT NULL DEFAULT '0',
	`net_RS_Val`       DECIMAL(12,2)  NOT NULL DEFAULT '0',
	`net_Total_comm`   DECIMAL(12,2)  NOT NULL DEFAULT '0',
	`RS_carry_NCO`     DECIMAL(12,2)  NOT NULL DEFAULT '0',
	`Net_Revenue`      DECIMAL(12,2)  NOT NULL DEFAULT '0',
	`gross_CPA_Val`    DECIMAL(12,2)  NOT NULL DEFAULT '0',
	`gross_RS_Val`     DECIMAL(12,2)  NOT NULL DEFAULT '0',
   `Sub_Affiliate`    VARCHAR(80)        NULL DEFAULT '',
	`Sub_Affiliate_id` INT                NULL DEFAULT '0',
	`Product`          VARCHAR(80)        NULL DEFAULT '',
	`Product_Real`     VARCHAR(80)        NULL DEFAULT '',
	`Channel`          VARCHAR(80)        NULL DEFAULT '',
	`Channel_id`       INT                NULL DEFAULT '0',
	-- `CarryOver`       VARCHAR(2)     NOT NULL DEFAULT '0',
	-- `CPAminusRS`      INT            NOT NULL DEFAULT '0'
	--  PRIMARY KEY (`id`) USING BTREE,
	-- UNIQUE INDEX `Month` (`Affiliate_id`, `Advertiser_id`,`Month`,`Sub_Affiliate_id`) USING BTREE,
	INDEX `Month_Affiliate_id` (`Month`, `Affiliate_id`)           USING BTREE,
	INDEX `Affiliate_id_Month` (`Affiliate_id`,`Month`)            USING BTREE,
	INDEX `Month_Advertiser_id` (`Month`, `Advertiser_id`)         USING BTREE
)
;
-- TRUNCATE TABLE `monthly_comms_affiliate_v5`;
DELETE FROM `monthly_comms_affiliate_v5` WHERE `Month`>=@LMonth;

INSERT IGNORE INTO  `monthly_comms_affiliate_v5`
WITH DbD_Fact2_fix as (
	SELECT
       f.`Owner`
      ,f.`Username_id`                               AS `Account_id`
		,LEFT(DATE,7)                                  AS `Month`
      ,f.`Affiliate_id`
		,f.`Advertiser_id`
		,IFNULL(`Qualified_Players`,0)  			        AS `Qualified_Players`
		,IFNULL(`Net_Revenue`,0)						     AS `Net_Revenue`
		,IFNULL(f.`Deal_Aff_id`   ,0)                     `Deal_Aff_id`
		,IFNULL(f.`Deal_Aff_CPA`     ,0)               as `Deal_Aff_CPA`
		,IFNULL(f.`Deal_Aff_Carry_Over`,0)             as `CarryOver`
		,IFNULL(f.`Deal_Aff_RS_Against_CPA`,0)         as `CPAminusRS`
		,IFNULL(f.`Deal_Aff_RS_Base`       ,'')        as `Deal_Aff_RS_Base`
		,IFNULL(f.`Deal_Aff_RS` ,0)                    as `Deal_Aff_RS`
		,IFNULL(d.`Currency`      ,f.`Data_Currency`)  as `Deal_Currency`  -- Currency deal afiliado
      ,IFNULL(f.CPA_Value_Affiliate,0)               as `gross_CPA_Val`
      ,IFNULL(f.`Affiliate`     ,'')                    `Affiliate`
      ,f.`Brand`
      ,f.`Product`
      ,f.`Product_Real`
      ,IFNULL(f.`Channel`   ,"")                        `Channel`
      ,IFNULL(f.`Channel_id`,0)                         `Channel_id`
		,f.`Data_Currency`      -- Currency account
      ,CASE WHEN f.`Data_Currency`=d.`Currency` THEN 1
            ELSE getCurrencyConversion(1,f.`Data_Currency`,d.`Currency`)
            END                                          AS FactorNR     -- Factor para convertir NR a moneda deal
		FROM `Snapshot_day_by_day_fact2` f
      LEFT JOIN campaign_deal_affiliate d on f.Deal_Aff_id=d.id
      WHERE LEFT(DATE,7)>=@LMonth
),
DbD_Fact2 as (
	SELECT
       f.`Owner`
      ,f.`Account_id`
		,`Month`
      ,f.`Affiliate_id`
		,f.`Advertiser_id`
		,SUM(IFNULL(`Qualified_Players`,0))  			  AS `CPA`
		,SUM(IFNULL(`Net_Revenue`,0))  			        AS `Net_Revenue`
		,SUM(IFNULL(`gross_CPA_Val`,0))					  AS `gross_CPA_Val`
		,`Deal_Aff_id`
		,IFNULL(`Deal_Aff_CPA`,0)                      AS `Deal_Aff_CPA`
		,`CarryOver`
		,`CPAminusRS`
		,`Deal_Aff_RS_Base`
		,`Deal_Aff_RS`
		,`Deal_Currency`        -- Currency deal afiliado
      ,`Affiliate`
      ,f.`Brand`
      ,f.`Product`
      ,f.`Product_Real`
      ,`Channel`
      ,`Channel_id`
		,f.`Data_Currency`      -- Currency account
      ,FactorNR               -- Factor para convertir NR a moneda deal
		FROM `DbD_Fact2_fix` f
		GROUP BY `Owner`,`Account_id`,`Affiliate_id`,`Month`,`Advertiser_id`,`CPAminusRS`
            ,`Product_Real`,`Channel_id`
            ,`Data_Currency`,Deal_Currency,`Deal_Aff_id`
      HAVING `CPA`<>0 OR `Deal_Aff_RS`>0
),
DbD_Fact2_Account_monthly as (
	SELECT
       `Owner`
      ,`Account_id`
		,`Month`
      ,`Affiliate_id`
		,`Advertiser_id`
		,SUM(`CPA`)  				                                        AS `CPA`
		,SUM(IFNULL(`Net_Revenue`,0))							                AS `Net_Revenue`
		,ROUND(SUM(CASE WHEN IFNULL(`Deal_Aff_CPA`,0)>0 THEN (`Deal_Aff_CPA`*CPA) ELSE `gross_CPA_Val` END),2)
                                                                      AS `gross_CPA_Val`
		,ROUND(SUM(IFNULL(`Deal_Aff_RS`,0)*`Net_Revenue`/100*`FactorNR`),2) AS `gross_RS_Val`
		,`Deal_Aff_id`
		,`Deal_Aff_CPA`
		,`CarryOver`
		,`CPAminusRS`
		,`Deal_Aff_RS_Base`
		,`Deal_Aff_RS`
		,`Deal_Currency`    -- Currency deal afiliado
      ,`Affiliate`
      ,`Brand`
      ,`Product`
      ,`Product_Real`
      ,`Channel`
      ,`Channel_id`
		,`Data_Currency`    -- Currency account
		FROM `DbD_Fact2` f
		GROUP BY `Owner`,`Account_id`,`Affiliate_id`,`Month`,`Advertiser_id`,f.`Product_Real`,f.`Channel_id`,`CPAminusRS`,`Deal_Currency` -- ,`Deal_Aff_Carry_Over`
),
DbD_Fact2_Account_monthly_CPA_versus_RS as (
   (
   SELECT
       `Owner`
      ,`Account_id`
		,`Month`
      ,`Affiliate_id`
		,`Advertiser_id`
		,`CPA`
		,`Net_Revenue`
		,`gross_CPA_Val`
		,`gross_RS_Val`
		,`CarryOver`
		,`CPAminusRS`
      ,(CASE WHEN `gross_CPA_Val`>=ABS(gross_RS_Val)
             THEN @net_CPA_Val:=`gross_CPA_Val`-ABS(gross_RS_Val)
             ELSE @net_CPA_Val:=0 END) AS `net_CPA_Val`
      ,(CASE WHEN `gross_CPA_Val`>=ABS(gross_RS_Val)
             THEN @net_RS_Val:=0
             ELSE @net_RS_Val:=`gross_CPA_Val`-ABS(gross_RS_Val)
             END)                      AS `net_RS_Val`
      ,`Affiliate`
      ,`Brand`
      ,`Product`
      ,`Product_Real`
      ,`Channel`
      ,`Channel_id`
      ,`Deal_Currency`
	FROM `DbD_Fact2_Account_monthly` D
   WHERE `CPAminusRS`=1 AND `gross_RS_Val`<0
   )
   UNION ALL -- --------------------------------------------
   (
	SELECT
       `Owner`
      ,`Account_id`
		,`Month`
      ,`Affiliate_id`
		,`Advertiser_id`
		,`CPA`
		,`Net_Revenue`
		,`gross_CPA_Val`
		,`gross_RS_Val`
		,`CarryOver`
		,`CPAminusRS`
      ,`gross_CPA_Val`           AS `net_CPA_Val`
      ,`gross_RS_Val`            AS `net_RS_Val`
      ,`Affiliate`
      ,`Brand`
      ,`Product`
      ,`Product_Real`
      ,`Channel`
      ,`Channel_id`
      ,`Deal_Currency`
	FROM `DbD_Fact2_Account_monthly` D
   WHERE `CPAminusRS`=1 AND `gross_RS_Val`>=0
   )
   UNION ALL -- --------------------------------------------
   (
	SELECT
       `Owner`
      ,`Account_id`
		,`Month`
      ,`Affiliate_id`
		,`Advertiser_id`
		,`CPA`
		,`Net_Revenue`
		,`gross_CPA_Val`
		,`gross_RS_Val`
		,`CarryOver`
		,`CPAminusRS`
      ,`gross_CPA_Val`           AS `net_CPA_Val`
      ,`gross_RS_Val`            AS `net_RS_Val`
      ,`Affiliate`
      ,`Brand`
      ,`Product`
      ,`Product_Real`
      ,`Channel`
      ,`Channel_id`
      ,`Deal_Currency`
	FROM `DbD_Fact2_Account_monthly` D
   WHERE `CPAminusRS`=0 -- AND `gross_RS_Val`>=0
   )
	ORDER BY `Owner`,`Account_id`,`Affiliate_id`,`Advertiser_id`,`Month`,`CPAminusRS`
),
DbD_Fact2_Account_monthly_RS_Brand_Month AS (
	SELECT
       `Owner`
      ,`Account_id`
		,`Month`
      ,`Affiliate_id`
      ,SUM(`net_RS_Val`)         AS `net_RS_Val`
      ,SUM(`net_RS_Val`)         AS `net_RS_Val_ACUM`
      ,`Brand`
	FROM `DbD_Fact2_Account_monthly_CPA_versus_RS`
   GROUP BY `Affiliate_id`,`Brand`,`Month` HAVING `net_RS_Val_ACUM`>=0
   UNION ALL
   	SELECT
       `Owner`
      ,`Account_id`
		,`Month`
      ,`Affiliate_id`
      ,0                         AS `net_RS_Val`
      ,SUM(`net_RS_Val`)         AS `net_RS_Val_ACUM`
      ,`Brand`
	FROM `DbD_Fact2_Account_monthly_CPA_versus_RS`
   GROUP BY `Owner`,`Account_id`,`Affiliate_id`,`Brand`,`Month` HAVING `net_RS_Val_ACUM`<0
),
DbD_Fact2_Account_monthly_CPA_versus_RS_acum as (
   SELECT
       f.`Owner`
      ,f.`Account_id`
		,f.`Month`
      ,f.`Affiliate_id`
		,f.`Advertiser_id`
		,sum(f.`CPA`          ) as `CPA`
		,sum(f.`Net_Revenue`  ) as `Net_Revenue`
		,sum(f.`gross_CPA_Val`) as `gross_CPA_Val`
		,sum(f.`gross_RS_Val` ) as `gross_RS_Val`
      ,sum(`net_CPA_Val`  ) as `net_CPA_Val`
      ,sum(case when RS.`net_RS_Val`>0 THEN f.`net_RS_Val` ELSE 0 END) as `net_RS_Val`
      ,f.`Affiliate`
      ,f.`Brand`
      ,f.`Product`
      ,f.`Product_Real`
      ,f.`Channel`
      ,f.`Channel_id`
      ,f.`Deal_Currency`
		,f.`CarryOver`
		-- ,`CPAminusRS`
	FROM `DbD_Fact2_Account_monthly_CPA_versus_RS` f
   LEFT JOIN DbD_Fact2_Account_monthly_RS_Brand_Month RS ON RS.`Affiliate_id`=f.`Affiliate_id` AND RS.`Brand`=f.`Brand` AND RS.`Month`=f.`Month`
   GROUP BY f.`Owner`,f.`Account_id`,f.`Affiliate_id`,f.`Advertiser_id`,f.`Month`,`Deal_Currency`,`Product_Real`,`Channel_id`
	ORDER BY f.`Owner`,f.`Account_id`,f.`Affiliate_id`,f.`Advertiser_id`,f.`Month`,`Deal_Currency`,`Product_Real`,`Channel_id`
)
-- SELECT * FROM DbD_Fact2_fix WHERE Affiliate_id=422 AND MONTH="2022-10" AND Qualified_players<>0;
-- SELECT * FROM DbD_Fact2  WHERE Affiliate_id=440 AND MONTH="2023-12" AND CPA<>0;
-- SELECT * FROM DbD_Fact2_Account_monthly;
-- SELECT * FROM DbD_Fact2_Account_monthly_CPA_versus_RS;
-- SELECT * FROM DbD_Fact2_Account_monthly_RS_Brand_Month where affiliate_id=19 ORDER BY `Affiliate_id`,`Brand`,`Month`;
-- SELECT * FROM DbD_Fact2_Account_monthly_CPA_versus_RS_acum;
SELECT
    `Owner`
   ,`Account_id`
   ,"CPA+RS"
   ,`Month`
   ,`Affiliate`
   ,`Brand`
   ,`Affiliate_id`
	,`Advertiser_id`
   ,`Deal_Currency`
   ,round(sum(`CPA`          ),0) as `CPA`
   ,round(sum(`net_CPA_Val`  ),2) as `net_CPA_Val`
   ,round(sum(`net_RS_Val`   ),2) as `net_RS_Val`
   ,round(sum(`net_CPA_Val`+`net_RS_Val`),2) as `net_Total_comm`
   -- ,round(sum(`RS_carry_NCO` ),2) as `RS_carry_NCO`
   ,0                             as `RS_carry_NCO`
	,round(sum(`Net_Revenue`  ),2) as `Net_Revenue`
	,round(sum(`gross_CPA_Val`),2) as `gross_CPA_Val`
	,round(sum(`gross_RS_Val` ),2) as `gross_RS_Val`
	,' '
	,0
   ,`Product`
   ,`Product_Real`
   ,`Channel`
   ,`Channel_id`
	-- ,`CarryOver`
	-- ,`CPAminusRS`
   -- ,`net_RS_Value`
	-- ,`Dummy0`,`Dummy1`,`Dummy2`,`Dummy3`
	-- ,`Prev_Deal`
-- FROM DbD_Fact2_Account_monthly_CarryOver
FROM DbD_Fact2_Account_monthly_CPA_versus_RS_acum
GROUP BY `Owner`,`Account_id`,`Affiliate_id`,`Advertiser_id`,`Month`,`Deal_Currency`,`Product_Real`,`Channel_id`
ORDER BY `Owner`,`Account_id`,`Affiliate_id`,`Advertiser_id`,`Month`,`Deal_Currency`,`Product_Real`,`Channel_id`
;
-- -------------------------------------------------------------------
-- ----------------COMISION MASTER AFF/REFERRER-----------------------
-- -------------------------------------------------------------------

INSERT IGNORE INTO  `monthly_comms_affiliate_v5`
WITH Master_Sub AS (
SELECT Master_Affiliate_id                `Master_Affiliate_id`
      ,MC.username                     AS `Master`
		,Sub_Affiliate_id                   `Sub_Affiliate_id`
      ,AC.username                     AS `Sub_Affiliate`
		,ifnull(M.Advertiser_id,0)       as `Advertiser_id`
		,ifnull(M.Status_id,"1")         as `Status_id`
		,M.Valid_From,M.Valid_To
		,M.Deal_id
		,MD.Deal_Name
		,MD.Commissions_Percentage       AS `Perc_Com`
		,MD.CPA_Value                    AS `ComByCPA`
      ,MD.RS_Percentage                AS `RS%`
      ,MD.`Deal_Currency`
from master_affiliate_deals_per_affiliate M
LEFT  JOIN `account_account` AC        on M.Sub_Affiliate_id=AC.id
LEFT  JOIN `account_account` MC        on M.Master_Affiliate_id=MC.id
LEFT  JOIN `master_affiliate_deals` MD on M.Deal_id=MD.id
-- WHERE Master_Affiliate_id="',@Affiliate_id,'"
)
SELECT
    C.`Owner`
   ,C.`Account_id`
   ,"REFER"
   ,C.`Month`
	,MS.Master                             `Affiliate`
   ,C.`Brand`
	,MS.Master_Affiliate_id                `Affiliate_id`
	,C.`Advertiser_id`
   ,MS.`Deal_Currency`
	,SUM(CPA)                           as `CPA`
	,SUM(CPA*ComByCPA)                  as `net_CPA_Val`
	,0                                  as `net_RS_Val`
	,SUM(CPA*ComByCPA+`net_Total_comm`*`Perc_Com`/100) as `net_Total_comm`
	,0                                  as `RS_carry_NCO`
	,0                                  as `Net_Revenue`
	,0                                  as `gross_CPA_Val`
	,0                                  as `gross_RS_Val`
	,C.Affiliate                           `Sub_Affiliate`
	,C.Affiliate_id                        `Sub_Affiliate_id`
   ,C.`Product`
   ,C.`Product_Real`
   ,C.`Channel`
   ,C.`Channel_id`
FROM monthly_comms_affiliate_v5 C
INNER JOIN LATERAL (SELECT * FROM Master_Sub MS
   WHERE
       MS.Sub_Affiliate_id=C.Affiliate_id
   AND MS.Status_id="1"
   AND (MS.Advertiser_id=0 OR MS.Advertiser_id=C.`Advertiser_id`)
   AND LEFT(C.`Month`,7)>=LEFT(MS.Valid_From,7)
   AND LEFT(C.`Month`,7)<=LEFT(ifnull(MS.Valid_to,CURDATE()),7)
   ORDER BY MS.Advertiser_id DESC
   LIMIT 1) AS MS
WHERE LEFT(C.Month,7)>=@LMonth
-- GROUP BY C.Affiliate
GROUP BY C.`Owner`,C.`Account_id`,C.`Affiliate_id`,C.`Advertiser_id`,`Month`,`Channel_id` HAVING `net_Total_comm`<>0
ORDER BY Affiliate
;
-- -------------------------------------------------------------------
-- -------------BONUS POR OBJETIVOS-----------------------------------
-- -------------------------------------------------------------------

INSERT IGNORE INTO  `monthly_comms_affiliate_v5`
WITH Bonus_comms AS (
SELECT
    C.`Owner`
   ,MAX(C.`Account_id`)       AS `Account_id`
   ,C.`Month`
   ,C.Affiliate_id
   ,C.Affiliate
   ,C.Brand
   ,B.Code_to_Affiliate
   ,MAX(C.`Advertiser_id`)    AS `Advertiser_id`
   ,SUM(C.cpa)                AS `CPA`
   ,SUM(C.Net_Revenue)        AS `Net_Revenue`
   ,B.Conditions,B.CPA_min,B.NR_min
   ,B.Date_Valid_From,B.Date_Valid_to
   ,B.Bonus_Value,B.Currency
   ,B.Status_id
   ,C.Comm_type
FROM `monthly_comms_affiliate_v5` C
LEFT JOIN campaign_deal_affiliate_bonus B
       ON B.Status_id=1
      AND (B.Affiliate_id=C.Affiliate_id OR ifnull(B.Affiliate_id,0)=0)
      AND (lower(B.Brand)=lower(C.Brand) OR ifnull(B.Brand,"")="")
--       AND (lower(B.Code_to_Affiliate)=lower(C.Code_to_Affiliate) OR ifnull(B.Code_to_Affiliate,"")="")
      AND C.`Month` BETWEEN left(B.Date_Valid_From,7) AND left(ifnull(B.Date_Valid_to,"9999-12-31"),7)
WHERE LEFT(C.Month,7)>=@LMonth AND C.Comm_type="CPA+RS" -- AND B.Date_Valid_From IS NOT NULL
GROUP BY C.Affiliate_id,B.Affiliate_id,C.Brand,C.`Month` HAVING `CPA`>=B.CPA_min
),
Bonus AS (
SELECT
    F.`Owner`
   ,MAX(F.Username_id)        AS `Account_id`
   ,LEFT(DATE,7)              AS `Month`
   ,F.Affiliate_id
   ,IFNULL(F.Affiliate,'')       `Affiliate`
   ,F.Brand
   ,""                           `Code_to_Affiliate`
   ,MAX(F.`Advertiser_id`)    AS `Advertiser_id`
   ,SUM(F.Qualified_Players)  AS `CPA`
   ,SUM(F.Net_Revenue)        AS `Net_Revenue`
   ,F.`Data_Currency`      -- Currency account
   ,B.Conditions,B.CPA_min,B.NR_min
   ,B.Date_Valid_From,B.Date_Valid_to
   ,B.Bonus_Value,B.Currency
   ,B.Status_id
FROM `Snapshot_day_by_day_fact2` F
LEFT JOIN campaign_deal_affiliate_bonus_copy B
       ON B.Status_id=1
      AND (B.Affiliate_id=F.Affiliate_id OR ifnull(B.Affiliate_id,0)=0)
      AND (lower(B.Brand)=lower(F.Brand) OR ifnull(B.Brand,"")="")
      AND (ifnull(B.Code_to_Affiliate,"")="")
      AND LEFT(F.DATE,7) BETWEEN left(B.Date_Valid_From,7) AND left(ifnull(B.Date_Valid_to,"9999-12-31"),7)
WHERE LEFT(F.DATE,7)>=@LMonth
GROUP BY F.Affiliate_id,B.Affiliate_id,F.Brand,LEFT(F.DATE,7)  HAVING `CPA`>=B.CPA_min
UNION ALL -- --------------------------------------------------------
SELECT
    F.`Owner`
   ,MAX(F.Username_id)        AS `Account_id`
   ,LEFT(DATE,7)              AS `Month`
   ,F.Affiliate_id
   ,IFNULL(F.Affiliate,'')       `Affiliate`
   ,F.Brand
   ,F.Code_to_Affiliate
   ,MAX(F.`Advertiser_id`)    AS `Advertiser_id`
   ,SUM(F.Qualified_Players)  AS `CPA`
   ,SUM(F.Net_Revenue)        AS `Net_Revenue`
   ,F.`Data_Currency`      -- Currency account
   ,B.Conditions,B.CPA_min,B.NR_min
   ,B.Date_Valid_From,B.Date_Valid_to
   ,B.Bonus_Value,B.Currency
   ,B.Status_id
FROM `Snapshot_day_by_day_fact2` F
LEFT JOIN campaign_deal_affiliate_bonus_copy B
       ON B.Status_id=1
      AND (B.Affiliate_id=F.Affiliate_id OR ifnull(B.Affiliate_id,0)=0)
      AND (lower(B.Brand)=lower(F.Brand) OR ifnull(B.Brand,"")="")
      AND (lower(B.Code_to_Affiliate)=lower(F.Code_to_Affiliate))
      AND LEFT(F.DATE,7) BETWEEN left(B.Date_Valid_From,7) AND left(ifnull(B.Date_Valid_to,"9999-12-31"),7)
WHERE LEFT(F.DATE,7)>=@LMonth
GROUP BY F.Affiliate_id,B.Affiliate_id,F.Brand,F.Code_to_Affiliate,LEFT(F.DATE,7)  HAVING `CPA`>=B.CPA_min
)
SELECT
    C.`Owner`
   ,C.`Account_id`
   ,"BONUS"
   ,C.`Month`
	,C.Affiliate                           `Affiliate`
   ,C.`Brand`
   ,C.Affiliate_id                        `Affiliate_id`
	,C.`Advertiser_id`
   ,C.Currency
	,C.CPA                              as `CPA`
	,C.Bonus_Value                      as `net_CPA_Val`
	,0                                  as `net_RS_Val`
	,C.Bonus_Value                      as `net_Total_comm`
	,0                                  as `RS_carry_NCO`
	,C.`Net_Revenue`                    as `Net_Revenue`
	,0                                  as `gross_CPA_Val`
	,0                                  as `gross_RS_Val`
	,""
	,0
   ,""
   ,""
   ,""
   ,0
FROM Bonus C
;

END$$
DELIMITER ;

