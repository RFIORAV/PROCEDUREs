/* 
PROCEDURE_Gestor_MonthlySources_v2.sql - 

Observaciones: 

Cada Key debe estar seguida de = y el valor deseado SIN comillas (ni simples ' ni dobles ")
Cada par Key=Value de estar seguidO por una COMA
El conjunto de pares [Key=Value] debe ir entre '' (comillas simples) porque forman UN UNICO PARAMETRO string de entrada para el PROCEDURE.
   
Keys:

Owner           =[ALL | id del Owner]. OPCIONAL. Default=ALL
Month           =[AAAA-MM]. OPCIONAL. Default=Current Month.
Affiliate_id    =[ALL | id del Affiliate_id]. OPCIONAL. Para View=viewGES Default=ALL. Para View=viewAFF Default=999999
Advertiser_id   =[ALL | id del Advertiser_id]. OPCIONAL. Default=ALL
Adv_Account_id  =[ALL | id del Adv_Account_id]. OPCIONAL. Default=ALL
Product         =[ALL | Product]. OPCIONAL. Default=ALL
Platform        =[ALL | Platform]. OPCIONAL. Default=ALL
Currency        =[EUR | Original]. Moneda a la que se convierten los resultados. Original=No hacer conversiones. El Profit NO SE CALCULARÁ cuando sean monedas distintas. OPCIONAL. Default=EUR.
Total           =[Yes | No]. Incluye línea/s de Totales x OWNER/Currency. OPCIONAL. Default=Yes
Debug           =[No | Yes | KeyValues]. [No] NO EJECUTA QUERY y devuelve el código del Query. [KeyValues] EJECUTA QUERY y devuelve KeyValues del Query. OPCIONAL. Default=No

Keys no utilizadas:
TotLine         =[First | Last]. Posición de la línea de Totales. OPCIONAL. Default=First
ByAccount       =[No | Yes]. Info acumulada por Account/Advertiser. OPCIONAL. Default=No
ByDay           =[No | Yes]. Info acumulada por Dia/Mes. OPCIONAL. Default=No
View            =[viewAFF | viewGES]. Info de Fact2 (viewAFF) o de Fact1 (viewGES). OPCIONAL. Default=viewAFF
OrderBy         =[CPA | CPAvalue | Profit | Advertiser]. OPCIONAL. Default=CPA
Order           =[Desc | Asc]. OPCIONAL. Default=Desc

Parámetros ('[Key=Value[,...]'])

Ejemplos:

call Gestor_MonthlySources('debug=yes');
call Gestor_MonthlySources('Advertiser_id=59,Month=2022-08,debug=yes');
call Gestor_MonthlySources('Platform=netrefer,Product=sport,Month=2022-08,debug=yes');
call Gestor_MonthlySources('Product=casino');
call Gestor_MonthlySources('Affiliate_id=39,Month=2022-08');
call Gestor_MonthlySources('Adv_Account_id=79');
call Gestor_MonthlySources('Owner=2,Month=2022-08');

29.09.2022 V1

*/

DROP PROCEDURE IF EXISTS Gestor_MonthlySources;

DELIMITER $$
CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE `Gestor_MonthlySources`(IN
   InputCommLine    VARCHAR(250)
   )
    COMMENT 'Gestor_MonthlySources'
BEGIN
-- --------------------------------------------------------------------------------------------
-- Defaults
SET @Month           =left(curdate(),7);
SET @Owner           ='ALL';
SET @Advertiser_id   ='ALL';
SET @Affiliate_id    ='ALL';
SET @Adv_Account_id  ='ALL';
SET @Channel_id      ='ALL';
SET @Product         ='ALL';
SET @Platform        ='ALL';
SET @Currency        ='EUR';
SET @Total           ='YES';
SET @Debug           ='NO';

SET @InputCommLine=Concat(InputCommLine ,',');      -- Coma de cierre
SET @InputCommLine=replace(@InputCommLine,' ','');  -- Elimina espacios
SET @InputCommLine=replace(@InputCommLine,'"','');  -- Elimina comillas

-- IF @Debug="YES" THEN SELECT @Owner,@Month,@Currency,@Advertiser_id,@ByAccount,@Debug,@Total,@TotLine,@OrderBy,@Order,@InputCommLine; END IF;

WHILE @InputCommLine>' ' DO
-- @InputCommLine: Month=2022-08,ByAccount=yes,OrderBy=Profit
-- @InputCommLine: ----5----0----5----0----5----0----5----0--
   SET @e=INSTR(@InputCommLine,'=');    				   -- 6
   SET @c=INSTR(@InputCommLine,','); 					   -- 14
   SET @k=SUBSTRING(@InputCommLine,1,@e-1); 			   -- Month
   SET @v=SUBSTRING(@InputCommLine,@e+1,@c-(@e+1)); 	-- 2022-08
   SET @InputCommLine=SUBSTRING(@InputCommLine,@c+1);
   IF lower(@k)='month'           THEN SET @Month         =UPPER(@v); END IF;
   IF lower(@k)='owner'           THEN SET @Owner         =UPPER(@v); END IF;
   IF lower(@k)='advertiser_id'   THEN SET @Advertiser_id =UPPER(@v); END IF;
   IF lower(@k)='affiliate_id'    THEN SET @Affiliate_id  =UPPER(@v); END IF;
   IF lower(@k)='adv_account_id'  THEN SET @Adv_Account_id=UPPER(@v); END IF;
   IF lower(@k)='channel_id'      THEN SET @Channel_id    =UPPER(@v); END IF;
   IF lower(@k)='product'         THEN SET @Product       =UPPER(@v); END IF;
   IF lower(@k)='platform'        THEN SET @Platform      =UPPER(@v); END IF;
   IF lower(@k)='currency'        THEN SET @Currency      =UPPER(@v); END IF;
   IF lower(@k)='total'           THEN SET @Total         =UPPER(@v); END IF;
   IF lower(@k)='debug'           THEN SET @Debug         =UPPER(@v); END IF;

END WHILE;

IF @Debug!="NO" THEN SELECT @Month,@Owner,@Advertiser_id,@Affiliate_id,@Adv_Account_id,@Channel_id,@Product,@Platform,@Currency,@Total,@Debug,InputCommLine; END IF;

IF @Owner         ="ALL" THEN SET @WhereOwner=' ';          ELSE SET @WhereOwner         =CONCAT(" AND Owner=",@Owner);                   END IF;
IF @Advertiser_id ="ALL" THEN SET @WhereAdvertiser_id =' '; ELSE SET @WhereAdvertiser_id =CONCAT(" AND Advertiser_id =",@Advertiser_id ); END IF;
IF @Affiliate_id  ="ALL" THEN SET @WhereAffiliate_id  =' '; ELSE SET @WhereAffiliate_id  =CONCAT(" AND Affiliate_id  =",@Affiliate_id  ); END IF;
IF @Adv_Account_id="ALL" THEN SET @WhereAdv_Account_id=' '; ELSE SET @WhereAdv_Account_id=CONCAT(" AND Username_id   =",@Adv_Account_id); END IF;
IF @Channel_id    ="ALL" THEN SET @WhereChannel_id    =' '; ELSE SET @WhereChannel_id    =CONCAT(" AND Channel_id	   =",@Channel_id);     END IF;
IF @Product       ="ALL" THEN SET @WhereProduct       =' '; ELSE SET @WhereProduct       =CONCAT(" AND Product       ='",@Product,"'");  	END IF;
IF @Platform      ="ALL" THEN SET @WherePlatform      =' '; ELSE SET @WherePlatform      =CONCAT(" AND Portal     	='",@Platform,"'"); 	END IF;

IF lower(@Currency)='original' THEN SET @Currency_result='ALL'; ELSE SET @Currency_result=UPPER(@Currency); END IF;
 
/**************************************************************************************************************/

SET SESSION group_concat_max_len = 100000;

SET @SQL=concat('
WITH Seleccion_base as (
SELECT LEFT(Date,7) as Date,Owner,Portal as Platform,Brand as Advertiser,Username as Account,Affiliate
   ,MS_id,Tracker_ID,Tracker_Name,Code_To_Affiliate as Cod2Aff,Product,Channel
   ,sum(Qualified_Players) as CPA,sum(Net_Revenue) as NR,Deal_Aff_CPA as `Af_CPA`,Deal_Aff_RS as `Af_RS`
FROM Snapshot_day_by_day_fact1
   where LEFT(DATE,7)=@MONTH'
   ,@WhereOwner         
   ,@WhereAdvertiser_id 
   ,@WhereAffiliate_id  
   ,@WhereAdv_Account_id
   ,@WhereChannel_id    
   ,@WhereProduct      
   ,@WherePlatform,'
GROUP BY LEFT(Date,7),MS_id,Product
ORDER BY LEFT(Date,7),Owner,Brand,MS_id)

(
SELECT Date,Owner,Platform,Advertiser,Account,Affiliate
   ,MS_id,Tracker_ID,Cod2Aff,Product
   ,CPA,NR,Af_CPA,Af_RS,Channel,Tracker_Name
FROM Seleccion_base
)
UNION ALL
(
SELECT 
    " ~~~~~"
   ,"~~~~~"
   ,"~~~~~"
   ,"~~~~~"
   ,"~~~~~"
   ,"TOTAL"
   ,"~~~~~"
   ,"~~~~~"
   ,"~~~~~"
   ,"~~~~~"   
--  Date,Owner,Platform,Advertiser,Account,Affiliate
-- ,MS_id,Tracker_ID,Cod2Aff,Product
   ,SUM(CPA),sum(NR)
-- ,Af_CPA,Af_RS,Channel,Tracker_Name
   ,"~~~~~"
   ,"~~~~~"   
   ,"~~~~~"
   ,"~~~~~"      
FROM Seleccion_base
GROUP BY Date
)
ORDER BY Date
');
   
IF @Debug="yes" THEN SELECT @SQL; END IF;

-- IF @Debug != "YES" THEN 
	PREPARE stmt1 FROM @SQL;
	EXECUTE stmt1;
	DEALLOCATE PREPARE stmt1;   
-- END IF;

END$$
DELIMITER ;

/*
call Gestor_MonthlySources('debug=yes');
call Gestor_MonthlySources('Advertiser_id=59,Month=2022-08,debug=yes');
call Gestor_MonthlySources('Platform=netrefer,Product=sport,Month=2022-08,debug=yes');
call Gestor_MonthlySources('Product=casino');
call Gestor_MonthlySources('Affiliate_id=39,Month=2022-08');
call Gestor_MonthlySources('Adv_Account_id=79');
call Gestor_MonthlySources('Owner=2,Month=2022-08');

*/