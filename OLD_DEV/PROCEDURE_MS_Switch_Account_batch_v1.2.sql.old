/* PROCEDURE_MS_Switch_Account_batch.sql

Funcionalidades principales:

Lectura de registros origen: Utiliza un cursor para leer todos los registros donde Username_id = @Account_origen, Status_id = '1' y Product = @Product
Actualización condicional: Para cada registro leído, intenta actualizar un registro que cumpla Username_id = @Account_destino, Affiliate_id = 84 y Product = @Product
Transferencia de campos: Actualiza todos los campos especificados desde el registro origen al destino

Características técnicas:

Usa un cursor para iterar sobre los registros origen
Implementa manejo de errores con CONTINUE HANDLER
Utiliza LIMIT 1 en el UPDATE para asegurar que solo se actualice un registro por iteración
Si no existe un registro destino que cumpla los criterios, automáticamente pasa al siguiente registro origen

PARÁMETROS DE ENTRADA:

1. Accounts_origen (VARCHAR(1000))
   Descripción: Lista de IDs de cuentas origen separados por comas
   Ejemplo: '26,28,45,69,85,87,92'
   Requerido: Sí

2. Account_destino (INT)
   Descripción: ID de la cuenta destino donde se transferirán los registros
   Ejemplo: 86
   Requerido: Sí

3. Product (VARCHAR(50))
   Descripción: Tipo de producto a procesar ('casino', 'sport', etc.)
   Ejemplo: 'casino'
   Requerido: Sí

4. Debug (VARCHAR(3))
   Descripción: Modo de depuración. Si es 'NO' ejecuta las actualizaciones, en caso contrario solo muestra información
   Valores: 'NO' para ejecutar, cualquier otro valor para modo debug
   Ejemplo: 'no' o 'NO'
   Requerido: No (tiene valor por defecto)

5. Interval_months (INT)
   Descripción: Intervalo en meses para el cálculo de Qualified_Players. Define el período de tiempo hacia atrás desde la fecha actual
   para considerar los datos de Snapshot_day_by_day_fact1
   Ejemplo: 6 (últimos 6 meses), 12 (último año)
   Requerido: Sí

6. Qualified_Players_min (INT)
   Descripción: Mínimo de Qualified_Players requerido para que un registro sea considerado válido para la transferencia.
   Solo se procesarán registros cuyo total de Qualified_Players en el intervalo especificado sea mayor a este valor
   Ejemplo: 0 (sin mínimo), 10 (mínimo 10 jugadores calificados)
   Requerido: Sí

Test:
CUENTAS ORIGEN ---------------------------------
id  Username          Publisher_id Advertiser_Name Advertiser_id Advertiser_Name
26  EAFFGB            16           Better          16            GoldBet
28  EAFFGBsport1      16           Better          16            GoldBet
45  EAFFGB2           16           Better          16            GoldBet
69  EAffGBPro1        16           Better          16            GoldBet
85  AvetusS1          16           Better          16            GoldBet
87  Eaffgbpro2        16           Better          16            GoldBet
92  EA2Casino         16           Better          16            GoldBet
231 WebwiseGoldSport  16           Better          16            GoldBet
232 WebwiseGoldCasino 16           Better          16            GoldBet
229 Webwise_Casino    16           Better          67            Lottomatica
230 Webwise_Sport     16           Better          67            Lottomatica

CUENTAS DESTINO ---------------------------------
id  Username             Publisher_id Advertiser_Name Advertiser_id Advertiser_Name
27  EAFFGBsport2         16           Better          16            GoldBet
86  AvetusC1             16           Better          16            GoldBet
110 EALottomaticaSport   16           Better          67            Lottomatica
111 EALottomaticaCasino  16           Better          67            Lottomatica
   
   CALL MS_Switch_Account_batch('26,28,45,69,85,87,92',86,'casino','no',6,0);
   CALL MS_Switch_Account_batch('26,28,45,69,85,87,92',27,'sport','no',6,0);
   CALL MS_Switch_Account_batch('111',262,'casino','NO',1,5);    -- Better
   CALL MS_Switch_Account_batch('86',261,'casino','NO',1,5);     -- Goldbet
   CALL MS_Switch_Account_batch('36,236',266,'casino','NO',1,5); -- Planet

09.06.2025 v1     Primera versión operativa
10.06.2025 v1.1   Agregada condición CPA ult 6 meses>0
                  y Stat_aggreg = '1' 
10.06.2025 v1.1   Agregada verificación previa: no actualizar si ya existe
                  un registro en cuenta destino con mismo Affiliate_id y Product y Channel_id
10.12.2025 v1.3   Agregados parámetros Interval_months y Qualified_Players_min
                  para configurar el intervalo de tiempo y el mínimo de jugadores calificados
  
*/

DROP PROCEDURE IF EXISTS MS_Switch_Account_batch;

DELIMITER $$

CREATE PROCEDURE MS_Switch_Account_batch(
    IN Accounts_origen VARCHAR(1000), -- Lista de IDs separados por comas
    IN Account_destino INT,
    IN Product VARCHAR(50),
    IN Debug VARCHAR(3),
    IN Interval_months INT, -- Intervalo en meses para el cálculo de Qualified_Players
    IN Qualified_Players_min INT -- Mínimo de Qualified_Players requerido
)
BEGIN
    DECLARE v_version VARCHAR(30) default 'v1.3 10.12.2025';
    DECLARE done INT DEFAULT FALSE;
    DECLARE v_id INT;
    DECLARE v_code_to_affiliate VARCHAR(50);
    DECLARE v_product VARCHAR(50);
    DECLARE v_status VARCHAR(30);
    DECLARE v_status_id VARCHAR(2);
    DECLARE v_Stat_aggreg VARCHAR(2);
    DECLARE v_affiliate_id INT;
    DECLARE v_channel_id INT;
    DECLARE v_deal_id INT;
    DECLARE v_country_deal VARCHAR(2);
    DECLARE v_product_deal VARCHAR(50);
    DECLARE v_deal_valid_from DATE;
    DECLARE v_shortlink VARCHAR(150);
    DECLARE v_shortlink_id VARCHAR(150);
    DECLARE v_existing_count INT DEFAULT 0;
    DECLARE v_username_id INT;
    
    -- Cursor para leer registros origen usando IN
    DECLARE cur_origen CURSOR FOR 
        SELECT cms.id, cms.Code_To_Affiliate, cms.Product, cms.Status, cms.Status_id, cms.Stat_aggreg, cms.Affiliate_id, 
               cms.Channel_id, cms.Deal_id, cms.Country_Deal, cms.Product_Deal, 
               cms.Deal_Valid_From, cms.Shortlink, cms.Shortlink_id,
               cms.Username_id
        FROM campaign_marketing_source cms
        LEFT JOIN campaign_marketing_source cms_dest ON 
                cms_dest.Username_id = Account_destino
            AND cms_dest.Affiliate_id = cms.Affiliate_id
            AND cms_dest.Channel_id = cms.Channel_id
            AND cms_dest.Product = cms.Product
            AND cms_dest.Stat_aggreg = '1'
        WHERE FIND_IN_SET(cms.Username_id, Accounts_origen)
          AND cms.Stat_aggreg in ('1','4') 
          AND cms.Product = Product
          AND cms_dest.id IS NULL -- Asegura que no existe un registro correspondiente en destino
          AND EXISTS (
              SELECT 1 
              FROM Snapshot_day_by_day_fact1 sdbdf
              WHERE sdbdf.MS_id = cms.id
                AND sdbdf.Date >= DATE_SUB(CURDATE(), INTERVAL Interval_months MONTH)
              HAVING SUM(sdbdf.Qualified_Players) > Qualified_Players_min
          );
    
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    -- Modo Debug: mostrar registros seleccionados
    -- IF Debug != 'NO' THEN
        SELECT 'Cuentas origen ' AS 'Info', Accounts_origen AS 'Cuentas','Cuenta destino ', Account_destino;
        
        SELECT cms.id as `MS_id`,cms.Username_id as `Accnt_orig`, cms.Code_To_Affiliate, cms.Product, 
               cms.Status, cms.Status_id, cms.Stat_aggreg, 
               cms.Affiliate_id, A.username as `Affiliate`,
               cms.Channel_id, cms.Deal_id, cms.Country_Deal, cms.Product_Deal, 
               cms.Deal_Valid_From, cms.Shortlink, cms.Shortlink_id
        FROM campaign_marketing_source cms
        LEFT JOIN `account_account` `A` ON `A`.`id`  = `cms`.`Affiliate_id`
        LEFT JOIN campaign_marketing_source cms_dest ON 
                cms_dest.Username_id = Account_destino
            AND cms_dest.Affiliate_id = cms.Affiliate_id
            AND cms_dest.Channel_id = cms.Channel_id
            AND cms_dest.Product = cms.Product
            AND cms_dest.Stat_aggreg = '1'
        WHERE FIND_IN_SET(cms.Username_id, Accounts_origen)
          AND cms.Stat_aggreg in ('1','4') 
          AND cms.Product = Product
          AND cms_dest.id IS NULL
          AND EXISTS (
              SELECT 1 
              FROM Snapshot_day_by_day_fact1 sdbdf
              WHERE sdbdf.MS_id = cms.id
                AND sdbdf.Date >= DATE_SUB(CURDATE(), INTERVAL Interval_months MONTH)
              HAVING SUM(sdbdf.Qualified_Players) > Qualified_Players_min)
        ;
                
        SELECT cms.id, cms.Code_To_Affiliate, cms.Product, cms.Status, cms.Status_id, cms.Affiliate_id, 
               cms.Channel_id, cms.Deal_id, cms.Country_Deal, cms.Product_Deal, 
               cms.Deal_Valid_From, cms.Shortlink, cms.Shortlink_id
        FROM campaign_marketing_source cms
           WHERE Username_id  = Account_destino 
             AND Affiliate_id = 84 
             AND Status_id = '1'
             AND Product = Product;
    -- END IF;
    
    -- Abrir cursor
    OPEN cur_origen;
    
    read_loop: LOOP
        FETCH cur_origen INTO v_id, v_code_to_affiliate, v_product, v_status, 
                             v_status_id, v_stat_aggreg, v_affiliate_id, v_channel_id, v_deal_id,
                             v_country_deal, v_product_deal, v_deal_valid_from,
                             v_shortlink, v_shortlink_id, v_username_id;
        
        IF done THEN
            LEAVE read_loop;
        END IF;

        IF Debug = 'NO' THEN
            -- Intentar actualizar UN registro destino
            UPDATE campaign_marketing_source 
            SET Code_To_Affiliate = v_code_to_affiliate,
                  Product           = v_product,
                  Status            = v_status,
                  Status_id         = v_status_id,
                  Affiliate_id      = v_affiliate_id,
                  Channel_id        = v_channel_id,
                  Deal_id           = v_deal_id,
                  Country_Deal      = v_country_deal,
                  Product_Deal      = v_product_deal,
                  -- Deal_Valid_From   = v_deal_valid_from,
                  Deal_Valid_From   = "2025-06-01",
                  Shortlink         = v_shortlink,
                  Shortlink_id      = v_shortlink_id,
                  Description       = concat_ws(" ","Batch switch acct",NOW(),"Accnt origin:",v_username_id) 
            WHERE Username_id  = Account_destino 
               AND Affiliate_id = 84 
               AND Status_id = '1'
               AND Product = v_product
            LIMIT 1;
            
            -- Si se actualizó correctamente el registro destino, actualizar el registro origen
            IF ROW_COUNT() > 0 THEN
                  UPDATE campaign_marketing_source 
                  SET   Status_id   ='9',
                        Description =concat_ws(" ","Switch acct",NOW(),"Shortlink origin:",Shortlink,"Shortlink_id:",Shortlink_id), 
                        Shortlink   ='',
                        Shortlink_id=''
                  WHERE id = v_id;
            END IF;
        END IF;
        
    END LOOP;
    
    CLOSE cur_origen;
    
END$$

DELIMITER ;

-- Ejemplos de uso:
-- Modo normal con múltiples cuentas origen (ejecuta actualizaciones)
-- CALL MS_Switch_Account_batch('92,26,28', 85, 'casino', 'no', 6, 0);

-- Modo debug con múltiples cuentas (solo muestra datos, no actualiza)
-- CALL MS_Switch_Account_batch('92,26,28', 85, 'casino', 'NO', 6, 0);

-- Con intervalo personalizado de 12 meses y mínimo de 10 Qualified_Players
-- CALL MS_Switch_Account_batch('92,26,28', 85, 'casino', 'no', 12, 10);

/*
Escribir un script mysql 8 que, dada la tabla `campaign_marketing_source`, haga lo siguiente:
1) Leer registros de la tabla cuya valor Username_id=@Account_origen, y además Status_id=1 y Product=@Product
2) Por cada registro seleccionado en 1) actualizar otro que sea Username_id=@Account_destino, Affiliate_id=84, Product=@Product
   Si no existe ningún registro que cumpla el requisito, pasar al siguiente de 1)
3) Los campos a actualizar (que transfieren el valor desde cada registro leidos en 1) a los de 2) son:

   `Code_To_Affiliate`
   `Product`          
   `Status`           
   `Status_id`        
   `Affiliate_id`     
   `Channel_id`       
   `Deal_id`          
   `Country_Deal`     
   `Product_Deal`     
   `Deal_Valid_From`  
   `Shortlink`        
   `Shortlink_id`     

CREATE TABLE `campaign_marketing_source` (
   `id` INT NOT NULL AUTO_INCREMENT,
   `Code` VARCHAR(50) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   `Code_To_Affiliate` VARCHAR(50) NULL DEFAULT '0' COLLATE 'utf8mb4_0900_ai_ci',
   `Product` VARCHAR(50) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   `Status` VARCHAR(30) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   `Status_id` VARCHAR(2) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   `Description` VARCHAR(150) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   `Affiliate_id` INT NULL DEFAULT NULL,
   `Username_id` INT NULL DEFAULT NULL,
   `Channel_id` INT NULL DEFAULT NULL,
   `Deal_id` INT NULL DEFAULT NULL,
   `Country_Deal` VARCHAR(2) NULL DEFAULT '' COLLATE 'utf8mb4_0900_ai_ci',
   `Product_Deal` VARCHAR(50) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   `Deal_Valid_From` DATE NULL DEFAULT NULL,
   `Shortlink` VARCHAR(150) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   `Shortlink_id` VARCHAR(150) NULL DEFAULT NULL COLLATE 'utf8mb4_0900_ai_ci',
   PRIMARY KEY (`id`) USING BTREE,
   UNIQUE INDEX `ms_Tracker_ID` (`Tracker_ID`, `Username_id`) USING BTREE,
   INDEX `ms_Code_id` (`Code`, `Username_id`) USING BTREE,
   INDEX `ms_Tracker_Name_ID` (`Tracker_Name`, `Username_id`) USING BTREE,
)
;
*/