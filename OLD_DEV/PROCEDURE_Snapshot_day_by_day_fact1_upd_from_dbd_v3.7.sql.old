-- LEFT JOIN LATERAL (
	SELECT * FROM (
      SELECT *,ROW_NUMBER() OVER(PARTITION BY Product
                                 ORDER BY Valid_From DESC,id DESC) AS RowNr
      FROM `campaign_deal_gestor_prod_date`
      WHERE `Username_id` = @D_Username
        AND `is_active` = 1  AND `Valid_From` <= @D_Date
        AND Product IN (IFNULL(@D_Product,''),'')
	) AS DbP
   where RowNr=1
	ORDER BY DbP.`Product` DESC LIMIT 1
-- ) AS CDP ON TRUE
;
*/