   ,@D_Date='2024-05-17',@D_Product='Casino',@D_Product_real='Casino',@M_Product='Casino'
   ,@D_Tracker_ID='aysitd',@D_Tracker_Name=',,'
   ,@M_id='1005',@M2_Affiliate_id='203';

