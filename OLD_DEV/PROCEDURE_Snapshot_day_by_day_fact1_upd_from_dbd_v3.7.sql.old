	FROM campaign_mkt_source_deal WHERE MS_id = @M_id AND is_active = 1
                                     AND Deal_Valid_From <= @D_Date
	ORDER BY RowNr LIMIT 1
-- ) AS M2 ON TRUE
;
-- ----------------------------Seleccion de Deal por producto-------------------------------------
SET @D_Date='2023-10-17',@D_Product="sport";
-- LEFT JOIN LATERAL (
	SELECT * FROM (
      SELECT *,ROW_NUMBER() OVER(PARTITION BY Product ORDER BY Deal_Valid_From DESC) AS RowNr
      FROM campaign_mkt_source_deal WHERE MS_id = @M_id AND Affiliate_id=@M2_Affiliate_id
                                        AND is_active = 1 AND Deal_Valid_From <= @D_Date
                                        AND Product IN (IFNULL(@D_Product, ''),'',' ')
	) AS DbP
   -- )
   where RowNr=1
	ORDER BY DbP.`Product` DESC LIMIT 1
