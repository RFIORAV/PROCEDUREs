CALL Snapshot_day_by_day_fact1_upd_from_dbd('ALLALL');
CALL Snapshot_day_by_day_fact1_upd_from_dbd('2022-05'); -- error
CALL Snapshot_day_by_day_fact1_upd_from_dbd('2022-15'); -- error

