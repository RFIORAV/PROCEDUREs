   SELECT * FROM campaign_marketing_source M
   WHERE M.Username_id = @D_Username AND
		(M.Tracker_ID = @D_Tracker_ID
	OR  M.Tracker_Name = @D_Tracker_Name
	OR  M.Code = @D_Tracker_Name)
   ;
-- ----------------------------Seleccion de Affiliate------------------------------------
