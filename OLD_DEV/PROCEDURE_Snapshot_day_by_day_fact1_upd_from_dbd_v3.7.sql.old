/*
;
SELECT * FROM Snapshot_day_by_day WHERE DATE>='2024-02-01' and Qualified_Players<>0 AND username='111';
SELECT * FROM Snapshot_day_by_day_fact1 WHERE DATE>='2024-02-01' and Qualified_Players<>0 AND username_id='111';

-- TESTS --------------------------------------------------------------------------------
