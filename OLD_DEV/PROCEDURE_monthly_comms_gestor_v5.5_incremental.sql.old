*/

/*
¿Cómo se puede escribir este query MYSQL8 sin utilizar variables de usuario?
- El query tiene que calcular `Saldo_CO` y `net_RS_Val` para cada grupo (`KeyGrupoControl`,`Month`)
- Para cada grupo (`KeyGrupoControl`,`Month`) `Saldo_CO` es un valor negativo arrastrado `Saldo_CO` del grupo (`KeyGrupoControl`,`Month previo` )
el cual se incrementa con un valor negativo de `net_RS_before_CO` y se disminuye con un valor positivo de `net_RS_before_CO` hasta llegar a cero
(cuando el valor positivo de `net_RS_before_CO` es igual o superior a `Saldo_CO` de arrastre, queda igual a 0 y `net_RS_Val` adquiere el valor sobrante.)

QUERY ACTUAL:
SELECT g.*
   ,case when IFNULL(@KeyGrupoControl,"")!=`KeyGrupoControl` then @Saldo_CO:=0.00 else @Saldo_CO end as `TmpInt`
   ,(@KeyGrupoControl:=`KeyGrupoControl`)                                                            as `TmpControl`   
   ,case when  `net_RS_before_CO`<0            then 0
         when (`net_RS_before_CO`+@Saldo_CO)<0 then 0
         ELSE (`net_RS_before_CO`+@Saldo_CO) 
    END                                          as `net_RS_Val` 
   ,case when (@Saldo_CO+`net_RS_before_CO`)>=0  -- RS compensa todo el saldo anterior
         then @Saldo_CO:=0.00                                            -- inicializa solo luego de haber utilizado
         ELSE (@Saldo_CO:=@Saldo_CO+`net_RS_before_CO`) END as `Saldo_CO`      
from DbD_Fact1_Account_monthly_CPA_minus_RS_acum g
WHERE `CarryOver`=1
GROUP BY `KeyGrupoControl`,`Month`

-- Claude 3.7 ---------------------------------
WITH RECURSIVE cte AS (
    -- Base case - first row per KeyGrupoControl
    SELECT 
        g.*,
        CASE 
            WHEN `net_RS_before_CO` < 0 THEN `net_RS_before_CO`
            ELSE 0
        END AS `Saldo_CO`,
        CASE 
            WHEN `net_RS_before_CO` < 0 THEN 0
            ELSE `net_RS_before_CO`
        END AS `net_RS_Val`,
        ROW_NUMBER() OVER (PARTITION BY `KeyGrupoControl` ORDER BY `Month`) AS rn
    FROM DbD_Fact1_Account_monthly_CPA_minus_RS_acum g
    WHERE `CarryOver` = 1
      AND `Month` = (SELECT MIN(`Month`) FROM DbD_Fact1_Account_monthly_CPA_minus_RS_acum WHERE `KeyGrupoControl` = g.`KeyGrupoControl` AND `CarryOver` = 1)
    
    UNION ALL
    
    -- Recursive part - subsequent rows
    SELECT 
        g.*,
        CASE 
            WHEN (cte.`Saldo_CO` + g.`net_RS_before_CO`) >= 0 THEN 0
            ELSE (cte.`Saldo_CO` + g.`net_RS_before_CO`)
        END AS `Saldo_CO`,
        CASE 
            WHEN g.`net_RS_before_CO` < 0 THEN 0
            WHEN (g.`net_RS_before_CO` + cte.`Saldo_CO`) < 0 THEN 0
            ELSE (g.`net_RS_before_CO` + cte.`Saldo_CO`)
        END AS `net_RS_Val`,
        cte.rn + 1
    FROM DbD_Fact1_Account_monthly_CPA_minus_RS_acum g
    JOIN 
        cte ON g.`KeyGrupoControl` = cte.`KeyGrupoControl` AND g.`Month` = (
            SELECT MIN(`Month`) 
            FROM DbD_Fact1_Account_monthly_CPA_minus_RS_acum 
            WHERE `KeyGrupoControl` = g.`KeyGrupoControl` 
            AND `Month` > cte.`Month`
            AND `CarryOver` = 1
        )
)
SELECT 
    `KeyGrupoControl`,
    `Month`,
    `net_RS_before_CO`,
    `Saldo_CO`,
    `net_RS_Val`
FROM 
    cte
ORDER BY 
    `KeyGrupoControl`, 
    `Month`;
    */