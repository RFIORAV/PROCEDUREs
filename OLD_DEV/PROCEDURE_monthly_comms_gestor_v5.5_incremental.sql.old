call monthly_comms_gestor;
 
*/
-- INSERT IGNORE INTO `monthly_comms_gestor_v5` (
-- `Owner`,`Area`,`Data_Currency`,`Comm_type`,`Month`,`Publisher`,`Brand`,`Username`
-- ,`Publisher_id`,`Advertiser_id`,`Username_id`,`CPA`,`Net_Revenue`,`gross_CPA_Val`
-- ,`gross_RS_Val`,`net_CPA_Val`,`net_RS_Val`,`net_Total_comm`,`RS_CarryOver_Pend`
-- ,`CarryOver`,`RS_Base`,`Product`
-- )
