/* PROCEDURE_monthly_comms_gestor - COMISIONES del GESTOR

	22.02.2022 Calculos sobre Snapshot_day_by_day_fact1
	02.04.2022 Se agrega Tracker_ID para estadisticas
	19.04.2022 Tratamiento de Deal por producto y fecha
	27.07.2022 Multimoneda
	13.09.2022 incluye Product
   10.10.2022 V3.1   incluye group by deal
   27.10.2022 V3.2   Nuevo cálculo de RS (acumula por Adv Account)
   28.10.2022 V3.2   Utiliza Brand_Group y Brand_Group_Acum
-- 28.11.2022 v3.3   Se trata nuevos campos is_indirect,Advertiser_indirect_id,Advertiser_indirect
   21.01.2023 v3.4   Trata nuevo concepto Publisher (pagador)
   31.01.2023 v3.5   `Area`
   10.03.2023 v4     PROCEDURE_monthly_comms_gestor_v4_COver.sql - C.Over
   10.03.2023 v4     PROCEDURE_monthly_comms_affiliate_v4_COver.sql - C.Over
   17.05.2024 v5     Nuevo cálculo de Carry Over
   22.05.2024 v5.1   Inclusión de Deal_Ges_RS_Base en cálculos (Publisher/Account/Product)
   29.05.2024 v5.2   Cálculo de Bonus/fee
   30.05.2024 v5.3   Product=Product_real cuando no informado
   09.10.2024        Agregado Owner a bonus+fee
   11.03.2025 v5.4   Recálculo restringido a mes corriente y dos mes anteriores.   
   08.07.2025        Recálculo restringido a mes corriente y tres mes anteriores.
   12.08.2025 v5.5   Fix cálculo COver cuando CPAminusRS
                     
-- Ejecucion                     
call monthly_comms_gestor;   
 
**/

-- DROP PROCEDURE IF EXISTS monthly_comms_gestor_dev;
DROP PROCEDURE IF EXISTS monthly_comms_gestor;

SET NAMES 'utf8mb4' COLLATE 'utf8mb4_0900_ai_ci';

DELIMITER $$

CREATE DEFINER=`b3w1nn3r`@`%` PROCEDURE monthly_comms_gestor()
   COMMENT 'Commission calc using C.Over and CPAminusRS'
   LANGUAGE SQL
 
BEGIN
-- Defaults
SET @VERSION         ='v5.5 12.08.2025';
SET @CurrentDay      =curdate();
SET @LMonth          =LEFT(DATE_SUB(CURDATE(), INTERVAL 3 MONTH),7);
SET @LMonth_minus1   =LEFT(DATE_SUB(CURDATE(), INTERVAL 4 MONTH),7);
-- SET @LMonth          ='2021-01'; select  @LMonth;

IF NOW()<='2024-08-03' THEN DROP TABLE IF EXISTS `monthly_comms_gestor_v5`; END IF;

CREATE TABLE IF NOT EXISTS `monthly_comms_gestor_v5` (
	`Owner`             VARCHAR(150)  NULL DEFAULT '2',
	`Area`              VARCHAR(150)  NULL DEFAULT 'gaming',
	`Data_Currency`     VARCHAR(150)  NULL DEFAULT 'EUR',
	`Comm_type`         VARCHAR(150)  NULL DEFAULT '',  -- "CPA+RS"/"Bonus"
	`Month`             VARCHAR(7)    NULL DEFAULT '0000-00',
	`Publisher`         VARCHAR(150)  NULL DEFAULT '',
	`Brand`             VARCHAR(150)  NULL DEFAULT '',
	`Username`          VARCHAR(150)  NULL DEFAULT '',
	`Publisher_id`      INT(10)       NULL DEFAULT '0',
	`Advertiser_id`     INT(10)       NULL DEFAULT '0',
	`Username_id`       INT(10)       NULL DEFAULT '0',
	`CPA`               DECIMAL(12,0) NULL DEFAULT '0',
	`Net_Revenue`       DECIMAL(12,2) NULL DEFAULT '0',
	`gross_CPA_Val`     DECIMAL(12,2) NULL DEFAULT '0',
	`gross_RS_Val`      DECIMAL(12,2) NULL DEFAULT '0',
	`net_CPA_Val`       DECIMAL(12,2) NULL DEFAULT '0',
	`net_RS_Val`        DECIMAL(12,2) NULL DEFAULT '0',
	`net_Total_comm`    DECIMAL(12,2) NULL DEFAULT '0',
	`RS_CarryOver_Pend` DECIMAL(12,2) NULL DEFAULT '0',
	`CarryOver`         VARCHAR(2)    NULL DEFAULT '0',
	`RS_Base`           VARCHAR(50)   NULL DEFAULT '',
	`Product`           VARCHAR(50)   NULL DEFAULT '',
   INDEX `Month_Username_id` (`Month`, `Username_id`) USING BTREE,
   INDEX `Month_Advertiser_id` (`Month`, `Advertiser_id`) USING BTREE,
   INDEX `Month` (`Month`, `Publisher_id`, `Advertiser_id`, `Username_id`) USING BTREE
)
ENGINE=InnoDB
;
-- -----------------------------------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `campaign_deal_gestor_bonus` (
   `id`                 INT(10)    NOT NULL AUTO_INCREMENT,
   `Publisher_id`       INT(10)        NULL DEFAULT NULL,
   `Username_id`        INT(10)        NULL DEFAULT NULL,
   `Description`        VARCHAR(50)    NULL DEFAULT '',
   `Month_Valid_From`   VARCHAR(7)     NULL DEFAULT '',         
   `Month_Valid_to`     VARCHAR(7)     NULL DEFAULT NULL,
   `Bonus_Value`        DECIMAL(10,0)  NULL DEFAULT '0',
   `Conditions`         VARCHAR(30)    NULL DEFAULT 'ANY',
   `CPA_min`            INT(10)        NULL DEFAULT '0',
   `NR_min`             INT(10)        NULL DEFAULT '0',
   `FTD_min`            INT(10)        NULL DEFAULT '0',
   `Status_id`          SMALLINT(5)    NULL DEFAULT '1',
   `Status`             VARCHAR(30)    NULL DEFAULT 'Active',
   `Currency`           VARCHAR(5)     NULL DEFAULT 'EUR',
   `Creation_Date`      DATETIME       NULL DEFAULT CURRENT_TIMESTAMP,
   `Last_Update`        DATETIME       NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
   `Operator`           VARCHAR(30)    NULL DEFAULT 'SysOp',
   PRIMARY KEY (`id`) USING BTREE
)
;
-- -----------------------------------------------------------------------------------------------------

-- TRUNCATE TABLE `monthly_comms_gestor_v5`;
DELETE FROM `monthly_comms_gestor_v5` WHERE `Month`>=@LMonth;

INSERT IGNORE INTO `monthly_comms_gestor_v5`
WITH DbD_Fact1_Account_monthly as (
	SELECT
		 LEFT(DATE,7) AS `Month`
		,IFNULL(p.`Advertiser_name`,"_none_") AS `Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
      ,CAST(`Username_id` AS UNSIGNED)                AS `Username_id`
		,SUM(IFNULL(`Qualified_Players`,0))  				AS `CPA`
		,SUM(IFNULL(`Net_Revenue`,0))							AS `Net_Revenue`
		,ROUND(SUM(IFNULL(`CPA_Value_Gestor`,0)),2)     AS `gross_CPA_Val`
		,ROUND(SUM(IFNULL(`Revenue_Share_Gestor`,0)),2) AS `gross_RS_Val`
		,if(`Deal_Ges_Carry_Over`="1","1","0")          as `CarryOver`
		,if(`Deal_Ges_RS_Against_CPA`="1","1","0")      as `CPAminusRS`
		,`Deal_Ges_id`
		,`Deal_Ges_CPA`
		,`Deal_Ges_RS_Base`                             as `RS_Base`
		,`Deal_Ges_RS`
		,`Deal_Ges_Valid_From`
		,`Data_Currency`
      ,CASE WHEN IFNULL(`Product`,"")="" THEN `Product_Real` ELSE `Product` END AS `Product`   -- 30.05.2024
      ,case when ifnull(`Deal_Ges_Carry_Over`,0)=0
            then concat(`Publisher_id`,`Username_id`,"_prod_")
            else case when `Deal_Ges_RS_Base`="publisher" then concat(`Publisher_id`,"0","_prod_")
                      when `Deal_Ges_RS_Base`="account"   then concat(`Publisher_id`,`Username_id`,"_prod_")
                      when `Deal_Ges_RS_Base`="product"   then concat(`Publisher_id`,`Username_id`
                           ,CASE WHEN IFNULL(`Product`,"")="" THEN `Product_Real` ELSE `Product` END)
                      else concat(`Publisher_id`,`Username_id`,"_prod_")
                 end
       end                                            as `KeyGrupoControl`
   
		FROM `Snapshot_day_by_day_fact1` D
      LEFT JOIN campaign_publisher p ON p.id=D.`Publisher_id`
      WHERE LEFT(DATE,7)>=@LMonth       
      -- ---------for-testing------------
      -- WHERE username_id IN (24,196) AND LEFT(DATE,7)>="2023-01"
      -- --------------------------------
   	GROUP BY LEFT(DATE,7),`Username_id`,`Deal_Ges_RS_Against_CPA`,`Deal_Ges_Carry_Over`,`Deal_Ges_RS_Base`
         ,CASE WHEN IFNULL(`Product`,"")="" THEN `Product_Real` ELSE `Product` END
),
-- ---------------------------------------------------------------------------------
DbD_Fact1_Account_monthly_CPA_minus_RS as (
   (
   SELECT
		 `Month`
      ,`Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
		,`Username_id`
		,`CPA`
		,`Net_Revenue`
		,`gross_CPA_Val`
		,`gross_RS_Val`
		,`CarryOver`
		,`RS_Base`      
		,`Product`      
		,`CPAminusRS`
      ,(CASE WHEN `gross_RS_Val`>=0 THEN `gross_CPA_Val`   -- no hay RS para descontar de CPA
             ELSE                                          -- hay RS para descontar de CPA
                 (CASE WHEN `gross_CPA_Val`>=ABS(gross_RS_Val) 
                       THEN (`gross_CPA_Val`-ABS(gross_RS_Val))
                       ELSE 0 END)
             END)                                        AS `net_CPA_Val`      

      ,(CASE WHEN `gross_RS_Val`>=0 THEN `gross_RS_Val`                     -- no hay RS para descontar de CPA
             ELSE                                                           -- hay RS negativa
                 (CASE WHEN `gross_CPA_Val`>=ABS(gross_RS_Val) 
                       THEN 0                                               -- RS se descuenta totalmente
                       ELSE (ABS(gross_RS_Val)-`gross_CPA_Val`)             -- RS se descuenta totalmente pero hay remanente
                       END)
             END)                                        AS `net_RS_before_CO`  
       ,`KeyGrupoControl`           
	FROM `DbD_Fact1_Account_monthly` D
  WHERE `CPAminusRS`=1 and `gross_RS_Val`<0 and gross_CPA_Val>0    -- 12.08.2025
   )
   UNION ALL -- --------------------------------------------
   (
	SELECT
		 `Month`
      ,`Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
		,`Username_id`
		,`CPA`
		,`Net_Revenue`
		,`gross_CPA_Val`
		,`gross_RS_Val`
		,`CarryOver`
		,`RS_Base` 
      ,`Product` 
		,`CPAminusRS`
      ,`gross_CPA_Val` AS `net_CPA_Val`
      ,`gross_RS_Val`  AS `net_RS_before_CO`
      ,`KeyGrupoControl`
	FROM `DbD_Fact1_Account_monthly` D
   WHERE `CPAminusRS`=0 or not (`CPAminusRS`=1 and `gross_RS_Val`<0 and gross_CPA_Val>0)  -- 12.08.2025
   
/*   -- ARRASTRE COver MES ANTERIOR AL PERIODO ---------------
CREATE TABLE IF NOT EXISTS `monthly_comms_gestor_v5` (
	`Owner`             VARCHAR(150)  NULL DEFAULT '2',
	`Area`              VARCHAR(150)  NULL DEFAULT 'gaming',
	`Data_Currency`     VARCHAR(150)  NULL DEFAULT 'EUR',
	`Comm_type`         VARCHAR(150)  NULL DEFAULT '',  -- "CPA+RS"/"Bonus"
	`Month`             VARCHAR(7)    NULL DEFAULT '0000-00',
	`Publisher`         VARCHAR(150)  NULL DEFAULT '',
	`Brand`             VARCHAR(150)  NULL DEFAULT '',
	`Username`          VARCHAR(150)  NULL DEFAULT '',
	`Publisher_id`      INT(10)       NULL DEFAULT '0',
	`Advertiser_id`     INT(10)       NULL DEFAULT '0',
	`Username_id`       INT(10)       NULL DEFAULT '0',
	`CPA`               DECIMAL(12,0) NULL DEFAULT '0',
	`Net_Revenue`       DECIMAL(12,2) NULL DEFAULT '0',
	`gross_CPA_Val`     DECIMAL(12,2) NULL DEFAULT '0',
	`gross_RS_Val`      DECIMAL(12,2) NULL DEFAULT '0',
	`net_CPA_Val`       DECIMAL(12,2) NULL DEFAULT '0',
	`net_RS_Val`        DECIMAL(12,2) NULL DEFAULT '0',
	`net_Total_comm`    DECIMAL(12,2) NULL DEFAULT '0',
	`RS_CarryOver_Pend` DECIMAL(12,2) NULL DEFAULT '0',
	`CarryOver`         VARCHAR(2)    NULL DEFAULT '0',
	`RS_Base`           VARCHAR(50)   NULL DEFAULT '',
	`Product`           VARCHAR(50)   NULL DEFAULT '',
-- */ 
   UNION ALL -- --------------------------------------------
   (
	SELECT
		 `Month`
      ,`Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
		,`Username_id`
		,0 as `CPA`
		,0 as `Net_Revenue`
		,0 as `gross_CPA_Val`
		,0 as `gross_RS_Val`
		,`CarryOver`
		,`RS_Base` 
      ,`Product` 
		,"0" as `CPAminusRS`
      ,0 as `net_CPA_Val`
      ,`RS_CarryOver_Pend` AS `net_RS_before_CO`
      ,case when `RS_Base`="publisher" then concat(`Publisher_id`,"0","_prod_")
            when `RS_Base`="account"   then concat(`Publisher_id`,`Username_id`,"_prod_")
            when `RS_Base`="product"   then concat(`Publisher_id`,`Username_id`,`Product`)
            else concat(`Publisher_id`,`Username_id`,"_prod_")
       end                                          as `KeyGrupoControl`
	FROM `monthly_comms_gestor_v5`
   WHERE `CarryOver`=1 and `RS_CarryOver_Pend`<>0 AND `Month`=@LMonth_minus1
   ) 
-- */   
	ORDER BY `Username_id`,`Month`,`CarryOver`,`RS_Base`,`CPAminusRS`
)),
-- ---------------------------------------------------------------------------------
DbD_Fact1_Account_monthly_CPA_minus_RS_acum as (
   SELECT
		 `Month`
      ,`Publisher`
      ,`Brand`
      ,`Username`
		,`Publisher_id`
		,`Advertiser_id`
		,`Username_id`
		,sum(`CPA`          )                   as `CPA`          
		,round(sum(`Net_Revenue`           ),2) as `Net_Revenue`  
		,round(sum(`gross_CPA_Val`         ),2) as `gross_CPA_Val`
		,round(sum(`gross_RS_Val`          ),2) as `gross_RS_Val` 
      ,round(sum(`net_CPA_Val`           ),2) as `net_CPA_Val`  
      ,round(sum(`net_RS_before_CO`      ),2) as `net_RS_before_CO`       
	   ,max(`CarryOver`)  as `CarryOver`
      ,`RS_Base`  
      ,`Product` 
	   ,max(`CPAminusRS`) as `CPAminusRS`
      ,`KeyGrupoControl`
	FROM `DbD_Fact1_Account_monthly_CPA_minus_RS`
   GROUP BY `KeyGrupoControl`,`Month`,`CarryOver`  
	ORDER BY `KeyGrupoControl`,`Month`,`CarryOver` -- ,`RS_Base`,`Product`    
),

-- ---------------------------------------------------------------------------------
DbD_Fact1_Account_monthly_calc_NO_COver as (
SELECT g.*
   ,0.00 as `TmpInt`
   ,""   as `TmpControl`
   ,case when `net_RS_before_CO`<0 then 0
         else `net_RS_before_CO`
    end                                      as `net_RS_Val` 
   ,0    as `Saldo_CO` 
from DbD_Fact1_Account_monthly_CPA_minus_RS_acum g
WHERE `CarryOver`!=1
),

DbD_Fact1_Account_monthly_calc_COver as (

SELECT g.*
   ,case when IFNULL(@KeyGrupoControl,"")!=`KeyGrupoControl` 
         then @Saldo_CO:=0.00 
         else @Saldo_CO end as `TmpInt`
   ,(@KeyGrupoControl:=`KeyGrupoControl`)                                                            as `TmpControl`   
   ,case when SUM(`net_RS_before_CO`) < 0 then 0
         when SUM(`net_RS_before_CO`) >= 0 AND @Saldo_CO < 0 then
              case when SUM(`net_RS_before_CO`) >= ABS(@Saldo_CO) then (SUM(`net_RS_before_CO`) + @Saldo_CO)
                   else 0
              end
         else SUM(`net_RS_before_CO`)                                   
    END                                          as `net_RS_Val` 
   ,case when (@Saldo_CO+SUM(`net_RS_before_CO`))>=0  -- RS compensa todo el saldo anterior
         then @Saldo_CO:=0.00                                            -- inicializa solo luego de haber utilizado
         ELSE (@Saldo_CO:=@Saldo_CO+SUM(`net_RS_before_CO`)) END as `Saldo_CO`      
from DbD_Fact1_Account_monthly_CPA_minus_RS_acum g
WHERE `CarryOver`=1
GROUP BY `KeyGrupoControl`,`Month`
ORDER BY `KeyGrupoControl`,`Month`                                  

-- SELECT 
