-- ---------------------------------------------------------------------
DROP TRIGGER IF EXISTS forex_deal_affiliate_before_insert;
DELIMITER $$
--
CREATE TRIGGER forex_deal_affiliate_before_insert
BEFORE INSERT
ON forex_deal_affiliate FOR EACH ROW

BEGIN

SET @Version='v1 20.11.2022'; 

	SET NEW.`Deal_Name`=
	CONCAT('CPA: ',round(NEW.CPA_value,0),IF(NEW.Baseline>0,CONCAT(' BL: ',NEW.Baseline),''),
	CASE WHEN NEW.RS_Percentage>0  
        THEN CONCAT(' + RS: ',round(NEW.RS_Percentage,0),'%',' (By: ',NEW.RS_Base,' /CPA-RS: '
      		 ,IF(NEW.RS_Against_CPA>0,'Yes','No'),'/COv:',IF(NEW.Carry_Over>0,'Yes','No'),')')
        ELSE '' END); 

END$$

	-- CONCAT_WS(' '
	-- ,'CPA:',NEW.round(CPA_value,0)
	-- ,IF(NEW.Baseline>0,CONCAT('BL:',NEW.Baseline,''),' ')
	-- ,IF(NEW.RS_Percentage>0,CONCAT('+ RS: ',NEW.round(RS_Percentage,0),'% '),' ')
	-- ,IF(NEW.RS_Percentage>0,CONCAT('(RS acum by:',NEW.RS_Base,'/CPAminusRS:'
   -- ,IF(NEW.RS_Against_CPA>0,'Yes','No'),'/COver:',IF(NEW.Carry_Over>0,'Yes','No'),')'),' ')
	-- );
--
DELIMITER ;

