/**
	PROCEDURE_forex_day_by_day_fact1_2_upd_lm
	**	Actualiza tabla forex_day_by_day_fact1_2 desde view forex_day_by_day_2_fact
	**	Se lanza desde EVENT
	14.05.2022 Primeros dias del mes actualiza mes corriente y anterior antes de las 07:00
	14.05.2022 forex_day_by_day_fact1_2_upd_lm Actualiza mes corriente y anterior
	14.05.2022 EVENT forex_day_by_day_fact1_2_event lanza Procedure forex_day_by_day_fact1_2_upd cada 30 minutos
   05.09.2022 Preparado para la actualización automática junto con el resto de los PROCEDURES
   29.09.2022 Llama a forex_day_by_day_fact1_2_upd_from_dbd   
*/

DROP PROCEDURE IF EXISTS forex_day_by_day_fact1_2_upd_lm;
-- -----------------------------------------------------
DELIMITER //

CREATE PROCEDURE forex_day_by_day_fact1_2_upd_lm()
COMMENT 'Actualiza FACT1 desde DbD - Last Month y Cte'
DETERMINISTIC
MODIFIES SQL DATA
-- SQL SECURITY INVOKER

BEGIN

		CALL forex_day_by_day_fact1_2_upd_from_dbd('LM');
         
END;
//
DELIMITER ;
	
