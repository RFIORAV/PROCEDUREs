/*
***************************************************************
** TRIGGER forex_advertiser_account_before_update
**
** 25.02.2022 Instalado en euroaffiliati_test/euroaffiliati2 Remota
** 17.07.2022 NEW.`Product`!=OLD.`Product`
** 16.08.2022 Cambia de _after_update a _before_update para evitar conflicto con _history
** 16.08.2022 Inserta directamente en forex_deal_gestor_prod_date
** 14.09.2022 Adaptado forex_advertiser_account_after_update a Forex
** 11.11.2022 No crea registro si datos básicos (Deal_Valid_From,Advertiser_id/Username_id) no vienen informados
***************************************************************
*/
-- ---------------------------------------------------------------------
DROP TRIGGER IF EXISTS forex_advertiser_account_before_update;

DELIMITER $$
--
CREATE TRIGGER forex_advertiser_account_before_update
AFTER UPDATE
ON forex_advertiser_account FOR EACH ROW
--
BEGIN

DECLARE `Trigger_Version` VARCHAR (20) DEFAULT '10.11.2022';
--
-- --------------------------------------------------
--	TRATAMIENTO DEL DEAL de forex_advertiser_account
-- Inserta una linea en forex_deal_gestor_prod_date
-- ante un cambio en Deal,Product o Valid_From
-- --------------------------------------------------
-- 
IF 
   NEW.`Valid_From`      IS NOT NULL AND
   NEW.`Deal_Main_id`    IS NOT NULL AND
   (
   NEW.`Deal_Main_id`!=OLD.`Deal_Main_id` OR
	NEW.`Product`     !=OLD.`Product`      OR
	NEW.`Valid_From`  !=OLD.`Valid_From`
   )
--
THEN 

INSERT ignore INTO forex_deal_gestor_prod_date (
    `Advertiser_id`
   ,`Username_id`
   ,`Product`
   ,`Valid_From`
   ,`Deal_id`
   ,`is_active`
	,`Operator`
)
VALUES (
    NEW.`Advertiser_id`
   ,NEW.`id`
   ,NEW.`Product`
   ,IFNULL(NEW.Valid_From,concat(left(curdate(),7),'-01'))
   ,NEW.`Deal_Main_id`
   ,'1'
   ,NEW.`Operator`
);
END IF;

END$$
--
DELIMITER ;

/*
CREATE TABLE `forex_deal_gestor_prod_date` (
	`id` INT(10) NOT NULL AUTO_INCREMENT,
	`Advertiser_id`   INT         NOT NULL,
	`Username_id`     INT         NOT NULL,
	`Product`         VARCHAR(50) NULL DEFAULT '',
	`Valid_From`      DATE        NULL DEFAULT NULL,
	`Deal_id`         INT         NULL DEFAULT NULL,
	`is_active`       TINYINT     NULL DEFAULT 1,
	`Product_Real`    VARCHAR(50) NULL DEFAULT NULL,
	`Advertiser_Name` VARCHAR(50) NULL DEFAULT NULL,
	`Username_Name`   VARCHAR(50) NULL DEFAULT NULL,
	`Creation_Date`   DATETIME    NULL DEFAULT CURRENT_TIMESTAMP,
	`Last_Update`     DATETIME    NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
	`Operator`        VARCHAR(30) NULL DEFAULT 'SysOP',
	PRIMARY KEY (`id`) USING BTREE,UNIQUE INDEX `MainKey` (`Advertiser_id`, `Username_id`, `Product`, `Valid_From`, `Deal_id`) USING BTREE)
;
*/
