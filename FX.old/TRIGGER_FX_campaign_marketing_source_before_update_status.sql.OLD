-- SET `Status`=(CASE WHEN `Status_id`='1' AND `Status_Adv_id`='1' AND `Status_Aff_id`='1' AND `Status_Channel_id`='1'
--					THEN 'Active' ELSE 'Paused' END)
-- ;

